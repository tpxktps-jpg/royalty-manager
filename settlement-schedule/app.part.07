                                    <button onclick="changeChartYear(1)" class="w-6 h-6 flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-white rounded-md transition-all text-xs"><i class="fa-solid fa-chevron-right"></i></button>
