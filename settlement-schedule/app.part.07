                    <i class="fa-solid fa-calculator text-base"></i>
                </button>
                <button onclick="openRevenueCalc()" id="sidebar-revenue-calc-btn" class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-all border border-white/10" title="작가 정산 금액 계산기">
                    <i class="fa-solid fa-coins text-base"></i>
                </button>
                <button onclick="exportAllWritingRecords()" id="sidebar-export-btn" class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-all border border-white/10" title="집필 기록 전체 내보내기 (전체 연도, 텍스트 파일)">
                    <i class="fa-solid fa-file-export text-base"></i>
