                            <div class="flex justify-between items-center mb-6">
                                <h4 data-eyebrow="this year" class="text-sm font-bold text-slate-500 flex items-center gap-2"><i class="fa-solid fa-trophy text-amber-500"></i> 작품별 수익 Top 5</h4>
                                <div class="flex items-center bg-slate-100 rounded-lg p-1 gap-2">
                                    <button onclick="changeTopWorksYear(-1)" class="w-6 h-6 flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-white rounded-md transition-all text-xs"><i class="fa-solid fa-chevron-left"></i></button>
                                    <span id="dash-top-works-year-display" class="text-xs font-bold text-slate-700 min-w-[40px] text-center">2026</span>
                                    <button onclick="changeTopWorksYear(1)" class="w-6 h-6 flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-white rounded-md transition-all text-xs"><i class="fa-solid fa-chevron-right"></i></button>
                                </div>
                            </div>
                            <div id="dash-top-works-year" class="space-y-1"></div>
                        </div>
                    </div>

                    <div class="glass-card p-8">
                        <h4 data-eyebrow="by year" class="text-sm font-bold text-slate-500 mb-6 flex items-center gap-2"><i class="fa-solid fa-list-ul"></i> 연도별 장르 수익 요약</h4>
                        <div class="overflow-x-auto rounded-xl border border-slate-100">
                            <table class="w-full text-sm text-left">
                                <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-100"><tr id="dash-genre-header"></tr></thead>
                                <tbody id="dash-genre-body" class="divide-y divide-slate-100 bg-white"></tbody>
                            </table>
