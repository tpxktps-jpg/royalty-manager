                                </div>
                                <div>
                                    <h3 id="stat-year-profit" class="text-2xl font-bold text-slate-800">₩ 0</h3>
                                    <p id="stat-year-pretax" class="text-[14px] text-slate-500 font-normal mt-0.5">(₩ 0)</p>
                                </div>
                            </div>
                            <div class="border-t border-slate-100 my-2"></div>
                            <div class="mt-2">
                                <div class="flex justify-between items-start mb-1">
                                    <div><p class="text-[11px] font-bold text-slate-400 uppercase">Last Year</p><p class="text-xs text-slate-500"><span id="stat-prev-year-label"></span>년 순수익</p></div>
                                    <div class="p-1.5 rounded-lg bg-blue-50 text-blue-400 text-xs"><i class="fa-solid fa-clock-rotate-left"></i></div>
                                </div>
                                <h3 id="stat-prev-year-profit" class="text-xl font-bold text-slate-600">₩ 0</h3>
                                <p id="stat-prev-year-pretax" class="text-[12px] text-slate-400 font-normal mt-0.5">세전 ₩ 0</p>
                            </div>
                        </div>
                        <div class="stat-card border-l-4" style="border-left-color: #fb7185">
                            <div class="mb-4">
                                <div class="flex justify-between items-start mb-1">
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <p class="text-[11px] font-bold text-slate-400 uppercase">This Month Profit</p>
                                            <div class="flex gap-1 bg-slate-50 rounded px-1">
                                                <button onclick="changeDashMonth(-1)" class="w-4 h-4 rounded hover:bg-slate-200 flex items-center justify-center text-slate-400 transition-colors"><i class="fa-solid fa-chevron-left text-[8px]"></i></button>
                                                <button onclick="changeDashMonth(1)" class="w-4 h-4 rounded hover:bg-slate-200 flex items-center justify-center text-slate-400 transition-colors"><i class="fa-solid fa-chevron-right text-[8px]"></i></button>
                                            </div>
                                        </div>
                                        <p class="text-xs text-slate-500"><span id="dashboard-month-label">이번 달</span> 순수익</p>
                                    </div>
                                    <div class="p-1.5 rounded-lg bg-rose-50 text-rose-400 text-xs"><i class="fa-solid fa-money-bill-trend-up"></i></div>
                                </div>
                                <div>
                                    <h3 id="stat-month-profit" class="text-2xl font-bold text-slate-800">₩ 0</h3>
                                    <p id="stat-month-pretax" class="text-[14px] text-slate-500 font-normal mt-0.5">(₩ 0)</p>
                                </div>
                            </div>
                            <div class="border-t border-slate-100 my-2"></div>
                            <div class="mt-2">
                                <div class="flex justify-between items-start mb-2">
                                    <p class="text-[11px] font-bold text-slate-400 uppercase">Last Month</p>
                                    <div class="p-1.5 rounded-lg bg-rose-50 text-rose-400 text-xs"><i class="fa-solid fa-clock-rotate-left"></i></div>
                                </div>
                                <div class="mb-4">
                                    <p class="text-xs text-slate-500"><span id="stat-prev-month-label"></span> 순수익</p>
                                    <h3 id="stat-prev-month-profit" class="text-lg font-bold text-slate-600">₩ 0</h3>
                                    <p id="stat-prev-month-pretax" class="text-[12px] text-slate-400 font-normal mt-0.5">세전 ₩ 0</p>
                                </div>
                                <div>
                                    <p class="text-xs text-slate-500"><span id="stat-prev-month2-label"></span> 순수익</p>
                                    <h3 id="stat-prev-month2-profit" class="text-lg font-bold text-slate-600">₩ 0</h3>
                                    <p id="stat-prev-month2-pretax" class="text-[12px] text-slate-400 font-normal mt-0.5">세전 ₩ 0</p>
                                </div>
