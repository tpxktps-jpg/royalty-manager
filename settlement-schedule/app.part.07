                                <button onclick="addNewYear()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-all" title="연도 추가"><i class="fa-solid fa-plus"></i></button>
                                <button onclick="deleteCurrentYear()" class="w-8 h-8 rounded-full bg-red-50 hover:bg-red-100 text-red-400 flex items-center justify-center transition-all" title="현재 연도 삭제"><i class="fa-solid fa-minus"></i></button>
                            </div>
                            <button onclick="openViewOptions()" id="tab-records-view-opts-btn" class="w-9 h-9 rounded-xl flex items-center justify-center transition-all bg-slate-100 text-slate-400 hover:bg-slate-200" title="보기 옵션 (십자 강조)"><i class="fa-solid fa-crosshairs"></i></button>
                            <button onclick="openTableStyleSettings()" id="tab-records-style-btn" class="w-9 h-9 rounded-xl flex items-center justify-center transition-all bg-slate-100 text-slate-400 hover:bg-slate-200" title="표 스타일 설정"><i class="fa-solid fa-gear"></i></button>
                            <button onclick="toggleSheetLock()" id="sheet-lock-btn" class="w-9 h-9 rounded-xl flex items-center justify-center transition-all bg-slate-100 text-slate-400 hover:bg-slate-200" title="수정 잠금/해제"><i class="fa-solid fa-lock-open"></i></button>
                        </div>

                        <div id="tab-records-search-wrap" class="flex items-center gap-3 w-full md:w-auto">
