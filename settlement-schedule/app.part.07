                <!-- 작품 라이브러리 탭 -->
                <div id="tab-library" class="tab-content space-y-8 pb-20">
                    <div class="glass-card p-6 min-h-[500px] w-[90%] mx-auto">
                        <div class="flex flex-col md:flex-row justify-between items-center mb-6">
                            <h3 class="text-xl font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-layer-group text-emerald-500"></i> 작품 라이브러리 <span id="library-total-count" class="text-xs font-bold text-white rounded-full px-2 py-0.5" style="background:var(--primary)">0</span></h3>
                            <div class="flex items-center gap-3">
                                <button onclick="resetLibraryFiles()" class="px-3 py-1.5 text-xs font-bold text-red-500 bg-red-50 hover:bg-red-100 rounded-lg transition-all flex items-center gap-1">
                                    <i class="fa-solid fa-trash-can"></i> 라이브러리 초기화
                                </button>
                                <div id="visual-lib-tabs" class="flex gap-1 bg-slate-100 p-1 rounded-lg flex-wrap"></div>
