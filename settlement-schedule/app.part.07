                <!-- 집필 관리 탭 (NEW) -->
                <div id="tab-write" class="tab-content space-y-8 pb-20">
                    <div id="write-main-card" class="glass-card p-8">
                        <div id="write-cozy-hero" class="cozy-pubhero"></div>
                        <div id="tab-write-header-row" class="relative flex items-center justify-between mb-6">
                            <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-pen-nib text-emerald-500"></i> 집필 관리 일정
                                <button onclick="openYearTimeline()" title="연간 일정 한눈에 보기" class="ml-1 w-8 h-8 flex items-center justify-center text-slate-400 hover:text-amber-500 hover:bg-amber-50 rounded-lg transition-all"><i class="fa-solid fa-timeline"></i></button>
                            </h3>
                            <!-- 가운데 목표 합계 -->
                            <div class="absolute left-1/2 -translate-x-1/2 flex items-center gap-4 pointer-events-none">
                                <span id="write-month-big-label" style="font-family:'Pretendard','Apple SD Gothic Neo',sans-serif; font-size:2.5rem; font-weight:800; color:var(--primary); line-height:1;"></span>
                                <p class="text-xl font-semibold" style="font-family:'Pretendard','Apple SD Gothic Neo',sans-serif; color:#475569; margin:0;">이번달 목표 합계: <span id="write-month-goal-sum" style="color:var(--primary)">0자</span> <span id="write-month-pending-sum" class="text-xs font-normal text-slate-400"></span> <span id="write-month-empty-sum" class="text-xs font-normal text-slate-300"></span></p>
                            </div>
                            <div id="write-nav-pill" class="flex items-center bg-slate-100 rounded-lg p-1">
                                <button type="button" class="wr-timeline-btn" onclick="openYearTimeline()" title="연간 일정 한눈에 보기"><i class="fa-solid fa-calendar-days"></i></button>
                                <button onclick="changeWriteMonth(-1)" class="w-8 h-8 flex items-center justify-center text-slate-500 hover:bg-white rounded-md transition-all"><i class="fa-solid fa-chevron-left"></i></button>
                                <span id="write-cal-title" class="px-4 font-bold text-slate-700 w-32 text-center">2026년 5월</span>
                                <button onclick="changeWriteMonth(1)" class="w-8 h-8 flex items-center justify-center text-slate-500 hover:bg-white rounded-md transition-all"><i class="fa-solid fa-chevron-right"></i></button>
                                <button onclick="changeWriteMonth(0, true)" class="ml-2 px-3 py-1 bg-white text-xs font-bold text-slate-600 rounded-md shadow-sm">Today</button>
                                <button onclick="openWriteSettings()" class="ml-2 w-8 h-8 flex items-center justify-center text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 rounded-md transition-all" title="집필 설정"><i class="fa-solid fa-sliders"></i></button>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-7 gap-1">
                            <div class="text-center font-bold text-rose-500 text-xs py-2 bg-slate-50 rounded-t">일</div>
                            <div class="text-center font-bold text-slate-500 text-xs py-2 bg-slate-50 rounded-t">월</div>
                            <div class="text-center font-bold text-slate-500 text-xs py-2 bg-slate-50 rounded-t">화</div>
                            <div class="text-center font-bold text-slate-500 text-xs py-2 bg-slate-50 rounded-t">수</div>
                            <div class="text-center font-bold text-slate-500 text-xs py-2 bg-slate-50 rounded-t">목</div>
                            <div class="text-center font-bold text-slate-500 text-xs py-2 bg-slate-50 rounded-t">금</div>
                            <div class="text-center font-bold text-blue-500 text-xs py-2 bg-slate-50 rounded-t">토</div>
                        </div>
                        <div id="write-calendar-body" class="grid grid-cols-7 gap-1"></div>
                    </div>
                </div>

                <!-- 스케줄 관리 탭 (NEW) -->
                <div id="tab-task" class="tab-content pb-20">
                    <div id="task-layout-wrap" class="flex gap-5 items-start">
                        <div id="task-main-card" class="glass-card p-8 flex-1 min-w-0">
