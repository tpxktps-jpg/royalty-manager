                    <div id="dash-recent-launches"></div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <div class="glass-card p-8 lg:col-span-2">
                            <div class="flex justify-between items-center mb-6">
                                <h4 data-eyebrow="monthly" class="text-sm font-bold text-slate-500 flex items-center gap-2"><i class="fa-solid fa-chart-column"></i> 월별/장르별 수익 추이</h4>
                                <div class="flex items-center bg-slate-100 rounded-lg p-1 gap-2">
                                    <button onclick="changeChartYear(-1)" class="w-6 h-6 flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-white rounded-md transition-all text-xs"><i class="fa-solid fa-chevron-left"></i></button>
