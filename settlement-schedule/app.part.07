                                    <button onclick="togglePublishYearView()" id="publish-year-view-btn" class="px-3 py-1.5 bg-white border border-slate-200 rounded-full text-xs font-bold text-slate-500 shadow-sm flex items-center gap-1.5 transition-all"><i class="fa-solid fa-calendar-days text-[10px]"></i> 전체 보기</button>
                                </div>
                                <button onclick="changePublishCalMonth(1)" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg text-sm font-bold text-slate-600 transition-all flex items-center gap-1.5">다음 달 <i class="fa-solid fa-chevron-right text-xs"></i></button>
                            </div>
                            <div class="grid grid-cols-7 gap-1 mb-1">
                                <div class="text-center text-xs font-bold text-rose-400 py-2 bg-slate-50 rounded">일</div>
                                <div class="text-center text-xs font-bold text-slate-400 py-2 bg-slate-50 rounded">월</div>
                                <div class="text-center text-xs font-bold text-slate-400 py-2 bg-slate-50 rounded">화</div>
                                <div class="text-center text-xs font-bold text-slate-400 py-2 bg-slate-50 rounded">수</div>
