                        </div>
                        <!-- 우측: D-Day 사이드바 -->
                        <div class="w-72 shrink-0 flex flex-col sticky top-4" id="publish-dday-sidebar" style="height:calc(100vh - 120px)">
                            <div class="glass-card p-4 flex flex-col" style="height:100%">
                                <div class="flex items-center justify-between mb-1">
                                    <h3 data-eyebrow="upcoming" class="text-sm font-bold text-slate-700 flex items-center gap-2"><i class="dday-ko fa-solid fa-star text-yellow-400 text-xs"></i><span class="dday-ko"> 출간 예정</span> <span id="publish-dday-count" class="text-xs font-bold text-white rounded-full px-2 py-0.5" style="background:var(--primary)">0</span></h3>
                                    <div class="relative flex items-center gap-1" id="dday-filter-wrap">
                                        <button type="button" onclick="toggleDdayDesignMenu(this, event, 'pub')" class="dday-design-btn w-6 h-6 items-center justify-center rounded-full hover:bg-slate-100 transition-all text-slate-400 hover:text-slate-600" title="카드 디자인"><i class="fa-solid fa-palette text-xs"></i></button>
                                        <button id="dday-filter-btn" onclick="toggleDdayFilter()" class="w-6 h-6 flex items-center justify-center rounded-full hover:bg-slate-100 transition-all text-slate-400 hover:text-slate-600" title="장르 필터">
                                            <i class="fa-solid fa-sliders text-xs"></i>
                                        </button>
                                        <div id="dday-filter-dropdown" style="display:none; position:absolute; right:0; top:28px; z-index:100; min-width:150px;"
                                            class="bg-white rounded-xl shadow-lg border border-slate-100 p-2 space-y-1">
                                            <div class="text-[10px] font-bold text-slate-400 px-2 pb-1 border-b border-slate-100 mb-1">장르 필터</div>
                                            <label class="flex items-center gap-2 px-2 py-1 rounded-lg hover:bg-slate-50 cursor-pointer text-xs text-slate-600">
                                                <input type="checkbox" class="dday-genre-check accent-slate-500" value="__all__" onchange="onDdayFilterChange(this)" checked> 전체
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="border-b border-slate-100 mb-3"></div>
                                <div id="publish-dday-list" class="space-y-2 flex-1" style="overflow-y:auto; scrollbar-width:none; -ms-overflow-style:none;"></div>
                            </div>
                        </div>
                    </div>
                    <!-- 연간 전체보기 뷰 -->
                    <div id="publish-year-view" style="display:none;">
                        <div class="glass-card p-6">
                            <div id="publish-year-nav-row" class="flex justify-between items-center mb-6">
                                <button onclick="changePublishYearViewYear(-1)" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg text-sm font-bold text-slate-600 transition-all flex items-center gap-1.5"><i class="fa-solid fa-chevron-left text-xs"></i> 이전 해</button>
                                <div id="publish-year-title-group" class="flex items-center gap-3">
                                    <h2 id="publish-year-view-title" class="text-lg font-bold" style="color:var(--primary)"></h2>
                                    <button onclick="togglePublishYearView()" class="px-3 py-1.5 bg-white border border-slate-200 rounded-full text-xs font-bold text-slate-500 shadow-sm flex items-center gap-1.5 transition-all"><i class="fa-solid fa-calendar text-[10px]"></i> 월별 보기</button>
                                </div>
                                <button onclick="changePublishYearViewYear(1)" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg text-sm font-bold text-slate-600 transition-all flex items-center gap-1.5">다음 해 <i class="fa-solid fa-chevron-right text-xs"></i></button>
                            </div>
                            <div id="publish-year-view-body" class="grid grid-cols-4 gap-4"></div>
                        </div>
                    </div>
                </div>

                <!-- 세무·목표 탭 -->
                <div id="tab-tax" class="tab-content space-y-6 pb-20">
                    <div id="tax-panel" class="space-y-6"></div>
                </div>

                <!-- 상세 기록 입력 탭 -->
                <div id="tab-daily" class="tab-content pb-20">
                    <div id="daily-main-card" class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 max-w-[960px] mx-auto space-y-4">
                        <div id="daily-cozy-hero" class="cozy-pubhero"></div>
                        <!-- 날짜 네비 -->
                        <div id="daily-nav-row" class="flex justify-center items-center gap-3 relative">
                            <button onclick="writerMovePrevDay()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg text-sm font-bold text-slate-600 transition-all">◀ 이전 날</button>
                            <h2 id="w-currentDateDisplay" class="text-lg font-bold text-slate-700 min-w-[180px] text-center"></h2>
                            <button onclick="writerMoveNextDay()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg text-sm font-bold text-slate-600 transition-all">다음 날 ▶</button>
                            <button onclick="writerGoToday()" class="px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs font-bold text-slate-500 shadow-sm leading-none">Today</button>
                            <button onclick="toggleWriterDatePicker()" id="writer-datepicker-btn" class="w-9 h-9 flex items-center justify-center bg-white border border-slate-200 rounded-lg text-slate-500 shadow-sm" title="날짜로 이동"><i class="fa-solid fa-calendar-days text-sm"></i></button>
                            <div id="writer-datepicker-popover" class="hidden absolute top-full mt-2 right-0 z-30 bg-white rounded-2xl shadow-xl border border-slate-100 p-4" style="width:300px;"></div>
                        </div>

                        <!-- 메인 그리드 -->
                        <div class="grid grid-cols-[1fr_260px] gap-5 items-start" style="margin-top: 1.5rem;">
                            <!-- 좌측: 작품선택 + 버튼 + 테이블 -->
                            <div>
                                <div class="flex items-center gap-3 mb-2">
                                    <span class="text-sm font-bold text-slate-600 shrink-0">작품 선택</span>
                                    <select id="w-dailyWorkSelector" onchange="writerRenderDailyTable()" class="flex-1 px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none focus:ring-2 focus:ring-[var(--primary)] font-medium text-slate-700"></select>
                                </div>
                                <div id="w-dailyTableContainer" class="rounded-lg overflow-hidden border border-slate-100"></div>
                            </div>

                            <!-- 우측: 통계 + 한글 연동 패널 + 어제 글자수 -->
                            <div class="sticky top-5 flex flex-col gap-3">
                                <!-- 통계 패널 -->
                                <div class="bg-slate-50 rounded-2xl p-4 text-center border border-slate-100 flex flex-col gap-7">
                                    <div>
                                        <div class="flex items-center justify-center gap-1.5 mb-2">
                                            <h4 id="w-workTitleDisplay" class="text-sm font-bold text-slate-600 leading-snug">작품을 선택하세요</h4>
                                            <button type="button" onclick="openWriteCounterResetModal(document.getElementById('w-dailyWorkSelector').value)" class="text-slate-300 hover:text-rose-500 transition-colors shrink-0" title="지금부터 카운터 (누적 글자수 기록은 유지하고 진행률만 원하는 날짜부터 다시 세기)">
                                                <i class="fa-solid fa-rotate-left text-[11px]"></i>
                                            </button>
                                        </div>
                                        <div class="relative w-28 h-28 mx-auto" id="w-workTotalWrap"
                                             onmouseenter="showWorkVolumeTip(event)" onmousemove="moveWorkVolumeTip(event)" onmouseleave="hideWorkVolumeTip()">
                                            <canvas id="w-workTotalChart"></canvas>
                                            <div id="w-workTotalPerCenter" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-black text-lg text-slate-700">0%</div>
                                        </div>
                                        <p id="w-workTotalText" class="font-bold text-slate-700 mt-2 text-xs">0 / 0자</p>
                                        <div id="w-workDeadlineInfo" class="mt-1 text-xs text-slate-400"></div>
                                    </div>
                                    <hr class="border-slate-200">
                                    <div>
                                        <h4 class="text-sm font-bold text-slate-600 mb-2">오늘 하루 집필량</h4>
                                        <div class="relative w-28 h-28 mx-auto">
                                            <canvas id="w-dailyGoalChart"></canvas>
                                            <div id="w-dailyGoalPerCenter" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-black text-lg text-slate-700">0%</div>
                                        </div>
                                        <p id="w-dailyGoalText" class="font-bold mt-2 text-xs" style="color:var(--primary)">0 / 0자</p>
                                    </div>
                                </div>


                                <!-- 이전 글자수 불러오기 버튼 -->
                                <button onclick="writerCarryYesterdayLast()" class="w-full px-3 py-2 bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-700 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 leading-none">
                                    <i class="fa-solid fa-clock-rotate-left text-[11px]"></i> 이전 글자수 불러오기
                                </button>
                                <!-- 이미 글자수를 채웠는데 완료 처리가 안 된 지난 카드들을 한 번에 정리 -->
                                <button onclick="bulkSyncWriteCompletionFromDaily()" class="w-full px-3 py-2 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-700 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 leading-none">
                                    <i class="fa-solid fa-broom text-[11px]"></i> 지난 기록 완료 처리 일괄 정리
                                </button>
                            </div>
                        </div>
                        <input type="number" id="w-dailyTimeInput" class="hidden">
                        <input type="number" id="w-dailyGoalInput" value="12000" class="hidden" oninput="writerGlobalDailyGoal=parseInt(this.value)||12000;">
                    </div>
                </div>

                <!-- 월별 달력 탭 -->
                <div id="tab-monthly" class="tab-content space-y-6 pb-20">
                    <div id="wc-main-card" class="glass-card p-6">
                        <div id="wc-cozy-hero" class="cozy-pubhero"></div>
                        <div id="wc-head-row" class="relative flex items-center justify-between mb-5">
                            <div>
                                <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-calendar text-emerald-500"></i> 글자수 관리
                                    <button type="button" onclick="openWriterYearStats()" title="연간 글자수 통계" class="px-3 py-1.5 bg-white border border-slate-200 rounded-full text-xs font-bold text-slate-500 shadow-sm flex items-center gap-1.5 transition-all hover:text-emerald-600"><i class="fa-solid fa-chart-column text-[10px]"></i> 연간 통계</button>
                                </h3>
                                <div id="w-calDaysRatio" class="text-xs text-slate-400 font-semibold mt-1 ml-0.5"></div>
                                <div id="w-calGoalRatio" class="text-xs text-slate-400 font-semibold mt-0.5 ml-0.5"></div>
                            </div>
                            <!-- 가운데: 집필량 / 목표 -->
                            <div class="absolute left-1/2 -translate-x-1/2 text-center pointer-events-none">
                                <h2 id="w-calTitle" class="text-xl font-semibold" style="font-family:'Pretendard','Apple SD Gothic Neo',sans-serif; color:#475569;"></h2>
                            </div>
                            <!-- 오른쪽 네비 -->
                            <div id="wc-nav-pill" class="flex items-center bg-slate-100 rounded-lg p-1">
                                <button type="button" class="wr-timeline-btn" onclick="openWriterYearStats()" title="연간 글자수 통계"><i class="fa-solid fa-chart-column"></i></button>
                                <button onclick="writerCalPrev()" class="w-8 h-8 flex items-center justify-center text-slate-500 hover:bg-white rounded-md transition-all"><i class="fa-solid fa-chevron-left"></i></button>
                                <span id="w-cal-month-label" class="px-4 font-bold text-slate-700 w-32 text-center"></span>
                                <button onclick="writerCalNext()" class="w-8 h-8 flex items-center justify-center text-slate-500 hover:bg-white rounded-md transition-all"><i class="fa-solid fa-chevron-right"></i></button>
                                <button onclick="writerCalToday()" class="ml-2 px-3 py-1 bg-white text-xs font-bold text-slate-600 rounded-md shadow-sm">Today</button>
                                <button onclick="openWriterBulkMonthModal()" class="ml-2 w-8 h-8 flex items-center justify-center bg-white text-slate-500 rounded-md shadow-sm" title="이번 달 글자수 일괄 입력"><i class="fa-solid fa-pen text-xs"></i></button>
                            </div>
                        </div>
                        <div class="grid grid-cols-7 gap-1 mb-1">
                            <div class="text-center text-xs font-bold text-rose-500 py-2 bg-slate-50 rounded-t">일</div>
                            <div class="text-center text-xs font-bold text-slate-500 py-2 bg-slate-50 rounded-t">월</div>
                            <div class="text-center text-xs font-bold text-slate-500 py-2 bg-slate-50 rounded-t">화</div>
                            <div class="text-center text-xs font-bold text-slate-500 py-2 bg-slate-50 rounded-t">수</div>
                            <div class="text-center text-xs font-bold text-slate-500 py-2 bg-slate-50 rounded-t">목</div>
                            <div class="text-center text-xs font-bold text-slate-500 py-2 bg-slate-50 rounded-t">금</div>
                            <div class="text-center text-xs font-bold text-blue-500 py-2 bg-slate-50 rounded-t">토</div>
                        </div>
                        <div id="w-calendarBody" class="grid grid-cols-7 gap-1"></div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- 기존 모달들 -->
    <!-- 컨택 추가/수정 모달 -->
    <!-- 상세 기록 입력 미니창 -->

    <!-- [NEW] 집필 카운터 리셋 모달 -->
    <div id="write-counter-reset-modal" class="modal-overlay">
        <div class="modal-content max-w-sm w-full">
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-base font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-rotate-left text-rose-500"></i> 지금부터 카운터</h3>
                <button onclick="closeWriteCounterResetModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times"></i></button>
            </div>
            <div class="space-y-4">
                <p class="text-xs text-slate-500 leading-relaxed">선택한 날짜부터 카운터를 0자로 다시 셉니다.<br>· 그 전에 기록된 글자수는 통계에 그대로 남습니다.<br>· 집필 관리에 표시되는 누적/진행률과, 달력에 보이는 누적 목표(괄호 안 숫자)가 선택한 날짜부터 새로 쌓입니다.</p>
                <div>
                    <label class="text-xs font-bold text-slate-500 block mb-1.5">리셋 기준 날짜</label>
                    <input type="date" id="write-counter-reset-date-input" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-rose-100 transition-all">
                </div>
                <button onclick="confirmWriteCounterReset()" class="w-full py-2.5 rounded-xl text-sm font-bold text-white bg-rose-500 hover:bg-rose-600 transition-all">이 날짜부터 0자로 리셋</button>
            </div>
        </div>
    </div>

    <!-- 집필 관리 설정 모달 -->
    <div id="write-settings-modal" class="modal-overlay">
        <div class="modal-content max-w-sm w-full">
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-base font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-sliders text-emerald-500"></i> 집필 관리 설정</h3>
                <button onclick="closeWriteSettings()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times"></i></button>
            </div>
            <div class="space-y-4">
                <!-- 카드 글자 크기 -->
                <div>
                    <label class="text-xs font-bold text-slate-400 uppercase block mb-2">카드 글자 크기</label>
                    <div class="flex items-center gap-2 bg-slate-50 rounded-xl p-2 border border-slate-200">
                        <button onclick="changeWriteCardFont(-1)" class="w-7 h-7 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-600 text-sm font-bold flex items-center justify-center">−</button>
                        <span id="write-font-size-val" class="flex-1 text-center text-sm font-bold text-slate-700">12px</span>
                        <button onclick="changeWriteCardFont(1)" class="w-7 h-7 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-600 text-sm font-bold flex items-center justify-center">+</button>
                    </div>
                </div>
                <!-- 진행률 색상 투명도 -->
                <div>
                    <label class="text-xs font-bold text-slate-400 uppercase block mb-2">진행률 색상 투명도</label>
                    <div class="flex items-center gap-2 bg-slate-50 rounded-xl p-2 border border-slate-200">
                        <input type="range" id="write-fill-opacity" min="5" max="80" value="25" class="flex-1 accent-emerald-500" oninput="updateWriteCardOpacity(this.value)">
                        <span id="write-fill-opacity-val" class="text-xs text-slate-400 w-8 text-right">25%</span>
                    </div>
                </div>
                <!-- 빈 날 가용 글자수 -->
                <div>
                    <label class="text-xs font-bold text-slate-400 uppercase block mb-2">빈 날 가용 글자수</label>
                    <div class="flex items-center gap-2 bg-slate-50 rounded-xl p-2 border border-slate-200">
                        <input type="number" id="write-empty-day-chars" value="6000" min="0" step="100" class="flex-1 bg-transparent text-sm font-bold text-slate-700 outline-none" oninput="updateWriteEmptyDayChars(this.value)">
                        <span class="text-xs text-slate-400 shrink-0">자 / 일</span>
                    </div>
                </div>
                <!-- 카드 색상 -->
                <div>
                    <label class="text-xs font-bold text-slate-400 uppercase block mb-2">카드 색상</label>
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl border border-slate-200 mb-2">
                        <span class="text-sm text-slate-600 font-medium">기본 (집필)</span>
                        <input type="color" id="write-color-default" value="#F9F8F6" class="w-8 h-8 rounded-lg border border-slate-200 cursor-pointer p-0.5" oninput="updateWriteColors()">
                    </div>
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-400 uppercase block mb-2">분류별 카드 색상</label>
                    <div id="write-category-color-list" class="space-y-1.5 max-h-64 overflow-y-auto custom-scrollbar pr-1"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 스케줄 관리 설정 모달 -->
    <div id="task-settings-modal" class="modal-overlay">
        <div class="modal-content max-w-sm w-full">
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-base font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-sliders text-indigo-500"></i> 스케줄 설정</h3>
                <button onclick="closeTaskSettings()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times"></i></button>
            </div>
            <div class="space-y-4">
                <div>
                    <label class="text-xs font-bold text-slate-400 uppercase block mb-2">카드 글자 크기</label>
                    <div class="flex items-center gap-2 bg-slate-50 rounded-xl p-2 border border-slate-200">
                        <button onclick="changeTaskCardFont(-1)" class="w-7 h-7 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-600 text-sm font-bold flex items-center justify-center">−</button>
                        <span id="task-font-size-val" class="flex-1 text-center text-sm font-bold text-slate-700">12px</span>
                        <button onclick="changeTaskCardFont(1)" class="w-7 h-7 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-600 text-sm font-bold flex items-center justify-center">+</button>
                    </div>
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-400 uppercase block mb-2">카드 배경 색상</label>
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl border border-slate-200">
                        <span class="text-sm text-slate-600 font-medium">기본 배경</span>
                        <input type="color" id="task-color-default" value="#F9F8F6" class="w-8 h-8 rounded-lg border border-slate-200 cursor-pointer p-0.5" oninput="updateTaskColors()">
                    </div>
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-400 uppercase block mb-2">분류별 글자 색상</label>
                    <div id="task-category-color-list" class="space-y-1.5 max-h-64 overflow-y-auto custom-scrollbar pr-1"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 정산 월 상세 모달 -->
    <div id="month-detail-modal" class="modal-overlay">
        <div class="modal-content max-w-xl w-full" style="max-height:85vh; display:flex; flex-direction:column;">
            <div class="flex justify-between items-center mb-4 shrink-0">
                <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2">
                    <i class="fa-regular fa-calendar-check text-emerald-500"></i>
                    <span id="month-detail-title">월 정산 내역</span>
                </h3>
                <button onclick="closeMonthDetail()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times text-xl"></i></button>
            </div>
            <div id="month-detail-body" class="overflow-y-auto custom-scrollbar flex-1 min-h-0 space-y-4"></div>
            <div class="border-t border-slate-100 pt-4 mt-4 shrink-0 flex justify-between items-center">
                <span class="text-sm font-black text-slate-500">총 합계</span>
                <span id="month-detail-total" class="text-lg font-black text-emerald-600"></span>
            </div>
        </div>
    </div>

    <div id="year-all-detail-modal" class="modal-overlay">
        <div class="modal-content" style="width:95vw; max-width:1680px; max-height:88vh; display:flex; flex-direction:column;">
            <div class="flex justify-between items-center mb-4 shrink-0">
                <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2">
                    <i class="fa-solid fa-list-ul text-emerald-500"></i>
                    <span id="year-all-detail-title">전체 정산 내역</span>
                </h3>
                <div class="flex items-center gap-3 no-print">
                    <button onclick="printYearAllMonthsDetail()" title="인쇄" class="text-slate-400 hover:text-emerald-600 transition-colors"><i class="fa-solid fa-print text-lg"></i></button>
                    <button onclick="closeYearAllMonthsDetail()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times text-xl"></i></button>
                </div>
            </div>
            <div id="year-all-detail-body" class="overflow-y-auto custom-scrollbar flex-1 min-h-0 space-y-6"></div>
            <div class="border-t border-slate-100 pt-4 mt-4 shrink-0 flex justify-between items-center">
                <span class="text-sm font-black text-slate-500">연간 총 합계</span>
                <span id="year-all-detail-total" class="text-lg font-black text-emerald-600"></span>
            </div>
        </div>
    </div>

    <!-- 정산 입금일 툴팁 -->
    <div id="pay-tooltip" class="hidden fixed z-[9999] bg-white border border-slate-200 rounded-xl shadow-2xl p-3 w-56 pointer-events-none" style="transition: opacity 0.1s;">
        <div id="pay-tooltip-content"></div>
    </div>

    <div id="contact-modal" class="modal-overlay">
        <div class="modal-content max-w-4xl w-full" style="max-height:90vh; display:flex; flex-direction:column;">
            <div class="flex justify-between items-center mb-4 shrink-0">
                <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2"><i class="fa-regular fa-envelope text-emerald-500"></i> <span id="contact-modal-title">컨택 추가</span></h3>
                <button onclick="closeContactModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times text-xl"></i></button>
            </div>
            <div class="overflow-y-auto custom-scrollbar pr-1 flex-1 min-h-0">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                    <!-- 1줄: 출판사 / 필명 / 상태 / 별점 -->
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">출판사 *</label>
                        <input type="text" id="contact-publisher" placeholder="출판사명" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">필명</label>
                        <div class="flex gap-1">
                            <select id="contact-pen-name" class="flex-1 min-w-0 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                                <option value="">선택</option>
                            </select>
                            <button type="button" onclick="openPenNameManager()" class="px-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-500 shrink-0" title="필명 관리"><i class="fa-solid fa-gear text-xs"></i></button>
                        </div>
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">상태</label>
                        <select id="contact-status" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                            <option value="대기">대기</option>
                            <option value="추후 연락">추후 연락</option>
                            <option value="진행">진행</option>
                            <option value="계약">계약</option>
                            <option value="거절">거절</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">컨택 날짜</label>
                        <input type="date" id="contact-date" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                    <!-- 2줄: 비율 / 선인세 / 정산일 / 정산기준 -->
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">비율</label>
                        <div class="flex gap-1">
                            <select id="contact-rate-select" onchange="handleContactRateChange(this)" class="flex-1 min-w-0 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                                <option value="">선택</option>
                                <option value="70">70%</option>
                                <option value="75">75%</option>
                                <option value="80">80%</option>
                                <option value="85">85%</option>
                                <option value="90">90%</option>
                                <option value="custom">직접</option>
                            </select>
                            <input type="text" id="contact-rate-custom" placeholder="%" class="w-14 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 hidden">
                        </div>
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">선인세</label>
                        <div class="relative">
                            <input type="number" id="contact-advance" placeholder="0" class="w-full p-2.5 pr-12 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400">만원</span>
                        </div>
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">정산일</label>
                        <select id="contact-payment-day" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100" onchange="handleContactCustomSelect(this)">
                            <option value="">선택</option>
                            <option value="1">1일</option>
                            <option value="7">7일</option>
                            <option value="10">10일</option>
                            <option value="12">12일</option>
                            <option value="15">15일</option>
                            <option value="20">20일</option>
                            <option value="25">25일</option>
                            <option value="말일">말일</option>
                            <option value="__custom__">직접입력</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">정산 기준</label>
                        <select id="contact-standard" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                            <option value="">선택</option>
                            <option value="익월">익월</option>
                            <option value="익익월">익익월</option>
                            <option value="익익익월">익익익월</option>
                        </select>
                    </div>
                    <!-- 3줄: 정산사이트 / 별점 / 조건(2칸) -->
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">정산 사이트</label>
                        <select id="contact-site" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                            <option value="">선택</option>
                            <option value="실시간">실시간</option>
                            <option value="자체">자체</option>
                            <option value="웹하드">웹하드</option>
                            <option value="이메일">이메일</option>
                            <option value="이카운트">이카운트</option>
                            <option value="구글시트">구글시트</option>
                            <option value="하드">하드</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">관심도</label>
                        <div class="flex items-center justify-center gap-1 p-2.5 bg-slate-50 rounded-xl border border-slate-200 h-[42px]">
                            <button type="button" onclick="setContactStars(1)" id="contact-star-1" class="text-xl text-slate-300 hover:text-yellow-400 transition-colors"><i class="fa-solid fa-star"></i></button>
                            <button type="button" onclick="setContactStars(2)" id="contact-star-2" class="text-xl text-slate-300 hover:text-yellow-400 transition-colors"><i class="fa-solid fa-star"></i></button>
                            <button type="button" onclick="setContactStars(3)" id="contact-star-3" class="text-xl text-slate-300 hover:text-yellow-400 transition-colors"><i class="fa-solid fa-star"></i></button>
                        </div>
                    </div>
                    <div class="col-span-2">
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">조건</label>
                        <div class="flex flex-wrap items-center gap-3 p-2 bg-slate-50 rounded-xl border border-slate-200 h-[42px]">
                            <label class="flex items-center gap-1.5 cursor-pointer shrink-0">
                                <input type="checkbox" id="contact-cond-banner" class="w-4 h-4 accent-emerald-500">
                                <span class="text-sm text-slate-700">프리미엄 배너</span>
                            </label>
                            <label class="flex items-center gap-1.5 cursor-pointer shrink-0">
                                <input type="checkbox" id="contact-cond-orifeet" class="w-4 h-4 accent-emerald-500">
                                <span class="text-sm text-slate-700">오리발</span>
                            </label>
                            <label class="flex items-center gap-1.5 cursor-pointer shrink-0">
                                <input type="checkbox" id="contact-cond-illust" class="w-4 h-4 accent-emerald-500">
                                <span class="text-sm text-slate-700">일러 표지</span>
                            </label>
                            <input type="text" id="contact-condition-custom" placeholder="기타 직접 입력" class="flex-1 min-w-[100px] p-1.5 bg-white border border-slate-200 rounded-lg text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                        </div>
                    </div>
                    <!-- 4줄: 교정 / 기타 (한 줄에 절반씩) -->
                    <div class="col-span-2">
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">교정</label>
                        <div class="flex flex-wrap gap-4 p-2.5 bg-slate-50 rounded-xl border border-slate-200 h-[42px] items-center">
                            <label class="flex items-center gap-1.5 cursor-pointer">
                                <input type="checkbox" id="contact-edit-1" class="w-4 h-4 accent-emerald-500">
                                <span class="text-sm text-slate-700">1교</span>
                            </label>
                            <label class="flex items-center gap-1.5 cursor-pointer">
                                <input type="checkbox" id="contact-edit-2" class="w-4 h-4 accent-emerald-500">
                                <span class="text-sm text-slate-700">2교</span>
                            </label>
                            <label class="flex items-center gap-1.5 cursor-pointer">
                                <input type="checkbox" id="contact-edit-review" class="w-4 h-4 accent-emerald-500">
                                <span class="text-sm text-slate-700">리뷰</span>
                            </label>
                        </div>
                    </div>
                    <div class="col-span-2">
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">기타</label>
                        <input type="text" id="contact-etc" placeholder="자유롭게 입력하세요" class="w-full h-[42px] p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                    <!-- 6줄: 메일 전문 (col-span-4) -->
                    <div class="col-span-2 md:col-span-4">
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">메일 전문</label>
                        <textarea id="contact-email" rows="8" placeholder="받은 메일 내용 전체를 붙여넣으세요..." class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 resize-y leading-relaxed"></textarea>
                    </div>
                </div>
            </div>
            <div class="flex gap-3 pt-4 shrink-0 border-t border-slate-100 mt-4">
                <button onclick="closeContactModal()" class="flex-1 py-3 rounded-xl font-bold text-slate-600 bg-slate-100 hover:bg-slate-200">취소</button>
                <button onclick="saveContact()" class="flex-1 py-3 rounded-xl font-bold text-white shadow-lg" style="background:var(--primary)">저장</button>
            </div>
        </div>
    </div>

    <!-- 웹툰 관리 수정 모달 -->
    <div id="webtoon-manage-modal" class="modal-overlay">
        <div class="modal-content w-full" style="max-width:820px;">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-clapperboard text-yellow-500"></i> <span id="wtm-modal-title">웹툰 정보 수정</span></h3>
                <button onclick="closeWebtoonManageModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times text-xl"></i></button>
            </div>
            <div class="grid grid-cols-2 gap-x-6 gap-y-3 items-start">
                <div class="space-y-3">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">필명</label>
                        <div class="flex gap-1">
                            <select id="wtm-pen-name" class="flex-1 min-w-0 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                                <option value="">선택</option>
                            </select>
                            <button type="button" onclick="openPenNameManager()" class="px-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-500 shrink-0" title="필명 관리"><i class="fa-solid fa-gear text-xs"></i></button>
                        </div>
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">계약일</label>
                        <input type="date" id="wtm-contract-date" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 flex items-center justify-between">
                            <span>런칭일</span>
                            <span class="flex items-center gap-1.5 text-[11px] font-normal text-slate-400 cursor-pointer" onclick="event.preventDefault(); document.getElementById('wtm-launch-pending').click();">
                                <input type="checkbox" id="wtm-launch-pending" class="rounded" onclick="event.stopPropagation()" onchange="toggleWtmLaunchPending(this.checked)"> 런칭 예정
                            </span>
                        </label>
                        <input type="date" id="wtm-launch-date" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                        <input type="month" id="wtm-launch-pending-month" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 hidden">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">MG</label>
                        <input type="number" id="wtm-mg" placeholder="예: 500" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">MG 예정일</label>
                        <input type="month" id="wtm-mg-date" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">RS</label>
                        <input type="number" id="wtm-rs" placeholder="예: 10" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">비율(%)</label>
                        <input type="number" id="wtm-webtoon-rate" placeholder="예: 70" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                </div>
                <p class="text-[10px] text-slate-400 -mt-2 ml-1">계약일·런칭일·MG·MG 예정일·RS·비율은 '작품 등록'과 서로 연동돼요.</p>
                </div>

                <div class="space-y-3">
                <div>
                    <label class="text-sm font-bold text-slate-500 ml-1 mb-1 block"><i class="fa-solid fa-link mr-1" style="color:var(--primary)"></i>캐릭터 가이드 전달 예정일</label>
                    <div class="flex items-center gap-3">
                        <input type="date" id="wtm-charguide-date" style="width:70%" class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                        <label class="flex items-center gap-1.5 text-sm font-medium text-slate-500 cursor-pointer">
                            <input type="checkbox" id="wtm-charguide-done" class="rounded" style="width:20px;height:20px;"> 완료
                        </label>
                    </div>
                </div>
                <div>
                    <label class="text-sm font-bold text-slate-500 ml-1 mb-1 block">캐시트 받는 날</label>
                    <div class="flex items-center gap-3">
                        <input type="date" id="wtm-cashsheet-date" style="width:70%" class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                        <label class="flex items-center gap-1.5 text-sm font-medium text-slate-500 cursor-pointer">
                            <input type="checkbox" id="wtm-cashsheet-done" class="rounded" style="width:20px;height:20px;"> 완료
                        </label>
                    </div>
                </div>
                <div>
                    <label class="text-sm font-bold text-slate-500 ml-1 mb-1 block">1화 &amp; 콘티 받는 날</label>
                    <div class="flex items-center gap-3">
                        <input type="date" id="wtm-ep1conti-date" style="width:70%" class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                        <label class="flex items-center gap-1.5 text-sm font-medium text-slate-500 cursor-pointer">
                            <input type="checkbox" id="wtm-ep1conti-done" class="rounded" style="width:20px;height:20px;"> 완료
                        </label>
                    </div>
                </div>
                <div>
                    <label class="text-sm font-bold text-slate-500 ml-1 mb-1 block">MG 입금일</label>
                    <div class="flex items-center gap-3">
                        <input type="date" id="wtm-mg-paid-date" style="width:70%" class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                        <label class="flex items-center gap-1.5 text-sm font-medium text-slate-500 cursor-pointer">
                            <input type="checkbox" id="wtm-mg-paid-done" class="rounded" style="width:20px;height:20px;"> 입금완료
                        </label>
                    </div>
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1 flex items-center justify-between">
                        <span>선인세 입금 내역 <span class="font-normal text-slate-400">· 실제 입금액(원), 월별 정산에 자동 반영</span></span>
                        <button type="button" onclick="addAdvRow('wtm')" class="text-[11px] font-bold text-emerald-600 hover:text-emerald-700">+ 추가</button>
                    </label>
                    <div id="wtm-adv-list" class="space-y-1.5"></div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">작화가님 이름</label>
                        <input type="text" id="wtm-illustrator" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">웹사이트</label>
                        <input type="text" id="wtm-website" placeholder="https://..." class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">런칭 사이트</label>
                    <div class="flex gap-1">
                        <select id="wtm-launch-platform" class="w-[110px] shrink-0 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                            <option value="">플랫폼</option>
                            <option value="리디북스">리디북스</option>
                            <option value="시리즈">시리즈</option>
                            <option value="미스터블루">미스터블루</option>
                            <option value="레진">레진</option>
                            <option value="봄툰">봄툰</option>
                        </select>
                        <input type="text" id="wtm-launch-url" placeholder="https://..." class="flex-1 min-w-0 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                </div>

                </div>

                <!-- 🟢 [NEW] 계약서 PDF 읽어서 메모 자동 정리 -->
                <div class="col-span-2 pt-3 mt-1 border-t border-slate-100">
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="text-sm font-bold text-slate-600"><i class="fa-solid fa-file-contract text-amber-500 mr-1"></i>계약 메모</label>
                        <div class="flex items-center gap-2">
                            <span id="wtm-pdf-status" class="text-[11px] text-slate-400"></span>
                            <button type="button" id="wtm-pdf-open" onclick="openSavedContract('webtoon')"
                                    class="hidden px-3 py-1.5 bg-slate-100 text-slate-600 border border-slate-200 rounded-lg text-xs font-bold hover:bg-slate-200 transition-colors">
                                <i class="fa-solid fa-file-pdf mr-1"></i>열기
                            </button>
                            <button type="button" id="wtm-pdf-delete" onclick="deleteSavedContract('webtoon')"
                                    class="hidden px-3 py-1.5 bg-rose-50 text-rose-500 border border-rose-200 rounded-lg text-xs font-bold hover:bg-rose-100 transition-colors">
                                <i class="fa-solid fa-trash mr-1"></i>삭제
                            </button>
                            <button type="button" onclick="document.getElementById('wtm-pdf-input').click()"
                                    class="px-3 py-1.5 bg-amber-50 text-amber-600 border border-amber-200 rounded-lg text-xs font-bold hover:bg-amber-100 transition-colors">
                                <i class="fa-solid fa-file-arrow-up mr-1"></i>계약서 PDF 불러오기
                            </button>
                        </div>
                    </div>
                    <input type="file" id="wtm-pdf-input" accept="application/pdf" class="hidden" onchange="handleContractPdf(this, 'webtoon')">
                    <div id="wtm-drop" class="relative" ondragover="contractDragOver(event,'webtoon')" ondragleave="contractDragLeave(event,'webtoon')" ondrop="contractDrop(event,'webtoon')">
                    <div id="wtm-drop-hint" class="hidden absolute inset-0 z-10 rounded-xl border-2 border-dashed border-amber-400 bg-amber-50/90 flex items-center justify-center pointer-events-none">
                        <span class="text-sm font-bold text-amber-600"><i class="fa-solid fa-file-arrow-down mr-1"></i>여기에 놓으면 계약서를 읽어요</span>
                    </div>
                    <textarea id="wtm-memo" rows="5" placeholder="계약서 PDF를 불러오면 계약일·기간·요율 등이 여기에 정리됩니다. 직접 적으셔도 돼요."
                              class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 leading-relaxed"></textarea>
                    </div>
                </div>
            </div>
            <div class="flex gap-3 pt-4 mt-2 border-t border-slate-100 items-center">
                <label class="flex items-center gap-2 px-3 py-3 rounded-xl bg-slate-50 hover:bg-slate-100 cursor-pointer shrink-0" title="체크하면 웹툰 관리 목록에서 빠지고 '계약 파기' 목록에만 보여요. 받은 MG 등 정산 금액은 그대로 수입에 남아요.">
                    <input type="checkbox" id="wtm-contract-broken" onchange="toggleWebtoonContractBroken(this)" class="w-4 h-4 accent-slate-500">
                    <span class="text-sm font-bold text-slate-500">계약 파기</span>
                </label>
                <button onclick="closeWebtoonManageModal()" class="flex-1 py-3 rounded-xl font-bold text-slate-600 bg-slate-100 hover:bg-slate-200">취소</button>
                <button onclick="saveWebtoonManageModal()" class="flex-1 py-3 rounded-xl font-bold text-white shadow-lg" style="background:var(--primary)">저장</button>
            </div>
        </div>
    </div>

    <!-- 웹툰 관리 카드 설정 모달 -->
    <div id="webtoon-card-settings-modal" class="modal-overlay">
        <div class="modal-content max-w-3xl w-full">
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-base font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-sliders" style="color:var(--primary)"></i> 웹툰 카드 설정</h3>
                <button onclick="closeWebtoonCardSettings()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times"></i></button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl border border-slate-200">
                        <span class="text-sm text-slate-600 font-medium">출간 완료 카드 색상 다르게 표시</span>
                        <input type="checkbox" id="wcs-differentiate" style="width:20px;height:20px;" class="rounded" onchange="updateWebtoonCardSettings()">
                    </div>
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl border border-slate-200">
                        <span class="text-sm text-slate-600 font-medium">출간 완료 카드 색상</span>
                        <input type="color" id="wcs-color" value="#f7f5f0" class="w-8 h-8 rounded-lg border border-slate-200 cursor-pointer p-0.5" oninput="updateWebtoonCardSettings()">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-400 uppercase block mb-2">필명 배경 모양</label>
                        <div class="flex gap-1.5">
                            <button onclick="setWebtoonPenBarStyle('rounded')" id="wcs-barstyle-rounded" class="flex-1 px-2 py-2 rounded-lg text-xs font-bold transition-all">둥근 네모</button>
                            <button onclick="setWebtoonPenBarStyle('square')" id="wcs-barstyle-square" class="flex-1 px-2 py-2 rounded-lg text-xs font-bold transition-all">각진 네모</button>
                            <button onclick="setWebtoonPenBarStyle('full')" id="wcs-barstyle-full" class="flex-1 px-2 py-2 rounded-lg text-xs font-bold transition-all">꽉 채우기</button>
                        </div>
                    </div>
                    <p class="text-[11px] text-slate-400 -mt-2">오른쪽 카드 미리보기에서 글자를 직접 클릭하면 그 자리에서 색상을 바로 바꿀 수 있어요.</p>
                    <div>
                        <label class="text-xs font-bold text-slate-400 uppercase block mb-2">필명별 배경 색상</label>
                        <div id="wcs-pen-color-list" class="space-y-1.5 max-h-52 overflow-y-auto custom-scrollbar pr-1"></div>
                    </div>
                    <input type="color" id="wcs-label-color1" value="#64748b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWebtoonCardSettings()">
                    <input type="color" id="wcs-label-color2" value="#64748b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWebtoonCardSettings()">
                    <input type="color" id="wcs-value-studio" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWebtoonCardSettings()">
                    <input type="color" id="wcs-value-contract" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWebtoonCardSettings()">
                    <input type="color" id="wcs-value-rsrate" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWebtoonCardSettings()">
                    <input type="color" id="wcs-value-mg" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWebtoonCardSettings()">
                    <input type="color" id="wcs-value-charguide" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWebtoonCardSettings()">
                    <input type="color" id="wcs-value-cashsheet" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWebtoonCardSettings()">
                    <input type="color" id="wcs-value-ep1conti" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWebtoonCardSettings()">
                    <input type="color" id="wcs-value-illustrator" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWebtoonCardSettings()">
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-400 uppercase block mb-2">카드 미리보기</label>
                    <div id="wcs-card-preview"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 작품 관리 수정 모달 -->
    <div id="work-manage-modal" class="modal-overlay">
        <div class="modal-content w-full" style="max-width:820px;">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-layer-group text-yellow-500"></i> <span id="wmm-modal-title">작품 정보 수정</span></h3>
                <button onclick="closeWorkManageModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times text-xl"></i></button>
            </div>
            <div class="space-y-3">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">필명</label>
                        <div class="flex gap-1">
                            <select id="wmm-pen-name" class="flex-1 min-w-0 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                                <option value="">선택</option>
                            </select>
                            <button type="button" onclick="openPenNameManager()" class="px-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-500 shrink-0" title="필명 관리"><i class="fa-solid fa-gear text-xs"></i></button>
                        </div>
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">출판사</label>
                        <input type="text" id="wmm-publisher" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">계약일</label>
                        <input type="date" id="wmm-contract-date" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">비율(%)</label>
                        <input type="number" id="wmm-rate" placeholder="예: 70" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 flex items-center justify-between">
                            <span>출간일</span>
                            <span class="flex items-center gap-1.5 text-[11px] font-normal text-slate-400 cursor-pointer" onclick="event.preventDefault(); document.getElementById('wmm-launch-pending').click();">
                                <input type="checkbox" id="wmm-launch-pending" class="rounded" onclick="event.stopPropagation()" onchange="toggleWmmLaunchPending(this.checked)"> 출간 예정
                            </span>
                        </label>
                        <input type="date" id="wmm-launch-date" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                        <input type="month" id="wmm-launch-pending-month" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 hidden">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">선인세</label>
                        <input type="number" id="wmm-mg" placeholder="예: 300" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">글자수(공백 미포함)</label>
                        <input type="number" id="wmm-goal-nospace" placeholder="예: 10000" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">글자수(공백 포함)</label>
                        <input type="number" id="wmm-goal-withspace" placeholder="예: 11000" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">프로모션</label>
                    <div class="flex gap-1">
                        <select id="wmm-promotion-select" onchange="handleWmmPromotionChange(this)" class="flex-1 min-w-0 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                            <option value="">선택 안 함</option>
                            <option value="오리발">오리발</option>
                            <option value="원픽">원픽</option>
                            <option value="단독배너">단독배너</option>
                            <option value="출판사 배너">출판사 배너</option>
                            <option value="캘린더">캘린더</option>
                            <option value="묶음 시단신">묶음 시단신</option>
                            <option value="단독 시단신">단독 시단신</option>
                            <option value="custom">직접 입력</option>
                        </select>
                        <input type="text" id="wmm-promotion-custom" placeholder="직접 입력" class="w-[130px] shrink-0 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 hidden">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">표지 제안서 전달</label>
                        <input type="date" id="wmm-coverguide-date" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">완고 입고일</label>
                        <input type="date" id="wmm-manuscript-date" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1 flex items-center justify-between">
                        <span>외전</span>
                        <button type="button" onclick="addWmmExtraRow()" class="text-[11px] font-bold text-emerald-600 hover:text-emerald-700">+ 추가</button>
                    </label>
                    <div id="wmm-extras-list" class="space-y-1.5"></div>
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1 flex items-center justify-between">
                        <span>선인세 입금 내역 <span class="font-normal text-slate-400">· 실제 입금액(원), 월별 정산에 자동 반영</span></span>
                        <button type="button" onclick="addAdvRow('wmm')" class="text-[11px] font-bold text-emerald-600 hover:text-emerald-700">+ 추가</button>
                    </label>
                    <div id="wmm-adv-list" class="space-y-1.5"></div>
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">플랫폼</label>
                    <div class="flex gap-1 flex-wrap">
                        <select id="wmm-launch-platform-select" onchange="handleWmmLaunchPlatformChange(this)" class="w-[100px] shrink-0 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                            <option value="">선택 안 함</option>
                            <option value="리디">리디</option>
                            <option value="시리즈">시리즈</option>
                            <option value="카카오">카카오</option>
                            <option value="봄툰">봄툰</option>
                            <option value="미스터블루">미스터블루</option>
                            <option value="레진">레진</option>
                            <option value="custom">직접 입력</option>
                        </select>
                        <input type="text" id="wmm-launch-platform-custom" placeholder="직접 입력" class="w-[80px] shrink-0 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 hidden">
                        <input type="text" id="wmm-launch-url" placeholder="https://..." class="flex-1 min-w-0 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                </div>

                <!-- 🟢 [NEW] 계약서 PDF → 메모 자동 정리 -->
                <div class="pt-3 mt-1 border-t border-slate-100">
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="text-sm font-bold text-slate-600"><i class="fa-solid fa-file-contract text-amber-500 mr-1"></i>계약 메모</label>
                        <div class="flex items-center gap-2">
                            <span id="wmm-pdf-status" class="text-[11px] text-slate-400"></span>
                            <button type="button" id="wmm-pdf-open" onclick="openSavedContract('work')"
                                    class="hidden px-3 py-1.5 bg-slate-100 text-slate-600 border border-slate-200 rounded-lg text-xs font-bold hover:bg-slate-200 transition-colors">
                                <i class="fa-solid fa-file-pdf mr-1"></i>열기
                            </button>
                            <button type="button" id="wmm-pdf-delete" onclick="deleteSavedContract('work')"
                                    class="hidden px-3 py-1.5 bg-rose-50 text-rose-500 border border-rose-200 rounded-lg text-xs font-bold hover:bg-rose-100 transition-colors">
                                <i class="fa-solid fa-trash mr-1"></i>삭제
                            </button>
                            <button type="button" onclick="document.getElementById('wmm-pdf-input').click()"
                                    class="px-3 py-1.5 bg-amber-50 text-amber-600 border border-amber-200 rounded-lg text-xs font-bold hover:bg-amber-100 transition-colors">
                                <i class="fa-solid fa-file-arrow-up mr-1"></i>계약서 PDF 불러오기
                            </button>
                        </div>
                    </div>
                    <input type="file" id="wmm-pdf-input" accept="application/pdf" class="hidden" onchange="handleContractPdf(this, 'work')">
                    <div id="wmm-drop" class="relative" ondragover="contractDragOver(event,'work')" ondragleave="contractDragLeave(event,'work')" ondrop="contractDrop(event,'work')">
                    <div id="wmm-drop-hint" class="hidden absolute inset-0 z-10 rounded-xl border-2 border-dashed border-amber-400 bg-amber-50/90 flex items-center justify-center pointer-events-none">
                        <span class="text-sm font-bold text-amber-600"><i class="fa-solid fa-file-arrow-down mr-1"></i>여기에 놓으면 계약서를 읽어요</span>
                    </div>
                    <textarea id="wmm-memo" rows="5" placeholder="계약서 PDF를 불러오면 계약일·기간·요율·선인세 등이 여기에 정리됩니다. 직접 적으셔도 돼요."
                              class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 leading-relaxed"></textarea>
                    </div>
                </div>
            </div>
            <div class="flex gap-3 pt-4 mt-2 border-t border-slate-100">
                <button onclick="closeWorkManageModal()" class="flex-1 py-3 rounded-xl font-bold text-slate-600 bg-slate-100 hover:bg-slate-200">취소</button>
                <button onclick="saveWorkManageModal()" class="flex-1 py-3 rounded-xl font-bold text-white shadow-lg" style="background:var(--primary)">저장</button>
            </div>
        </div>
    </div>

    <!-- 작품 관리 카드 설정 모달 -->
    <div id="work-card-settings-modal" class="modal-overlay">
        <div class="modal-content max-w-3xl w-full">
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-base font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-sliders" style="color:var(--primary)"></i> 작품 카드 설정</h3>
                <button onclick="closeWorkManageCardSettings()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times"></i></button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl border border-slate-200">
                        <span class="text-sm text-slate-600 font-medium">출간 완료 카드 색상 다르게 표시</span>
                        <input type="checkbox" id="wms-differentiate" style="width:20px;height:20px;" class="rounded" onchange="updateWorkManageCardSettings()">
                    </div>
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl border border-slate-200">
                        <span class="text-sm text-slate-600 font-medium">출간 완료 카드 색상</span>
                        <input type="color" id="wms-color" value="#f7f5f0" class="w-8 h-8 rounded-lg border border-slate-200 cursor-pointer p-0.5" oninput="updateWorkManageCardSettings()">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-400 uppercase block mb-2">장르 배경 모양</label>
                        <div class="flex gap-1.5">
                            <button onclick="setWorkManagePenBarStyle('rounded')" id="wms-barstyle-rounded" class="flex-1 px-2 py-2 rounded-lg text-xs font-bold transition-all">둥근 네모</button>
                            <button onclick="setWorkManagePenBarStyle('square')" id="wms-barstyle-square" class="flex-1 px-2 py-2 rounded-lg text-xs font-bold transition-all">각진 네모</button>
                            <button onclick="setWorkManagePenBarStyle('full')" id="wms-barstyle-full" class="flex-1 px-2 py-2 rounded-lg text-xs font-bold transition-all">꽉 채우기</button>
                        </div>
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-400 uppercase block mb-2">장르별 배경 색상</label>
                        <div id="wms-genre-color-list" class="space-y-1.5 max-h-52 overflow-y-auto custom-scrollbar pr-1"></div>
                    </div>
                    <input type="color" id="wms-label-color1" value="#64748b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWorkManageCardSettings()">
                    <input type="color" id="wms-label-color2" value="#64748b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWorkManageCardSettings()">
                    <input type="color" id="wms-value-studio" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWorkManageCardSettings()">
                    <input type="color" id="wms-value-contract" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWorkManageCardSettings()">
                    <input type="color" id="wms-value-rate" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWorkManageCardSettings()">
                    <input type="color" id="wms-value-mg" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWorkManageCardSettings()">
                    <input type="color" id="wms-value-charcount" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWorkManageCardSettings()">
                    <input type="color" id="wms-value-promotion" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWorkManageCardSettings()">
                    <input type="color" id="wms-value-charguide" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWorkManageCardSettings()">
                    <input type="color" id="wms-value-cashsheet" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWorkManageCardSettings()">
                    <input type="color" id="wms-value-ep1conti" value="#1e293b" style="position:fixed;top:-100px;left:-100px;width:1px;height:1px;opacity:0;padding:0;border:0;" oninput="updateWorkManageCardSettings()">
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-400 uppercase block mb-2">카드 미리보기</label>
                    <div id="wms-card-preview"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 투고 모달 -->
    <div id="submission-modal" class="modal-overlay">
        <div class="modal-content max-w-lg w-full">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-paper-plane" style="color:var(--primary)"></i> <span id="submission-modal-title">투고처 추가</span></h3>
                <button onclick="closeSubmissionModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times text-xl"></i></button>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <!-- 스튜디오명 -->
                <div class="col-span-2">
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">스튜디오명 *</label>
                    <input type="text" id="sub-studio" placeholder="웹툰 스튜디오명" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                </div>
                <!-- 이메일 -->
                <div class="col-span-2">
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">투고 이메일</label>
                    <input type="text" id="sub-email" placeholder="submission@studio.com" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                </div>
                <!-- 웹사이트 -->
                <div class="col-span-2">
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">웹사이트</label>
                    <input type="text" id="sub-website" placeholder="https://studio.com" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                </div>
                <!-- 장르 -->
                <div class="col-span-2">
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">선호 장르 <span class="font-normal" style="color:var(--primary)">(복수 선택 가능)</span></label>
                    <div id="sub-genre-checkboxes" class="flex flex-wrap gap-2 p-3 bg-slate-50 rounded-xl border border-slate-200 min-h-[42px]"></div>
                </div>
                <!-- 관심도 -->
                <div class="col-span-2">
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">관심도</label>
                    <div class="flex items-center gap-1 p-2.5 bg-slate-50 rounded-xl border border-slate-200 h-[42px]">
                        <button type="button" onclick="setSubStars(1)" id="sub-star-1" class="text-xl text-slate-300 hover:text-yellow-400 transition-colors"><i class="fa-solid fa-star"></i></button>
                        <button type="button" onclick="setSubStars(2)" id="sub-star-2" class="text-xl text-slate-300 hover:text-yellow-400 transition-colors"><i class="fa-solid fa-star"></i></button>
                        <button type="button" onclick="setSubStars(3)" id="sub-star-3" class="text-xl text-slate-300 hover:text-yellow-400 transition-colors"><i class="fa-solid fa-star"></i></button>
                    </div>
                </div>
                <!-- 메모 -->
                <div class="col-span-2">
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">메모</label>
                    <textarea id="sub-memo" rows="3" placeholder="투고 조건, 특이사항 등..." class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 resize-y"></textarea>
                </div>
            </div>
            <div class="flex gap-3 pt-4 border-t border-slate-100 mt-4">
                <button onclick="closeSubmissionModal()" class="flex-1 py-3 rounded-xl font-bold text-slate-600 bg-slate-100 hover:bg-slate-200">취소</button>
                <button onclick="saveSubmission()" class="flex-1 py-3 rounded-xl font-bold text-white shadow-lg" style="background:var(--primary)">저장</button>
            </div>
        </div>
    </div>

    <!-- 웹툰투고 모달 -->
    <div id="webtoon-sub-modal" class="modal-overlay">
        <div class="modal-content w-full" style="max-width:600px; max-height:90vh;">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-rocket" style="color:var(--primary)"></i> <span id="wsub-modal-title">투고 이력 추가</span></h3>
                <button onclick="closeWebtoonSubModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times text-xl"></i></button>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div class="col-span-2">
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1.5 block">웹툰사 *</label>
                    <!-- 커스텀 드롭다운 (클릭 시 펼쳐짐, 20개 표시) -->
                    <div id="wsub-studio-wrapper" style="position:relative; width:100%;">
                        <div id="wsub-studio-display"
                             onclick="toggleWsubStudioDropdown()"
                             style="display:flex; align-items:center; justify-content:space-between; cursor:pointer;
                                    background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px;
                                    padding:12px 16px; font-size:0.95rem; font-family:'Pretendard','Apple SD Gothic Neo','Noto Sans KR',sans-serif;
                                    color:#64748b; user-select:none;">
                            <span id="wsub-studio-label">선택</span>
                            <i id="wsub-studio-chevron" class="fa-solid fa-chevron-down" style="font-size:0.75rem; color:#94a3b8; transition:transform 0.2s;"></i>
                        </div>
                        <div id="wsub-studio-dropdown"
                             style="display:none; position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:9999;
                                    background:#fff; border:1.5px solid #e2e8f0; border-radius:12px;
                                    box-shadow:0 8px 24px rgba(0,0,0,0.12); overflow:hidden;">
                            <div id="wsub-studio-list"
                                 style="max-height:calc(38px * 20 + 8px); overflow-y:auto; padding:4px 0;
                                        font-family:'Pretendard','Apple SD Gothic Neo','Noto Sans KR',sans-serif; font-size:0.93rem;">
                            </div>
                        </div>
                    </div>
                    <!-- 실제 값 저장용 hidden input -->
                    <input type="hidden" id="wsub-studio" value="">
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1.5 block">투고일</label>
                    <input type="date" id="wsub-date" class="w-full px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 text-sm text-center outline-none focus:ring-2 focus:ring-emerald-100">
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1.5 block">접수 답변일</label>
                    <input type="date" id="wsub-accept-date" class="w-full px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 text-sm text-center outline-none focus:ring-2 focus:ring-emerald-100">
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1.5 block">답변 예정일</label>
                    <input type="date" id="wsub-expected-date" class="w-full px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 text-sm text-center outline-none focus:ring-2 focus:ring-emerald-100">
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1.5 block">최종 답변일</label>
                    <input type="date" id="wsub-reply-date" class="w-full px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 text-sm text-center outline-none focus:ring-2 focus:ring-emerald-100">
                </div>
                <div class="col-span-2">
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1.5 block">결과</label>
                    <select id="wsub-result" class="w-full px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 text-sm text-center outline-none focus:ring-2 focus:ring-emerald-100">
                        <option value="답변대기">답변대기</option>
                        <option value="거절">거절</option>
                        <option value="통과">통과</option>
                        <option value="계약">계약</option>
                    </select>
                </div>
                <div class="col-span-2">
                    <label class="text-xs font-bold text-slate-500 ml-1 mb-1.5 block">회신 마감일 <span class="font-normal text-slate-400">(통과/계약 시 내가 의사를 전달하기로 한 날)</span></label>
                    <input type="date" id="wsub-my-reply-deadline" class="w-full px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 text-sm text-center outline-none focus:ring-2 focus:ring-emerald-100">
                </div>
            </div>
            <div class="flex gap-3 pt-5 border-t border-slate-100 mt-6">
                <button onclick="closeWebtoonSubModal()" class="flex-1 py-3.5 rounded-xl font-bold text-slate-600 bg-slate-100 hover:bg-slate-200">취소</button>
                <button onclick="saveWebtoonSubEntry()" class="flex-1 py-3.5 rounded-xl font-bold text-white shadow-lg" style="background:var(--primary)">저장</button>
            </div>
        </div>
    </div>

    <!-- 메일 내용 모달 -->
    <div id="mail-content-modal" class="modal-overlay">
        <div class="modal-content w-full" style="max-width:700px;">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2">
                    <i class="fa-solid fa-envelope" style="color:var(--primary)"></i>
                    <span id="mail-modal-work-title">메일 내용</span>
                </h3>
                <button onclick="closeMailContentModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times text-xl"></i></button>
            </div>
            <!-- 제목 -->
            <div class="mb-3">
                <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">메일 제목</label>
                <input type="text" id="mail-subject-input" placeholder="메일 제목을 입력하세요" spellcheck="false" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
            </div>
            <!-- 리치 에디터 툴바 -->
            <div class="mb-1">
                <label class="text-xs font-bold text-slate-500 ml-1 mb-1 block">메일 본문</label>
                <div class="flex flex-wrap items-center gap-1 p-2 bg-slate-50 rounded-t-xl border border-slate-200 border-b-0" id="mail-editor-toolbar">
                    <!-- 폰트 크기 -->
                    <select onchange="mailEditorExec('fontSize', this.value); this.value=''" class="text-xs border border-slate-200 rounded-lg px-1.5 py-1 bg-white outline-none cursor-pointer text-slate-600">
                        <option value="">크기</option>
                        <option value="1">아주 작게</option>
                        <option value="2">작게</option>
                        <option value="3">보통</option>
                        <option value="4">크게</option>
                        <option value="5">아주 크게</option>
                    </select>
                    <div class="w-px h-5 bg-slate-200 mx-0.5"></div>
                    <!-- 서식 -->
                    <button onclick="mailEditorExec('bold')" title="굵게" class="w-7 h-7 rounded-lg hover:bg-slate-200 transition-colors text-slate-600 font-bold text-sm flex items-center justify-center">B</button>
                    <button onclick="mailEditorExec('italic')" title="기울임" class="w-7 h-7 rounded-lg hover:bg-slate-200 transition-colors text-slate-500 italic text-sm flex items-center justify-center">I</button>
                    <button onclick="mailEditorExec('underline')" title="밑줄" class="w-7 h-7 rounded-lg hover:bg-slate-200 transition-colors text-slate-500 underline text-sm flex items-center justify-center">U</button>
                    <div class="w-px h-5 bg-slate-200 mx-0.5"></div>
                    <!-- 정렬 -->
                    <button onclick="mailEditorExec('justifyLeft')" title="왼쪽 정렬" class="w-7 h-7 rounded-lg hover:bg-slate-200 transition-colors text-slate-500 text-sm flex items-center justify-center"><i class="fa-solid fa-align-left text-xs"></i></button>
                    <button onclick="mailEditorExec('justifyCenter')" title="가운데 정렬" class="w-7 h-7 rounded-lg hover:bg-slate-200 transition-colors text-slate-500 text-sm flex items-center justify-center"><i class="fa-solid fa-align-center text-xs"></i></button>
                    <button onclick="mailEditorExec('justifyRight')" title="오른쪽 정렬" class="w-7 h-7 rounded-lg hover:bg-slate-200 transition-colors text-slate-500 text-sm flex items-center justify-center"><i class="fa-solid fa-align-right text-xs"></i></button>
                    <div class="w-px h-5 bg-slate-200 mx-0.5"></div>
                    <!-- 링크 -->
                    <button onclick="mailEditorInsertLink()" title="링크 삽입" class="w-7 h-7 rounded-lg hover:bg-slate-200 transition-colors text-slate-500 text-sm flex items-center justify-center"><i class="fa-solid fa-link text-xs"></i></button>
                    <button onclick="mailEditorExec('unlink')" title="링크 제거" class="w-7 h-7 rounded-lg hover:bg-slate-200 transition-colors text-slate-500 text-sm flex items-center justify-center"><i class="fa-solid fa-link-slash text-xs"></i></button>
                    <div class="w-px h-5 bg-slate-200 mx-0.5"></div>
                    <!-- 색상 -->
                    <label title="글자 색상" class="w-7 h-7 rounded-lg hover:bg-slate-200 transition-colors flex items-center justify-center cursor-pointer">
                        <i class="fa-solid fa-palette text-xs text-slate-500"></i>
                        <input type="color" class="sr-only" onchange="mailEditorExec('foreColor', this.value)">
                    </label>
                    <div class="w-px h-5 bg-slate-200 mx-0.5"></div>
                    <!-- 목록 -->
                    <button onclick="mailEditorExec('insertUnorderedList')" title="글머리 목록" class="w-7 h-7 rounded-lg hover:bg-slate-200 transition-colors text-slate-500 text-sm flex items-center justify-center"><i class="fa-solid fa-list-ul text-xs"></i></button>
                    <button onclick="mailEditorExec('insertOrderedList')" title="번호 목록" class="w-7 h-7 rounded-lg hover:bg-slate-200 transition-colors text-slate-500 text-sm flex items-center justify-center"><i class="fa-solid fa-list-ol text-xs"></i></button>
                </div>
                <div id="mail-body-editor" contenteditable="true" spellcheck="false"
                    class="w-full min-h-[260px] p-3 bg-white border border-slate-200 rounded-b-xl text-sm outline-none"
                    style="line-height:1.8; overflow-y:auto; max-height:380px;"
                    placeholder="메일 본문을 입력하세요..."></div>
            </div>
            <!-- 하단 버튼 -->
            <div class="flex gap-3 pt-4 border-t border-slate-100 mt-4">
                <button onclick="closeMailContentModal()" class="flex-1 py-3 rounded-xl font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 text-sm">닫기</button>
                <button onclick="copyMailSubject()" class="py-3 px-4 rounded-xl font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 text-sm flex items-center gap-1.5">
                    <i class="fa-solid fa-copy text-xs"></i> 제목 복사
                </button>
                <button onclick="copyMailBody()" class="py-3 px-4 rounded-xl font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 text-sm flex items-center gap-1.5">
                    <i class="fa-solid fa-copy text-xs"></i> 본문 복사
                </button>
                <button onclick="saveMailContent()" class="flex-1 py-3 rounded-xl font-bold text-white shadow-lg text-sm flex items-center justify-center gap-1.5" style="background:var(--primary)">
                    <i class="fa-solid fa-floppy-disk text-xs"></i> 저장
                </button>
            </div>
        </div>
    </div>

    <!-- 필명 관리 모달 -->
    <div id="penname-modal" class="modal-overlay">
        <div class="modal-content h-auto max-w-md w-full">
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-feather text-emerald-500"></i> 필명 관리</h3>
                <button onclick="closePenNameManager()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times text-xl"></i></button>
            </div>
            <div class="space-y-3">
                <div class="flex gap-2">
                    <input type="text" id="new-penname-input" placeholder="새 필명 입력" class="flex-1 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    <button onclick="addPenName()" class="px-4 py-2.5 rounded-xl text-sm font-bold text-white" style="background:var(--primary)">추가</button>
                </div>
                <div id="penname-list" class="space-y-2 max-h-60 overflow-y-auto custom-scrollbar"></div>
            </div>
            <div class="flex pt-4 border-t border-slate-100 mt-4">
                <button onclick="closePenNameManager()" class="w-full py-3 rounded-xl font-bold text-slate-600 bg-slate-100 hover:bg-slate-200">닫기</button>
            </div>
        </div>
    </div>

    <!-- 외전 추가/수정 모달 -->
    <div id="extra-modal" class="modal-overlay">
        <div class="modal-content h-auto max-w-md w-full">
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-book-open text-emerald-500"></i> <span id="extra-modal-title">외전 추가</span></h3>
                <button onclick="closeExtraModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times text-xl"></i></button>
            </div>
            <input type="hidden" id="extra-edit-id" value="">
            <div class="space-y-4">
                <div>
                    <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">외전 이름</label>
                    <input type="text" id="extra-name" placeholder="예: 외전 1, 후기, 번외 등" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                </div>
                <div>
                    <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">목표 글자수</label>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <input type="number" id="extra-goal-nospace" placeholder="0" oninput="calcExtraGoalFromNoSpace(this.value)" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                            <p class="text-[10px] font-bold text-slate-400 mt-1 ml-1">공미 (공백 미포함)</p>
                        </div>
                        <div>
                            <input type="number" id="extra-goal-withspace" placeholder="0" oninput="calcExtraGoalFromWithSpace(this.value)" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100" style="border-color:#87ada1">
                            <p class="text-[10px] font-bold mt-1 ml-1" style="color:var(--primary)">공포 (기준 글자수)</p>
                        </div>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">완고 입고일</label>
                        <input type="date" id="extra-manuscript-date" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                    <div>
                        <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">출간 예정일</label>
                        <input type="date" id="extra-publish-date" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    </div>
                </div>
                <div class="flex gap-3 pt-2">
                    <button onclick="closeExtraModal()" class="flex-1 py-3 rounded-xl font-bold text-slate-600 bg-slate-100 hover:bg-slate-200">취소</button>
                    <button onclick="saveExtra()" class="flex-1 py-3 rounded-xl font-bold text-white shadow-lg" style="background:var(--primary)">저장</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 설정 패널 모달 -->
    <div id="settings-panel-modal" class="modal-overlay">
        <div class="modal-content w-full" style="max-width:540px; max-height:92vh; display:flex; flex-direction:column; padding:28px 30px;">
            <div class="flex justify-between items-center mb-4 shrink-0">
                <h3 class="text-xl font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-gear text-slate-500"></i> 설정</h3>
                <button onclick="closeSettingsPanel()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times text-xl"></i></button>
            </div>
            <div class="overflow-y-auto custom-scrollbar flex-1 min-h-0 space-y-5">
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase mb-2">데이터 관리</p>
                    <div class="flex gap-2">
                        <button onclick="downloadBackup(); closeSettingsPanel();" class="flex-1 py-2.5 rounded-xl text-xs font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 transition-all flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-download text-emerald-500"></i> 백업 파일 받기
                        </button>
                        <label class="cursor-pointer flex-1 py-2.5 rounded-xl text-xs font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 transition-all flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-upload text-blue-500"></i> 백업 불러오기
                            <input type="file" id="backup-upload" accept=".json" onchange="uploadBackup(event)" class="hidden">
                        </label>
                        <button onclick="resetData()" class="flex-1 py-2.5 rounded-xl text-xs font-bold text-red-500 bg-red-50 hover:bg-red-100 transition-all flex items-center justify-center gap-1.5 border border-red-100">
                            <i class="fa-solid fa-rotate-left"></i> 초기화
                        </button>
                    </div>
                    <p class="text-[11px] text-slate-400 mt-3 leading-relaxed">데이터는 <b>이 컴퓨터의 이 브라우저 안에만</b> 저장되고, 어디로도 전송되지 않아요.
                    브라우저 방문 기록/사이트 데이터를 지우거나 다른 브라우저로 열면 보이지 않으니, 가끔 <b>백업 파일</b>을 받아 두세요.</p>
                </div>
                <div id="modal-design-wrap">
                    <p class="text-xs font-bold text-slate-400 uppercase mb-2">팝업창 디자인</p>
                    <div id="modal-design-picker" class="grid grid-cols-3 gap-2">
                        <button type="button" data-modal="cozy" onclick="setModalDesign('cozy')" class="modal-design-btn flex flex-col items-center gap-1 p-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600"><span class="dday-swatch dday-swatch-cozy"></span>코지</button>
                        <button type="button" data-modal="label" onclick="setModalDesign('label')" class="modal-design-btn flex flex-col items-center gap-1 p-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600"><span class="dday-swatch dday-swatch-label"></span>견출지</button>
                        <button type="button" data-modal="polaroid" onclick="setModalDesign('polaroid')" class="modal-design-btn flex flex-col items-center gap-1 p-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600"><span class="dday-swatch dday-swatch-polaroid"></span>폴라로이드</button>
                        <button type="button" data-modal="postcard" onclick="setModalDesign('postcard')" class="modal-design-btn flex flex-col items-center gap-1 p-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600"><span class="dday-swatch dday-swatch-postcard"></span>엽서</button>
                        <button type="button" data-modal="fountain" onclick="setModalDesign('fountain')" class="modal-design-btn flex flex-col items-center gap-1 p-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600"><span class="dday-swatch dday-swatch-fountain"></span>만년필</button>
                    </div>
                </div>
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase mb-2">자동 보관본 (하루 1번 자동으로 쌓여요)</p>
                    <div class="flex gap-2">
                        <select id="snap-select" class="flex-1 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-xs outline-none"><option value="">불러오는 중...</option></select>
                        <button onclick="restoreSnapshot()" class="px-4 py-2.5 rounded-xl text-xs font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 transition-all">되돌리기</button>
                    </div>
                    <p class="text-[11px] text-slate-400 mt-2 leading-relaxed">실수로 지웠을 때를 대비해 최근 5일치가 보관돼요. 되돌리면 현재 내용은 사라지니 먼저 백업 파일을 받아 두면 안전해요.</p>
                </div>
            </div>
        </div>
    </div>

    </div>

    <!-- 공미 ↔ 공포 글자수 계산기 -->
    <div id="char-calc-modal" class="modal-overlay">
        <div class="modal-content w-full" style="max-width:640px;">
            <div class="flex justify-between items-center mb-1">
                <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-calculator text-slate-500"></i> 공미 ↔ 공포 계산기</h3>
                <button onclick="closeCharCalc()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-times text-xl"></i></button>
            </div>
            <p class="text-xs text-slate-400 mb-5">공백 미포함(공미) / 공백 포함(공포) 글자수를 서로 계산해요.</p>

            <div class="grid grid-cols-2 gap-x-6 gap-y-4">
                <div>
                    <label class="text-xs text-slate-400 font-bold block mb-1">현재 공미</label>
                    <input type="number" id="cc-cur-nospace" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-[var(--primary)]" oninput="ccCompute()">
                </div>
                <div>
                    <label class="text-xs text-slate-400 font-bold block mb-1">현재 공포</label>
                    <input type="number" id="cc-cur-space" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-[var(--primary)]" oninput="ccCompute()">
                </div>
                <div>
                    <label class="text-xs text-slate-400 font-bold block mb-1">목표 공미</label>
                    <input type="number" id="cc-goal-nospace" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-[var(--primary)]" oninput="ccCompute()">
                </div>
                <div>
                    <label class="text-xs text-slate-400 font-bold block mb-1">목표 공포</label>
                    <input type="number" id="cc-goal-space" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-[var(--primary)]" oninput="ccCompute()">
                </div>

                <div class="col-span-2">
                    <label class="text-xs text-slate-400 font-bold block mb-1">편당 글자수 기준</label>
                    <div class="flex gap-2">
                        <button type="button" onclick="ccSetPerUnit('po')" id="cc-per-unit-po" class="flex-1 py-2 rounded-xl text-xs font-bold border transition-all">공포 기준</button>
                        <button type="button" onclick="ccSetPerUnit('mi')" id="cc-per-unit-mi" class="flex-1 py-2 rounded-xl text-xs font-bold border transition-all">공미 기준</button>
                    </div>
                </div>

                <div>
                    <label class="text-xs text-slate-400 font-bold block mb-1">편당 글자수</label>
