                        </div>
                        <div id="visual-lib-container" class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-8"></div>
                    </div>
                </div>

                <!-- 작품 등록 탭 -->
                <div id="tab-works" class="tab-content">
                    <div class="grid gap-8" style="grid-template-columns: 30% 1fr;">
                        <div class="h-full">

                            <!-- 신규 등록 버튼 (폼 닫혔을 때만 표시) -->
                            <div id="work-new-btn-area" class="glass-card p-6 h-fit hidden flex items-center justify-center">
                                <button onclick="openNewWorkForm()" class="flex items-center gap-2 px-5 py-3 rounded-xl font-bold text-white shadow-md hover:-translate-y-0.5 transition-all text-sm" style="background:var(--primary)">
                                    <i class="fa-solid fa-plus"></i> 신규 작품 등록
                                </button>
                            </div>

                            <!-- 등록/수정 폼 -->
                            <div class="glass-card p-8 scroll-invisible" id="work-form-card" style="overflow-y: auto;">
                            <div class="space-y-4">
                                    <div id="work-form-title-area" class="flex items-center gap-2 mb-2">
                                        <span class="w-7 h-7 rounded-lg bg-emerald-600 text-white flex items-center justify-center shadow-md text-xs" id="work-form-icon"><i class="fa-solid fa-plus"></i></span>
                                        <span class="font-bold text-slate-700 text-base" id="work-form-label">신규 작품 등록</span>
                                        <button id="work-form-cancel-btn" onclick="cancelEditWork()" class="hidden ml-auto text-xs text-slate-400 hover:text-slate-600 border border-slate-200 rounded-lg px-2 py-1">취소</button>
                                    </div>
                                    <input type="hidden" id="work-editing-id" value="">
                                    <!-- 1줄: 장르 + 출판사 -->
                                    <div class="grid grid-cols-2 gap-3">
                                        <div>
                                            <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">장르</label>
                                            <select id="new-work-genre" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 transition-all cursor-pointer" onchange="toggleStudioInput()"></select>
                                        </div>
                                        <div>
                                            <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">출판사</label>
                                            <input list="publisher-list" type="text" id="new-work-publisher" placeholder="출판사" oninput="syncSettlementPublisher(this.value)" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 transition-all">
                                            <datalist id="publisher-list"></datalist>
                                        </div>
                                    </div>
                                    <!-- 2줄: 작품명 -->
                                    <div>
                                        <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">작품명</label>
                                        <div class="relative">
                                            <input type="text" id="new-work-title" placeholder="작품명을 입력하세요" autocomplete="off" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 transition-all">
                                            <ul id="custom-title-dropdown" class="hidden absolute top-full left-0 w-full max-h-[500px] overflow-y-auto bg-white border border-slate-200 rounded-xl shadow-lg mt-1 z-50 custom-scrollbar"></ul>
                                        </div>
                                    </div>
                                    <!-- 2-1줄: 플랫폼 + 프로모션 (작품관리와 연동, 웹툰은 웹툰관리에서 따로 관리해서 숨김) -->
                                    <div id="platform-promo-row" class="grid grid-cols-2 gap-3">
                                        <div>
                                            <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">플랫폼</label>
                                            <div class="flex gap-1">
                                                <select id="new-work-platform-select" onchange="handleNewWorkPlatformChange(this)" class="flex-1 min-w-0 w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 transition-all">
                                                    <option value="">선택 안 함</option>
                                                    <option value="리디">리디</option>
                                                    <option value="시리즈">시리즈</option>
                                                    <option value="카카오">카카오</option>
                                                    <option value="봄툰">봄툰</option>
                                                    <option value="미스터블루">미스터블루</option>
                                                    <option value="레진">레진</option>
                                                    <option value="custom">직접 입력</option>
                                                </select>
                                                <input type="text" id="new-work-platform-custom" placeholder="직접 입력" class="w-[90px] shrink-0 p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 hidden">
                                            </div>
                                        </div>
                                        <div>
                                            <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">프로모션</label>
                                            <div class="flex gap-1">
                                                <select id="new-work-promotion-select" onchange="handleNewWorkPromotionChange(this)" class="flex-1 min-w-0 w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 transition-all">
                                                    <option value="">선택 안 함</option>
                                                    <option value="오리발">오리발</option>
                                                    <option value="원픽">원픽</option>
                                                    <option value="단독배너">단독배너</option>
                                                    <option value="출판사 배너">출판사 배너</option>
                                                    <option value="캘린더">캘린더</option>
                                                    <option value="묶음 시단신">묶음 시단신</option>
                                                    <option value="단독 시단신">단독 시단신</option>
                                                    <option value="custom">직접 입력</option>
                                                </select>
                                                <input type="text" id="new-work-promotion-custom" placeholder="직접 입력" class="w-[90px] shrink-0 p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 hidden">
                                            </div>
                                        </div>
                                    </div>
                                    <!-- 3줄: 정산비율 + 권수 -->
                                    <div id="publisher-rate-row" class="grid grid-cols-2 gap-3">
                                        <div id="normal-rate-group">
                                            <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">정산 비율</label>
                                            <div class="flex gap-2">
                                                <select id="new-work-rate" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 transition-all" onchange="handleRateSelectChange(this)">
                                                    <option value="" selected>선택 안함</option>
                                                    <option value="70">70%</option>
                                                    <option value="50">50%</option>
                                                    <option value="60">60%</option>
                                                    <option value="75">75%</option>
                                                    <option value="80">80%</option>
                                                    <option value="90">90%</option>
                                                    <option value="custom">직접 입력</option>
                                                </select>
                                                <input type="number" id="new-work-rate-custom" class="w-20 p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:ring-2 focus:ring-emerald-100 hidden" placeholder="%">
                                            </div>
                                        </div>
                                        <div id="volumes-field-group">
                                            <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">권수</label>
                                            <select id="new-work-volumes" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                                                <option value="1" selected>1권</option>
                                                <option value="2">2권</option>
                                                <option value="3">3권</option>
                                                <option value="4">4권</option>
                                                <option value="5">5권</option>
                                            </select>
                                        </div>
                                    </div>
                                    <!-- 웹툰 전용 필드 -->
                                    <div id="studio-field-group" class="hidden space-y-3">
                                        <div>
                                            <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">웹툰 스튜디오</label>
                                            <input type="text" id="new-work-studio" list="studio-list" placeholder="제작/스튜디오명" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 transition-all">
                                            <datalist id="studio-list"></datalist>
                                            <datalist id="existing-titles-list"></datalist>
                                        </div>
                                        <div>
                                            <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">정산 출판사 <span class="text-[10px] font-normal text-slate-400">(실제 돈이 들어오는 곳 · 기본은 출판사와 동일)</span></label>
                                            <input list="publisher-list" type="text" id="new-work-settlement-publisher" placeholder="출판사와 동일" oninput="settlementPublisherTouched = true;" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 transition-all">
                                        </div>
                                        <div class="grid grid-cols-2 gap-3">
                                            <div>
                                                <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">RS <span class="text-slate-400 font-normal">(%)</span></label>
                                                <input type="number" id="new-work-rs" placeholder="예: 10" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                                            </div>
                                            <div>
                                                <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">내 비율 <span class="text-slate-400 font-normal">(%)</span></label>
                                                <input type="number" id="new-work-webtoon-rate" placeholder="예: 70" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                                            </div>
                                        </div>
                                    </div>
                                    <!-- 웹툰 전용 날짜 (계약일 + 출간일) -->
                                    <!-- 웹툰 전용 날짜 (계약일 + 출간일) -->
                                    <div id="webtoon-dates-group" class="hidden grid grid-cols-2 gap-3">
                                        <div>
                                            <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">계약일</label>
                                            <input type="date" id="new-work-contract-date" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 transition-all">
                                        </div>
                                        <div>
                                            <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">런칭일</label>
                                            <div class="flex items-center gap-2">
                                                <input type="date" id="new-work-date-webtoon" class="flex-1 p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 transition-all">
                                                <input type="month" id="new-work-pending-month-webtoon" class="flex-1 p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 transition-all hidden">
                                                <label class="flex items-center gap-1.5 cursor-pointer shrink-0 bg-slate-50 border border-slate-200 rounded-xl px-3 py-3" title="런칭 예정">
                                                    <input type="checkbox" id="new-work-pending-webtoon" class="accent-emerald-500 w-3.5 h-3.5" onchange="document.getElementById('new-work-pending').checked=this.checked; toggleNewWorkDate(this)">
                                                    <i class="fa-solid fa-star text-yellow-400 text-xs"></i>
                                                </label>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 글자수: 공미 / 공포 -->
                                    <div id="goal-field-group">
                                        <div class="grid grid-cols-2 gap-3">
                                            <div>
                                                <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">공미 <span class="text-[10px] font-normal text-slate-400">(공백 미포함)</span></label>
                                                <input type="number" id="new-work-goal-nospace" placeholder="0" oninput="calcGoalFromNoSpace(this.value)" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                                            </div>
                                            <div>
                                                <label class="text-sm font-bold ml-1 mb-1 block" style="color:var(--primary)">공포 <span class="text-[10px] font-normal" style="color:var(--primary);">(기준 글자수)</span></label>
                                                <input type="number" id="new-work-goal-withspace" placeholder="0" oninput="calcGoalFromWithSpace(this.value)" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100" style="border-color:#87ada1">
                                            </div>
                                        </div>
                                        <!-- 완고 입고일 + 출간일 -->
                                        <div class="grid grid-cols-2 gap-3 mt-3">
                                            <div id="manuscript-date-group">
                                                <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">완고 입고일 <span class="text-[10px] font-normal text-slate-400">D-Day 기준</span></label>
                                                <input type="date" id="new-work-manuscript-date" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 transition-all">
                                            </div>
                                            <div>
                                                <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">출간일</label>
                                                <div class="flex items-center gap-2">
                                                    <input type="date" id="new-work-date" class="flex-1 p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 transition-all">
                                                    <input type="month" id="new-work-pending-month" class="flex-1 p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 transition-all hidden">
                                                    <label class="flex items-center gap-1.5 cursor-pointer shrink-0 bg-slate-50 border border-slate-200 rounded-xl px-3 py-3" title="출간 예정">
                                                        <input type="checkbox" id="new-work-pending" class="accent-emerald-500 w-3.5 h-3.5" onchange="toggleNewWorkDate(this)">
                                                        <i class="fa-solid fa-star text-yellow-400 text-xs"></i>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="dates-row" class="hidden"></div>

                                    <!-- 선인세 -->
                                    <div class="grid grid-cols-2 gap-3 mt-1">
                                        <div>
                                            <label class="text-sm font-bold text-slate-600 ml-1 mb-1 block">선인세 <span class="text-[10px] font-normal text-slate-400">(만원)</span></label>
                                            <input type="number" id="new-work-advance-amount" placeholder="예) 300" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                                        </div>
                                        <div>
                                            <label id="new-work-advance-date-label" class="text-sm font-bold text-slate-600 ml-1 mb-1 block">선인세 예정일</label>
                                            <input type="month" id="new-work-advance-date" class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                                        </div>
                                    </div>

                                    <button onclick="registerOrUpdateWork()" id="work-form-submit-btn" class="w-full py-3.5 mt-2 rounded-xl font-bold text-white shadow-lg transition-all hover:-translate-y-1 active:scale-95 flex justify-center items-center gap-2" style="background: var(--primary)">
                                        <i class="fa-solid fa-check"></i> <span id="work-form-submit-label">등록하기</span>
                                    </button>
                                    
                                    <!-- 외전 관리 영역 (수정 모드에서만 표시) -->
                                    <div id="extras-section" class="hidden border-t border-slate-100 pt-4 mt-2">
                                        <div class="flex items-center justify-between mb-2">
                                            <label class="text-sm font-bold text-slate-600">📖 외전 / 추가 집필</label>
                                            <button type="button" onclick="openExtraModal()" class="text-xs font-bold text-emerald-600 hover:text-emerald-700 px-2 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100">+ 외전 추가</button>
                                        </div>
                                        <p class="text-[10px] text-slate-400 mb-3">외전은 집필 관리/상세 기록에만 표시되며 정산에는 영향 없습니다.</p>
                                        <div id="extras-list" class="space-y-2 scroll-invisible" style="max-height: 220px; overflow-y: auto;"></div>
                                    </div>
                                </div>
                            </div>
                        </div> <!-- /왼쪽 셀 h-full -->
                        <!-- 오른쪽: 작품 목록 -->
                        <div id="works-right-panel">
                            <div class="glass-card p-6 flex flex-col h-full">
                                <div class="flex items-center justify-between mb-4 flex-shrink-0">
                                    <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2"><button onclick="openGenreManager()" class="text-slate-400 hover:text-emerald-600 transition-colors p-1 rounded-lg hover:bg-slate-100" title="장르 및 태그 관리"><i class="fa-solid fa-gear text-base"></i></button> 등록된 작품 목록 <span id="total-works-badge" class="ml-2 bg-slate-100 text-slate-500 text-xs px-2 py-0.5 rounded-full font-bold">0</span><span id="total-volumes-badge" class="hidden text-xs text-slate-400 font-medium"></span></h3>
                                    <div id="library-tabs" class="flex gap-1 bg-slate-100 p-1 rounded-lg flex-wrap"></div>
                                </div>
                                <div class="overflow-y-auto custom-scrollbar pr-2 min-h-0 flex-1">
                                    <div id="master-works-by-genre-container" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 출판사 현황 탭 -->
                <div id="tab-publishers" class="tab-content pb-20">
                    <div class="glass-card py-3 px-5 mt-3 mx-auto" style="max-width: 98%;">
                        <div class="flex justify-between items-center">
                            <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-building-user text-emerald-500"></i> <span id="publisher-tab-title">계약 출판사 현황</span>
                                <span id="pub-view-toggle" class="flex items-center gap-1 ml-2">
                                    <button onclick="setPublisherViewMode('list')" id="pub-view-list-btn" class="w-7 h-7 flex items-center justify-center rounded-lg transition-all" title="줄로 보기"><i class="fa-solid fa-list text-xs"></i></button>
                                    <button onclick="setPublisherViewMode('card')" id="pub-view-card-btn" class="w-7 h-7 flex items-center justify-center rounded-lg transition-all" title="카드로 보기"><i class="fa-solid fa-grip text-xs"></i></button>
                                </span>
                            </h3>
                            <div class="flex gap-1 bg-slate-100 p-1 rounded-lg">
                                <button onclick="switchPublisherTab('publishers')" id="pub-tab-publishers" class="px-4 py-1.5 text-sm font-bold rounded-md bg-white text-slate-700 shadow-sm transition-all">출판사</button>
                                <button onclick="switchPublisherTab('studios')" id="pub-tab-studios" class="px-4 py-1.5 text-sm font-bold rounded-md text-slate-400 hover:bg-white/50 transition-all">웹툰 스튜디오</button>
                                <button onclick="switchPublisherTab('contacts')" id="pub-tab-contacts" class="px-4 py-1.5 text-sm font-bold rounded-md text-slate-400 hover:bg-white/50 transition-all">컨택</button>
                                <button onclick="switchPublisherTab('submissions')" id="pub-tab-submissions" class="px-4 py-1.5 text-sm font-bold rounded-md text-slate-400 hover:bg-white/50 transition-all">투고</button>
                                <button onclick="switchPublisherTab('webtoon-subs')" id="pub-tab-webtoon-subs" class="px-4 py-1.5 text-sm font-bold rounded-md text-slate-400 hover:bg-white/50 transition-all">웹툰 투고</button>
                            </div>
                        </div>
                    </div>
                    <div id="publisher-status-list" class="mx-auto" style="max-width: 98%; margin-top: 20px;"></div>
                </div>

                <!-- 웹툰 관리 탭 (NEW) -->
                <div id="tab-webtoon" class="tab-content pb-20">
                    <div class="glass-card py-3 px-5 mt-3 mx-auto" style="max-width: 98%;">
                        <div class="flex justify-between items-center flex-wrap gap-3">
                            <h3 data-eyebrow="webtoons" class="text-lg font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-clapperboard text-yellow-500"></i> 웹툰 관리 <span id="webtoon-total-count" class="text-xs font-bold text-white rounded-full px-2 py-0.5" style="background:var(--primary)">0</span></h3>
                            <div class="flex items-center gap-1.5 flex-wrap" id="webtoon-view-tabs">
                                <button onclick="setWebtoonViewFilter('all')" id="wtvf-all" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all">전체 보기</button>
                                <button onclick="setWebtoonViewFilter('published')" id="wtvf-published" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all">출간작만 보기</button>
                                <button onclick="setWebtoonViewFilter('upcoming')" id="wtvf-upcoming" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all">출간 예정 보기</button>
                                <button onclick="setWebtoonViewFilter('pen')" id="wtvf-pen" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all">필명 별로 보기</button>
                                <button onclick="setWebtoonViewFilter('broken')" id="wtvf-broken" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all">계약 파기</button>
                                <button onclick="openWebtoonCardSettings()" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-all" title="카드 설정"><i class="fa-solid fa-sliders"></i></button>
                            </div>
                        </div>
                    </div>
                    <div id="webtoon-manage-list" class="mx-auto" style="max-width: 98%; margin-top: 20px;"></div>
                </div>

                <!-- 작품 관리 탭 (NEW) -->
                <div id="tab-workmanage" class="tab-content pb-20">
                    <div class="glass-card py-3 px-5 mt-3 mx-auto" style="max-width: 98%;">
                        <div class="flex justify-between items-center flex-wrap gap-3">
                            <h3 data-eyebrow="works" class="text-lg font-bold text-slate-700 flex items-center gap-2"><i class="fa-solid fa-layer-group text-yellow-500"></i> 작품 관리 <span id="workmanage-total-count" class="text-xs font-bold text-white rounded-full px-2 py-0.5" style="background:var(--primary)">0</span></h3>
                            <div class="flex items-center gap-1.5 flex-wrap" id="workmanage-view-tabs">
                                <button onclick="setWorkManageViewFilter('all')" id="wmvf-all" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all">전체 보기</button>
