                                </div>
                                <div>
                                    <h3 id="stat-total" class="text-2xl font-bold text-slate-800">₩ 0</h3>
                                    <p id="stat-total-pretax" class="text-[14px] text-slate-500 font-normal mt-0.5">(₩ 0)</p>
                                </div>
                            </div>
                            <div class="border-t border-slate-100 my-2"></div>
                            <div class="mt-2">
                                <div class="flex justify-between items-start mb-1">
                                    <div><p class="text-[11px] font-bold text-slate-400 uppercase">Avg/Year</p><p class="text-xs text-slate-500">연 평균 순수익</p></div>
                                    <div class="p-1.5 rounded-lg bg-emerald-50 text-emerald-400 text-xs"><i class="fa-solid fa-chart-pie"></i></div>
                                </div>
                                <h3 id="stat-avg-year" class="text-xl font-bold text-slate-600">₩ 0</h3>
                                <p id="stat-avg-year-pretax" class="text-[12px] text-slate-400 font-normal mt-0.5">세전 ₩ 0</p>
                            </div>
                        </div>
                        <div class="stat-card border-l-4" style="border-left-color: #60a5fa">
                            <div class="mb-4">
                                <div class="flex justify-between items-start mb-1">
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <p class="text-[11px] font-bold text-slate-400 uppercase">This Year Profit</p>
                                            <div class="flex gap-1 bg-slate-50 rounded px-1">
                                                <button onclick="changeDashYear(-1)" class="w-4 h-4 rounded hover:bg-slate-200 flex items-center justify-center text-slate-400 transition-colors"><i class="fa-solid fa-chevron-left text-[8px]"></i></button>
                                                <button onclick="changeDashYear(1)" class="w-4 h-4 rounded hover:bg-slate-200 flex items-center justify-center text-slate-400 transition-colors"><i class="fa-solid fa-chevron-right text-[8px]"></i></button>
                                            </div>
                                        </div>
                                        <p class="text-xs text-slate-500"><span id="dashboard-year-label"></span>년 순수익</p>
                                    </div>
