                                <div class="text-center font-bold text-slate-500 text-xs py-2 bg-slate-50 rounded-t">월</div>
                                <div class="text-center font-bold text-slate-500 text-xs py-2 bg-slate-50 rounded-t">화</div>
                                <div class="text-center font-bold text-slate-500 text-xs py-2 bg-slate-50 rounded-t">수</div>
                                <div class="text-center font-bold text-slate-500 text-xs py-2 bg-slate-50 rounded-t">목</div>
                                <div class="text-center font-bold text-slate-500 text-xs py-2 bg-slate-50 rounded-t">금</div>
                                <div class="text-center font-bold text-blue-500 text-xs py-2 bg-slate-50 rounded-t">토</div>
                            </div>
                            <div id="task-calendar-body" class="grid grid-cols-7 gap-1"></div>
                        </div>
                        <!-- 우측: 미완료 스케줄 사이드바 -->
                        <div id="task-dday-sidebar" class="w-72 shrink-0 flex flex-col sticky top-4" style="height:calc(100vh - 120px)">
                            <div class="glass-card p-4 flex flex-col" style="height:100%">
                                <div class="flex items-center justify-between mb-1">
                                    <h3 data-eyebrow="schedule" class="text-sm font-bold text-slate-700 flex items-center gap-2"><i class="dday-ko fa-solid fa-star text-indigo-400 text-xs"></i><span class="dday-ko"> 스케줄</span></h3>
                                    <button type="button" onclick="toggleDdayDesignMenu(this, event, 'task')" class="dday-design-btn w-6 h-6 items-center justify-center rounded-full hover:bg-slate-100 transition-all text-slate-400 hover:text-slate-600" title="카드 디자인"><i class="fa-solid fa-palette text-xs"></i></button>
                                </div>
