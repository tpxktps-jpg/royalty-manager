                                </div>
                                <div class="absolute left-1/2 -translate-x-1/2 text-center pointer-events-none">
                                    <p id="task-month-big-label" style="font-family:'Pretendard','Apple SD Gothic Neo',sans-serif; font-size:2.5rem; font-weight:800; color:var(--primary); line-height:1;"></p>
                                </div>
                                <div id="task-nav-pill" class="flex items-center bg-slate-100 rounded-lg p-1">
                                    <button onclick="changeTaskMonth(-1)" class="w-8 h-8 flex items-center justify-center text-slate-500 hover:bg-white rounded-md transition-all"><i class="fa-solid fa-chevron-left"></i></button>
                                    <span id="task-cal-title" class="px-4 font-bold text-slate-700 w-32 text-center">2026년 5월</span>
                                    <button onclick="changeTaskMonth(1)" class="w-8 h-8 flex items-center justify-center text-slate-500 hover:bg-white rounded-md transition-all"><i class="fa-solid fa-chevron-right"></i></button>
                                    <button onclick="changeTaskMonth(0, true)" class="ml-2 px-3 py-1 bg-white text-xs font-bold text-slate-600 rounded-md shadow-sm">Today</button>
                                    <button onclick="openTaskSettings()" class="ml-2 w-8 h-8 flex items-center justify-center text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-md transition-all" title="스케줄 설정"><i class="fa-solid fa-sliders"></i></button>
                                </div>
                            </div>
