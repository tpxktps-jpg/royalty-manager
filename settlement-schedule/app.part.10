                // 비율은 계약서마다 적는 기준이 달라서(웹툰 7% vs 출판 70%) 자동으로 바꾸지 않는다.
                // 메모에만 적어두고, 칸은 직접 확인해서 넣도록 남겨둔다.
                if (mode === 'webtoon') {
                    setVal('wtm-contract-date', info.contractDate, '계약일');
                    if (info.mgManwon) setVal('wtm-mg', info.mgManwon, 'MG');
                } else {
                    setVal('wmm-contract-date', info.contractDate, '계약일');
                    setVal('wmm-mg', info.mgManwon, '선인세');      // 만원 단위
                }

                // 원본 PDF는 구글드라이브 폴더에 보관하고, 데이터에는 파일 이름만 남긴다
                let savedNote = '';
                if (window.electronAPI?.saveContractFile) {
                    const w = masterWorks.find(x => x.id === conf.workId());
                    const baseTitle = (w?.title || info.workTitle || '계약서').replace(/[\\/:*?"<>|]/g, '_').trim();
                    const bytes = Array.from(new Uint8Array(await file.arrayBuffer()));
                    const r = await window.electronAPI.saveContractFile(`${conf.label}_${baseTitle}.pdf`, bytes);
                    if (r?.ok) {
                        currentContractFile[mode] = r.fileName;
                        refreshContractButtons(mode);
                        savedNote = r.onDrive ? ' · 구글드라이브에 보관됨' : ' · 내 컴퓨터에 보관됨';
                    }
                }

                const found = Object.keys(info).length;
                const changedNote = changed.length ? ` · ${changed.join('·')} 갱신` : '';
                statusEl.textContent = (found ? `${found}개 항목을 찾았어요` : '내용을 찾지 못했어요 (직접 입력해주세요)') + changedNote + savedNote;
                statusEl.className = `text-[11px] ${found ? 'text-emerald-600' : 'text-rose-500'}`;
            } catch (err) {
                console.error('[계약서 PDF]', err);
                statusEl.textContent = 'PDF를 읽지 못했어요';
                statusEl.className = 'text-[11px] text-rose-500';
                alert('PDF를 읽지 못했습니다.\n스캔 이미지로 된 PDF는 글자를 뽑을 수 없어요.\n\n' + (err.message || ''));
            } finally {
                input.value = '';
            }
        }

        function openWebtoonManageModal(workId) {
            const w = masterWorks.find(x => x.id === workId);
            if (!w) return;
            currentWebtoonManageWorkId = workId;
            const info = webtoonManage[workId] || {};
            document.getElementById('wtm-modal-title').innerText = w.title;
            populatePenNameSelect();
            const penSel = document.getElementById('wtm-pen-name');
            if (penSel) penSel.value = penNames.includes(info.penName) ? info.penName : '';
            document.getElementById('wtm-contract-date').value = w.contractDate || '';
            document.getElementById('wtm-launch-pending').checked = !!w.isPending;
            document.getElementById('wtm-launch-date').value = w.isPending ? '' : (w.publishDate || '');
            document.getElementById('wtm-launch-pending-month').value = w.pendingMonth || '';
            toggleWtmLaunchPending(!!w.isPending);
            document.getElementById('wtm-mg').value = w.advanceAmount || '';
            document.getElementById('wtm-mg-date').value = w.advanceDate || '';
            document.getElementById('wtm-rs').value = w.rs || '';
            document.getElementById('wtm-webtoon-rate').value = w.webtoonRate || '';
            document.getElementById('wtm-charguide-date').value = getWebtoonCharGuideDate(workId) || '';
            document.getElementById('wtm-cashsheet-date').value = info.cashsheetDate || '';
            document.getElementById('wtm-ep1conti-date').value = info.ep1ContiDate || '';
            document.getElementById('wtm-mg-paid-date').value = info.mgPaidDate || '';
            document.getElementById('wtm-charguide-done').checked = !!info.charGuideDone;
            document.getElementById('wtm-cashsheet-done').checked = !!info.cashsheetDone;
            document.getElementById('wtm-ep1conti-done').checked = !!info.ep1ContiDone;
            document.getElementById('wtm-mg-paid-done').checked = !!info.mgPaidDone;
            document.getElementById('wtm-contract-broken').checked = !!w.contractBroken;
            loadAdvDraft('wtm', w);
            document.getElementById('wtm-illustrator').value = info.illustrator || '';
            document.getElementById('wtm-website').value = info.website || '';
            document.getElementById('wtm-launch-platform').value = info.launchPlatform || '';
            document.getElementById('wtm-launch-url').value = info.launchUrl || '';
            document.getElementById('wtm-memo').value = info.contractMemo || '';
            document.getElementById('wtm-pdf-status').textContent = '';
            document.getElementById('wtm-pdf-input').value = '';
            currentContractFile.webtoon = info.contractFile || '';
            refreshContractButtons('webtoon');
            document.getElementById('webtoon-manage-modal').classList.add('open');
        }
        // 런칭 예정 체크 시 확정 날짜 입력 대신 연/월만 선택하는 입력으로 전환 (작품 등록과 동일한 방식)
        function toggleWtmLaunchPending(checked) {
            const dateInput = document.getElementById('wtm-launch-date');
            const monthInput = document.getElementById('wtm-launch-pending-month');
            if (!dateInput || !monthInput) return;
            if (checked) { dateInput.classList.add('hidden'); monthInput.classList.remove('hidden'); }
            else { dateInput.classList.remove('hidden'); monthInput.classList.add('hidden'); monthInput.value = ''; }
        }
        // 계약 파기: 작품은 지우지 않고 표시만 한다 — 받은 MG 등 정산 금액은 수입에 그대로 남고,
        // 웹툰 관리 목록·작품 선택 목록·월별 정산 표에서는 빠진다. 제목 뒤에 ' (계파)'를 붙여서
        // 나중에 같은 제목으로 다시 등록해도 다른 작품으로 따로 관리된다.
        const CONTRACT_BROKEN_SUFFIX = ' (계파)';
        function toggleWebtoonContractBroken(cb) {
            const w = masterWorks.find(x => x.id === currentWebtoonManageWorkId);
            if (!w) { cb.checked = false; return; }
            if (cb.checked) {
                if (!confirm(`'${w.title}' 계약을 파기하시겠습니까?\n\n· 웹툰 관리 목록에서 빠지고 '계약 파기' 목록에만 보여요.\n· 받은 MG 등 정산 금액은 수입에 그대로 남아요.\n· 제목 뒤에 (계파)가 붙어요.`)) { cb.checked = false; return; }
                w.contractBroken = true;
                w.contractBrokenDate = getYYYYMMDD(new Date());
                if (!w.title.endsWith(CONTRACT_BROKEN_SUFFIX)) w.title += CONTRACT_BROKEN_SUFFIX;
            } else {
                if (!confirm(`'${w.title}' 계약 파기를 취소할까요?\n원래대로 웹툰 관리 목록에 다시 보여요.`)) { cb.checked = true; return; }
                w.contractBroken = false;
                delete w.contractBrokenDate;
                if (w.title.endsWith(CONTRACT_BROKEN_SUFFIX)) w.title = w.title.slice(0, -CONTRACT_BROKEN_SUFFIX.length);
            }
            document.getElementById('wtm-modal-title').innerText = w.title;
            save();
            renderWebtoonManage();
        }
        function closeWebtoonManageModal() {
            document.getElementById('webtoon-manage-modal').classList.remove('open');
            currentWebtoonManageWorkId = null;
        }
        function saveWebtoonManageModal() {
            if (!currentWebtoonManageWorkId) return;
            const workId = currentWebtoonManageWorkId;
            if (!webtoonManage[workId]) webtoonManage[workId] = {};
            webtoonManage[workId].penName = document.getElementById('wtm-pen-name').value;
            webtoonManage[workId].cashsheetDate = document.getElementById('wtm-cashsheet-date').value;
            webtoonManage[workId].ep1ContiDate = document.getElementById('wtm-ep1conti-date').value;
            webtoonManage[workId].mgPaidDate = document.getElementById('wtm-mg-paid-date').value;
            webtoonManage[workId].charGuideDone = document.getElementById('wtm-charguide-done').checked;
            webtoonManage[workId].cashsheetDone = document.getElementById('wtm-cashsheet-done').checked;
            webtoonManage[workId].ep1ContiDone = document.getElementById('wtm-ep1conti-done').checked;
            webtoonManage[workId].mgPaidDone = document.getElementById('wtm-mg-paid-done').checked;
            webtoonManage[workId].illustrator = document.getElementById('wtm-illustrator').value.trim();
            webtoonManage[workId].website = document.getElementById('wtm-website').value.trim();
            webtoonManage[workId].launchPlatform = document.getElementById('wtm-launch-platform').value;
            webtoonManage[workId].contractMemo = document.getElementById('wtm-memo').value;
            webtoonManage[workId].contractFile = currentContractFile.webtoon || '';
            webtoonManage[workId].launchUrl = document.getElementById('wtm-launch-url').value.trim();
            setWebtoonCharGuideDate(workId, document.getElementById('wtm-charguide-date').value);
            // 계약일/런칭일은 '작품 등록'의 데이터를 직접 갱신 → 쌍방 연동
            const w = masterWorks.find(x => x.id === workId);
            if (w) {
                w.contractDate = document.getElementById('wtm-contract-date').value;
                const isPending = document.getElementById('wtm-launch-pending').checked;
                w.isPending = isPending;
                w.publishDate = isPending ? '' : document.getElementById('wtm-launch-date').value;
                w.pendingMonth = isPending ? document.getElementById('wtm-launch-pending-month').value : '';
                const mgVal = document.getElementById('wtm-mg').value;
                w.advanceAmount = mgVal ? Number(mgVal) : '';
                w.advanceDate = document.getElementById('wtm-mg-date').value.trim();
                const rsVal = document.getElementById('wtm-rs').value;
                const wrVal = document.getElementById('wtm-webtoon-rate').value;
                w.rs = rsVal !== '' ? parseFloat(rsVal) : null;
                w.webtoonRate = wrVal !== '' ? parseFloat(wrVal) : null;
                if (w.rs && w.webtoonRate) w.rate = Math.round(w.rs * w.webtoonRate / 100 * 10) / 10;
                commitAdvDraft('wtm', w);
            }
            save();
            closeWebtoonManageModal();
            renderWebtoonManage();
        }
        function openWebtoonCardSettings() {
            document.getElementById('wcs-differentiate').checked = !!webtoonCardSettings.differentiatePublished;
            document.getElementById('wcs-color').value = webtoonCardSettings.publishedColor || '#f7f5f0';
            document.getElementById('wcs-label-color1').value = webtoonCardSettings.labelColor1 || '#64748b';
            document.getElementById('wcs-label-color2').value = webtoonCardSettings.labelColor2 || '#64748b';
            const vc = webtoonCardSettings.valueColors || {};
            ['studio', 'contract', 'rsrate', 'mg', 'charguide', 'cashsheet', 'ep1conti', 'illustrator'].forEach(f => {
                document.getElementById('wcs-value-' + f).value = vc[f] || '#1e293b';
            });
            updatePenBarStyleButtonsUI();
            renderPenColorSettingsList();
            renderWebtoonSettingsPreview();
            document.getElementById('webtoon-card-settings-modal').classList.add('open');
        }
        function closeWebtoonCardSettings() {
            document.getElementById('webtoon-card-settings-modal').classList.remove('open');
        }
        function updateWebtoonCardSettings() {
            webtoonCardSettings.differentiatePublished = document.getElementById('wcs-differentiate').checked;
            webtoonCardSettings.publishedColor = document.getElementById('wcs-color').value;
            webtoonCardSettings.labelColor1 = document.getElementById('wcs-label-color1').value;
            webtoonCardSettings.labelColor2 = document.getElementById('wcs-label-color2').value;
            if (!webtoonCardSettings.valueColors) webtoonCardSettings.valueColors = {};
            ['studio', 'contract', 'rsrate', 'mg', 'charguide', 'cashsheet', 'ep1conti', 'illustrator'].forEach(f => {
                webtoonCardSettings.valueColors[f] = document.getElementById('wcs-value-' + f).value;
            });
            save();
            renderWebtoonSettingsPreview();
            renderWebtoonManage();
        }
        function triggerColorPicker(id, evt) {
            const el = document.getElementById(id);
            if (!el) return;
            const target = (evt && evt.target) || (window.event && window.event.target);
            if (target) {
                const rect = target.getBoundingClientRect();
                el.style.position = 'fixed';
                el.style.left = rect.left + 'px';
                el.style.top = rect.bottom + 'px';
                el.style.zIndex = '9999';
            }
            el.click();
        }
        // 설정 모달 오른쪽의 실제 카드 모양 그대로의 미리보기 — 글자를 클릭하면 해당 색상 피커가 열림
        function renderWebtoonSettingsPreview() {
            const box = document.getElementById('wcs-card-preview');
            if (!box) return;
            const s = webtoonCardSettings;
            const barStyle = s.penBarStyle || 'rounded';
            const penBg = hexToRgba(getPenColor('필명') || '#E8CC5C', genreBadgeOpacity);
            const penDateRow = `<div class="flex items-center justify-between gap-2">
                <span style="font-size:13.5px;font-weight:500;color:#334155">필명</span>
                <div class="text-[13px] whitespace-nowrap shrink-0" style="color:#475569;font-weight:500;">2026-06-30 런칭</div>
            </div>`;
            let headerBlock;
            if (barStyle === 'full') {
                headerBlock = `<div class="mb-1 pb-1.5 -mx-4 -mt-4 px-4 pt-4 rounded-t-xl" style="background-color:${penBg}">
                    <h4 class="text-slate-700 text-[15px] truncate mb-1" style="font-weight:650">소꿉친구의 남친인데</h4>
                    ${penDateRow}
                </div>`;
            } else {
                const penRowClass = barStyle === 'square' ? '-mx-2 px-2' : '-mx-2 px-2 rounded-lg';
                headerBlock = `<h4 class="text-slate-700 text-[15px] truncate mb-1.5" style="font-weight:650">소꿉친구의 남친인데</h4>
                <div class="mb-1 py-1.5 ${penRowClass}" style="background-color:${penBg}">
                    ${penDateRow}
                </div>`;
            }
            const lbl1 = (text) => `<span onclick="triggerColorPicker('wcs-label-color1', event)" class="w-[86px] shrink-0 cursor-pointer hover:underline" style="color:${s.labelColor1}">${text}</span>`;
            const lbl2 = (text) => `<span onclick="triggerColorPicker('wcs-label-color2', event)" class="w-[86px] shrink-0 cursor-pointer hover:underline" style="color:${s.labelColor2}">${text}</span>`;
            const vc = s.valueColors || {};
            const val = (field, text) => `<span onclick="triggerColorPicker('wcs-value-${field}', event)" class="cursor-pointer hover:underline" style="color:${vc[field] || '#1e293b'}">${text}</span>`;
            box.innerHTML = `<div class="rounded-xl border border-slate-200 p-4 overflow-hidden" style="background-color:#ffffff">
                ${headerBlock}
                <div class="pt-2.5 mt-1.5 space-y-1.5 text-[13px]">
                    <div class="flex gap-2">${lbl1('웹툰 스튜디오')}${val('studio', '레진')}</div>
                    <div class="flex gap-2">${lbl1('계약일')}${val('contract', '2026-01-05')}</div>
                    <div class="flex gap-2">${lbl1('RS / 비율')}${val('rsrate', 'RS 10 (비율 70)')}</div>
                    <div class="flex gap-2">${lbl1('MG')}${val('mg', '500만원')}</div>
                </div>
                <div class="border-t border-slate-100 my-2"></div>
                <div class="space-y-1.5 text-[13px]">
                    <div class="flex gap-2">${lbl2('캐릭터 가이드')}${val('charguide', 'ㅡ')}</div>
                    <div class="flex gap-2">${lbl2('캐시트')}${val('cashsheet', 'ㅡ')}</div>
                    <div class="flex gap-2">${lbl2('1화 &amp; 콘티')}${val('ep1conti', 'ㅡ')}</div>
                    <div class="flex gap-2">${lbl2('작화가')}${val('illustrator', '송하')}</div>
                </div>
            </div>
            <p class="text-[10px] text-slate-400 mt-2 text-center">실제 카드는 등록된 작품 정보로 채워져요. 여기 글자는 예시입니다.</p>`;
        }
        function setWebtoonPenBarStyle(style) {
            webtoonCardSettings.penBarStyle = style;
            save();
            updatePenBarStyleButtonsUI();
            renderWebtoonSettingsPreview();
            renderWebtoonManage();
        }
        function updatePenBarStyleButtonsUI() {
            const style = webtoonCardSettings.penBarStyle || 'rounded';
            ['rounded', 'square', 'full'].forEach(s => {
                const btn = document.getElementById('wcs-barstyle-' + s);
                if (!btn) return;
                if (s === style) { btn.style.background = 'var(--primary)'; btn.style.color = '#fff'; }
                else { btn.style.background = '#f1f5f9'; btn.style.color = '#64748b'; }
            });
        }
        function renderPenColorSettingsList() {
            const list = document.getElementById('wcs-pen-color-list');
            if (!list) return;
            if (penNames.length === 0) {
                list.innerHTML = '<p class="text-xs text-slate-400 text-center py-3">등록된 필명이 없습니다.</p>';
                return;
            }
            list.innerHTML = penNames.map(name => {
                const color = getPenColor(name) || '#cbd5e1';
                return `<div class="flex items-center justify-between p-2 bg-slate-50 rounded-xl border border-slate-200">
                    <span class="text-sm text-slate-600 font-medium">${name}</span>
                    <input type="color" value="${color}" class="w-8 h-8 rounded-lg border border-slate-200 cursor-pointer p-0.5" oninput="updatePenColorOverride('${name}', this.value)">
                </div>`;
            }).join('');
        }
        function updatePenColorOverride(name, value) {
            penNameColorOverrides[name] = value;
            save();
            renderWebtoonSettingsPreview();
            renderWebtoonManage();
        }
        // ─────────────────────────────────────────────────────────

        // ── 작품 관리 탭 (웹툰 관리와 동일 구조, 웹툰 제외 + 장르별 보기) ──────────
        function isWorkManageTarget(w) { return !(w.genre && w.genre.includes('웹툰')); }
        // 스케줄 관리(taskSchedules)에 등록된 '표지 제안서 전달' 일정 중 가장 빠른 날짜를 가져옴 (자동 연동)
        function getCoverGuideDate(workId) {
            let found = null;
            Object.keys(taskSchedules).sort().forEach(date => {
                (taskSchedules[date] || []).forEach(t => {
                    if (t.workId === workId && t.category === '표지 제안서 전달' && !found) found = date;
                });
            });
            return found;
        }
        function workManageDateDisplayHTML(w) {
            if (isWebtoonPublished(w)) {
                return `<span style="color:#475569;font-weight:500;">${w.publishDate} 출간</span>`;
            }
            let label;
            if (w.isPending && w.pendingMonth) { label = getPendingLabel(w); }
            else if (w.isPending) { label = '출간 예정'; }
            else if (w.publishDate) { label = w.publishDate; }
            else { label = '출간 예정'; }
            return `<span style="color:#ec4899;font-weight:500;">${label}</span>`;
        }
        function setWorkManageViewFilter(mode) {
            workManageViewFilter = mode;
            save(true);
            renderWorkManage();
        }
        function setWorkManageSortMode(mode) {
            workManageSortMode = mode;
            save(true);
            renderWorkManage();
        }
        function updateWorkManageViewTabsUI() {
            const modes = { all: 'wmvf-all', published: 'wmvf-published', upcoming: 'wmvf-upcoming', genre: 'wmvf-genre' };
            Object.keys(modes).forEach(m => {
                const btn = document.getElementById(modes[m]);
                if (!btn) return;
                if (m === workManageViewFilter) { btn.style.background = 'var(--primary)'; btn.style.color = '#fff'; btn.classList.add('shadow-sm'); }
                else { btn.style.background = '#f1f5f9'; btn.style.color = '#64748b'; btn.classList.remove('shadow-sm'); }
                btn.classList.toggle('vt-off', m !== workManageViewFilter);
            });
        }
        function workManageSortRowHTML() {
            if (workManageViewFilter === 'genre') return '';
            const btnCls = (active) => `px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${active ? 'text-white shadow-sm' : 'text-slate-500 bg-slate-100 hover:bg-slate-200'}`;
            const btnStyle = (active) => active ? 'background:var(--primary)' : '';
            return `<div id="workmanage-sort-row" class="flex items-center gap-2 mb-4 px-1 flex-wrap">
                <button onclick="setWorkManageSortMode('date')" class="${btnCls(workManageSortMode === 'date')}" style="${btnStyle(workManageSortMode === 'date')}">출간일 정렬</button>
                <button onclick="setWorkManageSortMode('genre')" class="${btnCls(workManageSortMode === 'genre')}" style="${btnStyle(workManageSortMode === 'genre')}">장르 정렬</button>
            </div>`;
        }
        const WORK_GENRE_ORDER = ['BL 장편', '현로 장편', '현로 초단', 'BL 초단'];
        function sortWorkManageWorks(list) {
            if (workManageSortMode === 'genre') {
                return [...list].sort((a, b) => {
                    const ga = a.genre || '', gb = b.genre || '';
                    const ia = WORK_GENRE_ORDER.indexOf(ga), ib = WORK_GENRE_ORDER.indexOf(gb);
                    const oa = ia === -1 ? 999 : ia, ob = ib === -1 ? 999 : ib;
                    if (oa !== ob) return oa - ob;
                    if (ga !== gb) return ga.localeCompare(gb, 'ko');
                    return sortKeyDate(a).localeCompare(sortKeyDate(b));
                });
            }
            return [...list].sort((a, b) => sortKeyDate(a).localeCompare(sortKeyDate(b)));
        }
        function workManageCardHTML(w) {
            const info = workManage[w.id] || {};
            const coverGuideDate = getCoverGuideDate(w.id);
            const promotionText = info.promotion || '';
            function formatCharCount(noSpace, withSpace) {
                if (!noSpace && !withSpace) return '';
                return `(${Number(noSpace || 0).toLocaleString()}자/${Number(withSpace || 0).toLocaleString()}자)`;
            }
            let charCountText = '';
            const mainCC = formatCharCount(w.goalNoSpace, w.goalWithSpace);
            if (mainCC) charCountText = `${parseInt(w.volumes) || 1}권 ${mainCC}`;
            const extraRowsHTML = (w.extras || []).map(ex => {
                const cc = formatCharCount(ex.goalNoSpace, ex.goalWithSpace);
                const rightParts = [ex.publishDate, cc].filter(Boolean).join(' ');
                return `<div class="flex pl-3"><span class="shrink-0 mr-3" style="color:${workManageCardSettings.labelColor2}">${ex.name}</span><span style="color:${workManageCardSettings.valueColors.ep1conti}">${rightParts}</span></div>`;
            }).join('');
            const launchHref = info.launchUrl ? (info.launchUrl.startsWith('http') ? info.launchUrl : 'https://' + info.launchUrl) : '';
            const genreColor = getGenreColor(w.genre);
            const genreBg = hexToRgba(genreColor, genreBadgeOpacity);
            const penName = info.penName ? `<span style="font-size:13.5px;font-weight:500;color:#334155">${info.penName}</span>` : '<span></span>';
            const penRowBg = genreBg;
            const launchInline = info.launchPlatform
                ? `<span onclick="event.stopPropagation(); ${launchHref ? `window.open('${launchHref}', '_blank')` : ''}" class="${launchHref ? 'hover:underline cursor-pointer' : ''}" style="color:var(--primary);font-weight:500;">${info.launchPlatform}</span><span class="text-slate-300 mx-1">·</span>`
                : '';
            const bodyBg = (workManageCardSettings.differentiatePublished && isWebtoonPublished(w)) ? workManageCardSettings.publishedColor : '#ffffff';
            const barStyle = workManageCardSettings.penBarStyle || 'rounded';
            const genreLine = `<span class="text-[10px] font-bold px-2 py-0.5 rounded shrink-0 whitespace-nowrap ml-2" style="background-color:${genreBg}; color:#334155">${w.genre}</span>`;
            const penDateRow = `<div class="flex items-center justify-between gap-2">
                            ${penName}
                            <div class="text-[13px] whitespace-nowrap shrink-0">${launchInline}${workManageDateDisplayHTML(w)}</div>
                        </div>`;
            const webtoonBadge = w.hasWebtoon ? `<span class="w-[18px] h-[18px] rounded-full flex items-center justify-center text-white text-[10px] font-bold shrink-0" style="background-color:rgba(236,72,153,0.75)" title="웹툰화 됨">W</span>` : '';
            let headerBlock;
            if (barStyle === 'full') {
                headerBlock = `<div class="mb-1 pb-1.5 -mx-4 -mt-4 px-4 pt-4 rounded-t-xl" style="background-color:${penRowBg}">
                        <div class="flex items-center justify-between gap-2 mb-1">
                            <div class="flex items-center gap-1.5 min-w-0">
                                <h4 class="text-slate-700 text-[15px] truncate" style="font-weight:650" title="${w.title}">${w.title}</h4>
                                ${webtoonBadge}
                            </div>
                            ${genreLine}
                        </div>
                        ${penDateRow}
                    </div>`;
            } else {
                const rowClass = barStyle === 'square' ? '-mx-2 px-2' : '-mx-2 px-2 rounded-lg';
                headerBlock = `<div class="flex items-center justify-between gap-2 mb-1">
                        <div class="flex items-center gap-1.5 min-w-0">
                            <h4 class="text-slate-700 text-[15px] truncate" style="font-weight:650" title="${w.title}">${w.title}</h4>
                            ${webtoonBadge}
                        </div>
                        ${genreLine}
                    </div>
                    <div class="mb-1 py-1.5 ${rowClass}" style="background-color:${penRowBg}">
                        ${penDateRow}
                    </div>`;
            }
            return `<div onclick="openWorkManageModal('${w.id}')" style="background-color:#ffffff; --pen:${genreColor || '#E3D5B5'}" class="rounded-xl border border-slate-200 p-4 cursor-pointer hover:shadow-md hover:border-emerald-300 transition-all relative group overflow-hidden">
                    ${headerBlock}
                    <div style="background-color:${bodyBg}" class="-mx-4 -mb-4 px-4 pb-4 pt-2.5 mt-1.5 rounded-b-xl">
                    <div class="space-y-1.5 text-[13px]">
                        <div class="flex gap-2"><span class="w-[86px] shrink-0" style="color:${workManageCardSettings.labelColor1}">출판사</span><span style="color:${workManageCardSettings.valueColors.studio}">${(w.publisher && w.publisher !== '-') ? w.publisher : ''}</span></div>
                        <div class="flex gap-2"><span class="w-[86px] shrink-0" style="color:${workManageCardSettings.labelColor1}">계약일</span><span style="color:${workManageCardSettings.valueColors.contract}">${w.contractDate || ''}</span></div>
                        <div class="flex gap-2"><span class="w-[86px] shrink-0" style="color:${workManageCardSettings.labelColor1}">비율</span><span style="color:${workManageCardSettings.valueColors.rate}">${w.rate ? w.rate + '%' : ''}</span></div>
                        <div class="flex gap-2"><span class="w-[86px] shrink-0" style="color:${workManageCardSettings.labelColor1}">선인세</span><span style="color:${workManageCardSettings.valueColors.mg}">${w.advanceAmount ? Number(w.advanceAmount).toLocaleString() + '만원' : ''}</span></div>
                        <div class="flex gap-2"><span class="w-[86px] shrink-0" style="color:${workManageCardSettings.labelColor1}">글자수</span><span style="color:${workManageCardSettings.valueColors.charcount}">${charCountText}</span></div>
                    </div>
                    <div class="border-t border-slate-100 my-2"></div>
                    <div class="space-y-1.5 text-[13px]">
                        <div class="flex gap-2"><span class="w-[86px] shrink-0" style="color:${workManageCardSettings.labelColor2}">프로모션</span><span style="color:${workManageCardSettings.valueColors.promotion}">${promotionText}</span></div>
                        <div class="flex gap-2"><span class="w-[86px] shrink-0" style="color:${workManageCardSettings.labelColor2}">표지 제안서</span><span style="color:${workManageCardSettings.valueColors.charguide}">${coverGuideDate || ''}</span></div>
                        <div class="flex gap-2"><span class="w-[86px] shrink-0" style="color:${workManageCardSettings.labelColor2}">완고 입고일</span><span style="color:${workManageCardSettings.valueColors.cashsheet}">${w.manuscriptDate || ''}</span></div>
                    </div>
                    ${(w.extras && w.extras.length > 0) ? `
                    <div class="border-t border-slate-100 my-2"></div>
                    <div class="space-y-1.5 text-[13px]">
                        <div class="font-bold" style="color:${workManageCardSettings.labelColor2}">외전</div>
                        ${extraRowsHTML}
                    </div>` : ''}
                    </div>
                </div>`;
        }
        function renderWorkManage() {
            const container = document.getElementById('workmanage-list');
            if (!container) return;
            updateWorkManageViewTabsUI();
            const allWorks = masterWorks.filter(isWorkManageTarget);
            const totalBadge = document.getElementById('workmanage-total-count');
            if (totalBadge) totalBadge.textContent = allWorks.length;

            if (allWorks.length === 0) {
                container.innerHTML = `<div class="text-center py-20 text-slate-400">‘작품 등록’에 등록된 작품이 없습니다.</div>`;
                return;
            }

            const gridOpen = `<div class="grid gap-4" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">`;
            const gridClose = `</div>`;

            if (workManageViewFilter === 'genre') {
                const groups = {};
                allWorks.forEach(w => {
                    const genre = w.genre || '미지정';
                    if (!groups[genre]) groups[genre] = [];
                    groups[genre].push(w);
                });
                Object.keys(groups).forEach(g => { groups[g].sort((a, b) => sortKeyDate(a).localeCompare(sortKeyDate(b))); });
                const genreOrder = Object.keys(groups).sort((a, b) => {
                    const ia = WORK_GENRE_ORDER.indexOf(a), ib = WORK_GENRE_ORDER.indexOf(b);
                    if (ia !== -1 && ib !== -1) return ia - ib;
                    if (ia !== -1) return -1;
                    if (ib !== -1) return 1;
                    if (a === '미지정') return 1;
                    if (b === '미지정') return -1;
                    return a.localeCompare(b, 'ko');
                });
                container.innerHTML = genreOrder.map(genre => {
                    const cards = groups[genre].map(workManageCardHTML).join('');
                    const gColor = getGenreColor(genre);
                    return `<div class="mb-6">
                    <h4 class="text-base font-bold text-slate-500 mb-2 flex items-center gap-1.5 px-1"><i class="fa-solid fa-book" style="color:${gColor}"></i> ${genre} <span class="text-sm font-semibold text-slate-400">(${groups[genre].length})</span></h4>
                        ${gridOpen}${cards}${gridClose}
                    </div>`;
                }).join('');
                return;
            }

            let filtered = allWorks;
            if (workManageViewFilter === 'published') filtered = allWorks.filter(isWebtoonPublished);
            else if (workManageViewFilter === 'upcoming') filtered = allWorks.filter(w => !isWebtoonPublished(w));
            filtered = sortWorkManageWorks(filtered);

            const sortRow = workManageSortRowHTML();
            if (filtered.length === 0) {
                container.innerHTML = sortRow + `<div class="text-center py-20 text-slate-400">해당하는 작품이 없습니다.</div>`;
                return;
            }
            container.innerHTML = sortRow + gridOpen + filtered.map(workManageCardHTML).join('') + gridClose;
        }
        let currentWorkManageWorkId = null;
        function openWorkManageModal(workId) {
            const w = masterWorks.find(x => x.id === workId);
            if (!w) return;
            currentWorkManageWorkId = workId;
            const info = workManage[workId] || {};
            document.getElementById('wmm-modal-title').innerText = w.title;
            populatePenNameSelect();
            const penSel = document.getElementById('wmm-pen-name');
            if (penSel) penSel.value = penNames.includes(info.penName) ? info.penName : '';
            document.getElementById('wmm-publisher').value = (w.publisher && w.publisher !== '-') ? w.publisher : '';
            document.getElementById('wmm-contract-date').value = w.contractDate || '';
            document.getElementById('wmm-rate').value = w.rate || '';
            document.getElementById('wmm-launch-pending').checked = !!w.isPending;
            document.getElementById('wmm-launch-date').value = w.isPending ? '' : (w.publishDate || '');
            document.getElementById('wmm-launch-pending-month').value = w.pendingMonth || '';
            toggleWmmLaunchPending(!!w.isPending);
            document.getElementById('wmm-mg').value = w.advanceAmount || '';
            document.getElementById('wmm-goal-nospace').value = w.goalNoSpace || '';
            document.getElementById('wmm-goal-withspace').value = w.goalWithSpace || '';
            const promoPresets = ['오리발', '원픽', '단독배너', '출판사 배너', '캘린더', '묶음 시단신', '단독 시단신'];
            const promoSel = document.getElementById('wmm-promotion-select');
            const promoCustom = document.getElementById('wmm-promotion-custom');
            const promoVal = info.promotion || '';
            if (!promoVal) { promoSel.value = ''; promoCustom.classList.add('hidden'); promoCustom.value = ''; }
            else if (promoPresets.includes(promoVal)) { promoSel.value = promoVal; promoCustom.classList.add('hidden'); promoCustom.value = ''; }
            else { promoSel.value = 'custom'; promoCustom.classList.remove('hidden'); promoCustom.value = promoVal; }
            document.getElementById('wmm-coverguide-date').value = getCoverGuideDate(workId) || '';
            document.getElementById('wmm-manuscript-date').value = w.manuscriptDate || '';
            wmmExtrasDraft = (w.extras || []).map(e => ({ ...e }));
            renderWmmExtrasList();
            loadAdvDraft('wmm', w);
            const wmmPlatformPresets = ['리디', '시리즈', '카카오', '봄툰', '미스터블루', '레진'];
            const wmmPlatformSel = document.getElementById('wmm-launch-platform-select');
            const wmmPlatformCustom = document.getElementById('wmm-launch-platform-custom');
            const wmmPlatformVal = info.launchPlatform || '';
            if (!wmmPlatformVal) { wmmPlatformSel.value = ''; wmmPlatformCustom.classList.add('hidden'); wmmPlatformCustom.value = ''; }
            else if (wmmPlatformPresets.includes(wmmPlatformVal)) { wmmPlatformSel.value = wmmPlatformVal; wmmPlatformCustom.classList.add('hidden'); wmmPlatformCustom.value = ''; }
            else { wmmPlatformSel.value = 'custom'; wmmPlatformCustom.classList.remove('hidden'); wmmPlatformCustom.value = wmmPlatformVal; }
            document.getElementById('wmm-launch-url').value = info.launchUrl || '';
            document.getElementById('wmm-memo').value = info.contractMemo || '';
            document.getElementById('wmm-pdf-status').textContent = '';
            document.getElementById('wmm-pdf-input').value = '';
            currentContractFile.work = info.contractFile || '';
            refreshContractButtons('work');
            document.getElementById('work-manage-modal').classList.add('open');
        }
        // 외전 간단 편집(이름만) — 상세 편집(글자수/입고일)은 '작품 등록'의 외전 관리에서
        let wmmExtrasDraft = [];
        function renderWmmExtrasList() {
            const list = document.getElementById('wmm-extras-list');
            if (!list) return;
            if (wmmExtrasDraft.length === 0) {
                list.innerHTML = '<p class="text-xs text-slate-300 py-1">등록된 외전이 없습니다.</p>';
                return;
            }
            list.innerHTML = wmmExtrasDraft.map((ex, i) => `
                <div class="flex gap-1.5">
                    <input type="text" value="${ex.name || ''}" onchange="updateWmmExtraName(${i}, this.value)" class="flex-1 min-w-0 p-2 bg-slate-50 rounded-lg border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100">
                    <button type="button" onclick="removeWmmExtraRow(${i})" class="w-8 h-8 shrink-0 flex items-center justify-center rounded-lg bg-slate-100 hover:bg-rose-50 hover:text-rose-500 text-slate-400"><i class="fa-solid fa-xmark text-xs"></i></button>
                </div>`).join('');
        }
        function addWmmExtraRow() {
            wmmExtrasDraft.push({ id: 'extra_' + Date.now(), name: `외전 ${wmmExtrasDraft.length + 1}` });
            renderWmmExtrasList();
        }
        function updateWmmExtraName(idx, value) {
            if (wmmExtrasDraft[idx]) wmmExtrasDraft[idx].name = value;
        }
        function removeWmmExtraRow(idx) {
            wmmExtrasDraft.splice(idx, 1);
            renderWmmExtrasList();
        }
        // 선인세 입금 내역 편집 (작품 관리 'wmm' / 웹툰 관리 'wtm' 모달 공용) — 저장 버튼을 눌러야 반영된다
        const advDraft = { wmm: [], wtm: [] };
        function renderAdvList(p) {
            const list = document.getElementById(p + '-adv-list');
            if (!list) return;
            const rows = advDraft[p];
            if (rows.length === 0) {
                list.innerHTML = '<p class="text-xs text-slate-300 py-1">등록된 선인세 입금이 없습니다.</p>';
                return;
            }
            const inputCls = 'p-2 bg-slate-50 rounded-lg border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100';
            list.innerHTML = rows.map((a, i) => {
                // 예전에 옮겨온 기록처럼 날짜(일)를 모르는 건 '월'만 입력 — '일자 미정'을 누르면 날짜 입력으로 바뀐다
                const monthOnly = String(a.date || '').length === 7;
                const dateHtml = monthOnly
                    ? `<input type="month" value="${a.date}" onchange="updateAdvRow('${p}',${i},'date',this.value)" class="w-[150px] shrink-0 ${inputCls}">
                       <button type="button" onclick="advRowToDay('${p}',${i})" class="shrink-0 text-[11px] text-slate-400 hover:text-emerald-600 px-1" title="정확한 날짜 입력하기">일자 미정</button>`
                    : `<input type="date" value="${a.date || ''}" onchange="updateAdvRow('${p}',${i},'date',this.value)" class="w-[150px] shrink-0 ${inputCls}">`;
                return `<div class="flex gap-1.5 items-center">
                    ${dateHtml}
                    <div class="relative flex-1 min-w-0">
                        <input type="text" inputmode="numeric" value="${a.amount ? formatCurrency(a.amount) : ''}" placeholder="입금액"
                            onchange="updateAdvRow('${p}',${i},'amount',this.value)"
                            onblur="const d=this.value.replace(/[^0-9]/g,''); this.value = d ? formatCurrency(d) : ''"
                            class="w-full pr-7 text-right ${inputCls}">
                        <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 pointer-events-none">원</span>
                    </div>
                    <button type="button" onclick="removeAdvRow('${p}',${i})" class="w-8 h-8 shrink-0 flex items-center justify-center rounded-lg bg-slate-100 hover:bg-rose-50 hover:text-rose-500 text-slate-400"><i class="fa-solid fa-xmark text-xs"></i></button>
                </div>`;
            }).join('');
        }
        function loadAdvDraft(p, w) { advDraft[p] = getWorkAdvances(w).map(a => ({ ...a })); renderAdvList(p); }
        function addAdvRow(p) {
            const t = new Date();
            const today = `${t.getFullYear()}-${String(t.getMonth()+1).padStart(2,'0')}-${String(t.getDate()).padStart(2,'0')}`;
            advDraft[p].push({ id: 'adv_' + Date.now(), date: today, amount: 0 });
            renderAdvList(p);
        }
        function updateAdvRow(p, i, field, value) {
            const a = advDraft[p][i];
            if (!a) return;
            if (field === 'amount') a.amount = Number(String(value).replace(/[^0-9]/g, '')) || 0;
            else a.date = value;
        }
        function advRowToDay(p, i) {
            const a = advDraft[p][i];
            if (!a) return;
            a.date = a.date + '-01';
            renderAdvList(p);
        }
        function removeAdvRow(p, i) { advDraft[p].splice(i, 1); renderAdvList(p); }
        // 모달 저장 시: 날짜·금액이 다 있는 줄만 남기고, 바뀐 만큼 월별 정산 칸에 더하거나 뺀다
        function commitAdvDraft(p, w) {
            const newList = advDraft[p]
                .filter(a => a.date && (Number(a.amount) || 0) !== 0)
                .map(a => ({ id: a.id, date: a.date, amount: Number(a.amount) }))
                .sort((x, y) => x.date.localeCompare(y.date));
            applyAdvanceChange(w.id, getWorkAdvances(w), newList);
            w.advances = newList;
        }
        function handleWmmPromotionChange(select) {
            const customInput = document.getElementById('wmm-promotion-custom');
            if (select.value === 'custom') { customInput.classList.remove('hidden'); customInput.focus(); }
            else { customInput.classList.add('hidden'); customInput.value = ''; }
        }
        function handleWmmLaunchPlatformChange(select) {
            const customInput = document.getElementById('wmm-launch-platform-custom');
            if (select.value === 'custom') { customInput.classList.remove('hidden'); customInput.focus(); }
            else { customInput.classList.add('hidden'); customInput.value = ''; }
        }
        function toggleWmmLaunchPending(checked) {
            const dateInput = document.getElementById('wmm-launch-date');
            const monthInput = document.getElementById('wmm-launch-pending-month');
            if (!dateInput || !monthInput) return;
            if (checked) { dateInput.classList.add('hidden'); monthInput.classList.remove('hidden'); }
            else { dateInput.classList.remove('hidden'); monthInput.classList.add('hidden'); monthInput.value = ''; }
        }
        function closeWorkManageModal() {
            document.getElementById('work-manage-modal').classList.remove('open');
            currentWorkManageWorkId = null;
        }
        // 스케줄 관리(taskSchedules)의 '표지 제안서 전달' 일정을 바꾸면 여기도 서로 반영 (쌍방 연동)
        function setCoverGuideDate(workId, newDate) {
            let foundDate = null, foundEntry = null;
            const dates = Object.keys(taskSchedules).sort();
            for (const d of dates) {
                const entry = (taskSchedules[d] || []).find(t => t.workId === workId && t.category === '표지 제안서 전달');
                if (entry) { foundDate = d; foundEntry = entry; break; }
            }
            if (!newDate) {
                if (foundDate && foundEntry) {
                    taskSchedules[foundDate] = taskSchedules[foundDate].filter(t => t.id !== foundEntry.id);
                    if (taskSchedules[foundDate].length === 0) delete taskSchedules[foundDate];
                }
            } else if (foundEntry) {
                if (foundDate !== newDate) {
                    taskSchedules[foundDate] = taskSchedules[foundDate].filter(t => t.id !== foundEntry.id);
                    if (taskSchedules[foundDate].length === 0) delete taskSchedules[foundDate];
                    foundEntry.date = newDate;
                    if (!taskSchedules[newDate]) taskSchedules[newDate] = [];
                    taskSchedules[newDate].push(foundEntry);
                }
            } else {
                if (!taskSchedules[newDate]) taskSchedules[newDate] = [];
                taskSchedules[newDate].push({ id: 'ts_coverguide_' + Date.now(), date: newDate, workId, category: '표지 제안서 전달', memo: '', isCompleted: false });
            }
            try { if (typeof renderTaskCalendar === 'function') renderTaskCalendar(); } catch(e) {}
        }
        function saveWorkManageModal() {
            if (!currentWorkManageWorkId) return;
            const workId = currentWorkManageWorkId;
            if (!workManage[workId]) workManage[workId] = {};
            workManage[workId].penName = document.getElementById('wmm-pen-name').value;
            const wmmPlatformSelVal = document.getElementById('wmm-launch-platform-select').value;
            workManage[workId].launchPlatform = wmmPlatformSelVal === 'custom' ? document.getElementById('wmm-launch-platform-custom').value.trim() : wmmPlatformSelVal;
            workManage[workId].launchUrl = document.getElementById('wmm-launch-url').value.trim();
            workManage[workId].contractMemo = document.getElementById('wmm-memo').value;
            workManage[workId].contractFile = currentContractFile.work || '';
            const promoSelVal = document.getElementById('wmm-promotion-select').value;
            workManage[workId].promotion = promoSelVal === 'custom' ? document.getElementById('wmm-promotion-custom').value.trim() : promoSelVal;
            setCoverGuideDate(workId, document.getElementById('wmm-coverguide-date').value);
            // 아래 항목들은 '작품 등록'의 데이터를 직접 갱신 → 쌍방 연동
            const w = masterWorks.find(x => x.id === workId);
            if (w) {
                w.publisher = document.getElementById('wmm-publisher').value.trim() || '-';
                w.contractDate = document.getElementById('wmm-contract-date').value;
                w.rate = document.getElementById('wmm-rate').value ? parseFloat(document.getElementById('wmm-rate').value) : '';
                const isPending = document.getElementById('wmm-launch-pending').checked;
                w.isPending = isPending;
                w.publishDate = isPending ? '' : document.getElementById('wmm-launch-date').value;
                w.pendingMonth = isPending ? document.getElementById('wmm-launch-pending-month').value : '';
                const mgVal = document.getElementById('wmm-mg').value;
                w.advanceAmount = mgVal ? Number(mgVal) : '';
                w.goalNoSpace = parseInt(document.getElementById('wmm-goal-nospace').value) || 0;
                w.goalWithSpace = parseInt(document.getElementById('wmm-goal-withspace').value) || 0;
                const oldManuscriptDate = w.manuscriptDate;
                const newManuscriptDate = document.getElementById('wmm-manuscript-date').value;
                w.manuscriptDate = newManuscriptDate;
                if (oldManuscriptDate !== newManuscriptDate) syncManuscriptTaskSchedule(w, oldManuscriptDate, newManuscriptDate);
                w.extras = wmmExtrasDraft.filter(e => e.name && e.name.trim()).map(e => ({ ...e, name: e.name.trim() }));
                commitAdvDraft('wmm', w);
            }
            save();
            closeWorkManageModal();
            renderWorkManage();
        }
        function openWorkManageCardSettings() {
            document.getElementById('wms-differentiate').checked = !!workManageCardSettings.differentiatePublished;
            document.getElementById('wms-color').value = workManageCardSettings.publishedColor || '#f7f5f0';
            document.getElementById('wms-label-color1').value = workManageCardSettings.labelColor1 || '#64748b';
            document.getElementById('wms-label-color2').value = workManageCardSettings.labelColor2 || '#64748b';
            const vc = workManageCardSettings.valueColors || {};
            ['studio', 'contract', 'rate', 'mg', 'charcount', 'promotion', 'charguide', 'cashsheet', 'ep1conti'].forEach(f => {
                document.getElementById('wms-value-' + f).value = vc[f] || '#1e293b';
            });
            updateWorkManagePenBarStyleButtonsUI();
            renderGenreColorSettingsList();
            renderWorkManageSettingsPreview();
            document.getElementById('work-card-settings-modal').classList.add('open');
        }
        function renderGenreColorSettingsList() {
            const list = document.getElementById('wms-genre-color-list');
            if (!list) return;
            if (genreList.length === 0) {
                list.innerHTML = '<p class="text-xs text-slate-400 text-center py-3">등록된 장르가 없습니다.</p>';
                return;
            }
            list.innerHTML = genreList.map((g, idx) => `
                <div class="flex items-center justify-between p-2 bg-slate-50 rounded-xl border border-slate-200">
                    <span class="text-sm text-slate-600 font-medium">${g.name}</span>
                    <input type="color" value="${g.color || '#cbd5e1'}" class="w-8 h-8 rounded-lg border border-slate-200 cursor-pointer p-0.5" oninput="updateGenreColorFromSettings(${idx}, this.value)">
                </div>`).join('');
        }
        function updateGenreColorFromSettings(idx, value) {
            if (!genreList[idx]) return;
            genreList[idx].color = value;
            save();
            renderWorkManageSettingsPreview();
            renderWorkManage();
            try { updateUI(); } catch(e) {}
        }
        function closeWorkManageCardSettings() {
            document.getElementById('work-card-settings-modal').classList.remove('open');
        }
        function updateWorkManageCardSettings() {
            workManageCardSettings.differentiatePublished = document.getElementById('wms-differentiate').checked;
            workManageCardSettings.publishedColor = document.getElementById('wms-color').value;
            workManageCardSettings.labelColor1 = document.getElementById('wms-label-color1').value;
            workManageCardSettings.labelColor2 = document.getElementById('wms-label-color2').value;
            if (!workManageCardSettings.valueColors) workManageCardSettings.valueColors = {};
            ['studio', 'contract', 'rate', 'mg', 'charcount', 'promotion', 'charguide', 'cashsheet', 'ep1conti'].forEach(f => {
                workManageCardSettings.valueColors[f] = document.getElementById('wms-value-' + f).value;
            });
            save();
            renderWorkManageSettingsPreview();
            renderWorkManage();
        }
        function setWorkManagePenBarStyle(style) {
            workManageCardSettings.penBarStyle = style;
            save();
            updateWorkManagePenBarStyleButtonsUI();
            renderWorkManageSettingsPreview();
            renderWorkManage();
        }
        function updateWorkManagePenBarStyleButtonsUI() {
            const style = workManageCardSettings.penBarStyle || 'rounded';
            ['rounded', 'square', 'full'].forEach(s => {
                const btn = document.getElementById('wms-barstyle-' + s);
                if (!btn) return;
                if (s === style) { btn.style.background = 'var(--primary)'; btn.style.color = '#fff'; }
                else { btn.style.background = '#f1f5f9'; btn.style.color = '#64748b'; }
            });
        }
        function renderWorkManageSettingsPreview() {
            const box = document.getElementById('wms-card-preview');
            if (!box) return;
            const s = workManageCardSettings;
            const barStyle = s.penBarStyle || 'rounded';
            const genreBg = hexToRgba(getGenreColor('현로 장편') || '#F5D2D2', genreBadgeOpacity);
            const genreLine = `<span class="text-[10px] font-bold px-2 py-0.5 rounded shrink-0 whitespace-nowrap ml-2" style="background-color:${genreBg}; color:#334155">현로 장편</span>`;
            const penDateRow = `<div class="flex items-center justify-between gap-2">
                <span style="font-size:13.5px;font-weight:500;color:#334155">필명</span>
                <div class="text-[13px] whitespace-nowrap shrink-0" style="color:#475569;font-weight:500;">2026-06-30 출간</div>
            </div>`;
            let headerBlock;
            if (barStyle === 'full') {
                headerBlock = `<div class="mb-1 pb-1.5 -mx-4 -mt-4 px-4 pt-4 rounded-t-xl" style="background-color:${genreBg}">
                    <div class="flex items-center justify-between gap-2 mb-1">
                        <h4 class="text-slate-700 text-[15px] truncate" style="font-weight:650">그 남자의 계약 연애</h4>
                        ${genreLine}
                    </div>
                    ${penDateRow}
                </div>`;
            } else {
                const rowClass = barStyle === 'square' ? '-mx-2 px-2' : '-mx-2 px-2 rounded-lg';
                headerBlock = `<div class="flex items-center justify-between gap-2 mb-1">
                    <h4 class="text-slate-700 text-[15px] truncate" style="font-weight:650">그 남자의 계약 연애</h4>
                    ${genreLine}
                </div>
                <div class="mb-1 py-1.5 ${rowClass}" style="background-color:${genreBg}">
                    ${penDateRow}
                </div>`;
            }
            const lbl1 = (text) => `<span onclick="triggerColorPicker('wms-label-color1', event)" class="w-[86px] shrink-0 cursor-pointer hover:underline" style="color:${s.labelColor1}">${text}</span>`;
            const lbl2 = (text) => `<span onclick="triggerColorPicker('wms-label-color2', event)" class="w-[86px] shrink-0 cursor-pointer hover:underline" style="color:${s.labelColor2}">${text}</span>`;
            const vc = s.valueColors || {};
            const val = (field, text) => `<span onclick="triggerColorPicker('wms-value-${field}', event)" class="cursor-pointer hover:underline" style="color:${vc[field] || '#1e293b'}">${text}</span>`;
            box.innerHTML = `<div class="rounded-xl border border-slate-200 p-4 overflow-hidden" style="background-color:#ffffff">
                ${headerBlock}
                <div class="pt-2.5 mt-1.5 space-y-1.5 text-[13px]">
                    <div class="flex gap-2">${lbl1('출판사')}${val('studio', '텐믹스')}</div>
                    <div class="flex gap-2">${lbl1('계약일')}${val('contract', '2026-01-05')}</div>
                    <div class="flex gap-2">${lbl1('비율')}${val('rate', '70%')}</div>
                    <div class="flex gap-2">${lbl1('선인세')}${val('mg', '300만원')}</div>
                    <div class="flex gap-2">${lbl1('글자수')}${val('charcount', '3권 (10,000자/11,000자)')}</div>
                </div>
                <div class="border-t border-slate-100 my-2"></div>
                <div class="space-y-1.5 text-[13px]">
                    <div class="flex gap-2">${lbl2('프로모션')}${val('promotion', '원픽')}</div>
                    <div class="flex gap-2">${lbl2('표지 제안서')}${val('charguide', '2026-05-01')}</div>
                    <div class="flex gap-2">${lbl2('완고 입고일')}${val('cashsheet', '2026-06-01')}</div>
                </div>
                <div class="border-t border-slate-100 my-2"></div>
                <div class="space-y-1.5 text-[13px]">
                    <div class="font-bold" style="color:${s.labelColor2}">외전</div>
                    <div class="flex pl-3"><span class="shrink-0 mr-3 cursor-pointer hover:underline" onclick="triggerColorPicker('wms-label-color2', event)" style="color:${s.labelColor2}">외전 1</span><span onclick="triggerColorPicker('wms-value-ep1conti', event)" class="cursor-pointer hover:underline" style="color:${vc['ep1conti'] || '#1e293b'}">2026-07-01 (5,000자/5,500자)</span></div>
                </div>
            </div>
            <p class="text-[10px] text-slate-400 mt-2 text-center">실제 카드는 등록된 작품 정보로 채워져요. 여기 글자는 예시입니다.</p>`;
        }
        // ─────────────────────────────────────────────────────────

        function lblTilt(name, salt) {
            let h = 7;
            const t = String(name) + String(salt);
            for (let i = 0; i < t.length; i++) h = (h * 31 + t.charCodeAt(i)) % 100003;
            const mag = 1.2 + (h % 19) / 10;                 // 1.2 ~ 3.0도
            return ((h >> 3) & 1 ? 1 : -1) * mag;
        }
        function renderPublisherTab() {
            const listContainer = document.getElementById('publisher-status-list');
            if (currentPublisherTab === 'contacts') { renderContactsList(); return; }
            if (currentPublisherTab === 'submissions') { renderSubmissionsList(); return; }
            if (currentPublisherTab === 'webtoon-subs') { renderWebtoonSubsList(); return; }
            updatePubViewToggleUI();
            let targetList = currentPublisherTab === 'publishers' ? [...new Set(masterWorks.map(w => w.publisher))].filter(p => p && p !== '-' && p !== 'undefined' && typeof p === 'string') : [...new Set(masterWorks.map(w => w.studio))].filter(s => s && s !== '-' && s !== 'undefined' && typeof s === 'string');
            const viewMode = publisherViewMode[currentPublisherTab] || 'list';
            const orderArr = viewMode === 'card' ? publisherCardSortOrder : publisherSortOrder;
            targetList.sort((a,b) => (orderArr.indexOf(a) === -1 ? 999 : orderArr.indexOf(a)) - (orderArr.indexOf(b) === -1 ? 999 : orderArr.indexOf(b)));
            if (targetList.length === 0) { listContainer.innerHTML = `<div class="p-8 text-center text-slate-400">등록된 ${currentPublisherTab === 'publishers' ? '출판사가' : '스튜디오가'} 없습니다.</div>`; return; }
            if (viewMode === 'card') { renderPublisherCardsGrid(targetList); return; }
            let html = `<div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm"><table class="w-full text-sm text-left whitespace-nowrap"><thead class="bg-slate-50 text-slate-500 font-bold border-b border-slate-200 text-sm"><tr><th class="py-2 px-3 w-12 text-center">No.</th><th class="py-2 px-2 w-[180px]">${currentPublisherTab === 'publishers' ? '출판사' : '스튜디오'}</th>`;
            if (currentPublisherTab === 'publishers') { html += `<th class="py-2 px-2">현로 레이블</th><th class="py-2 px-2">BL 레이블</th><th class="py-2 px-2 w-28 text-center">정산일</th><th class="py-2 px-2 w-28 text-center">정산 기준</th><th class="py-2 px-2 w-28 text-center">정산 사이트</th><th class="py-2 px-2 w-20 text-center">업데이트</th><th class="py-2 px-3 min-w-[150px]">비고</th><th class="py-2 px-2 w-16 text-center">ID</th>`; } else { html += `<th class="py-2 px-2 text-center">정산일</th><th class="py-2 px-2 text-center">정산 기준</th><th class="py-2 px-2 text-center">해외</th><th class="py-2 px-3">기타</th>`; }
            html += `</tr></thead><tbody id="publisher-tbody">`;
            targetList.forEach((pub, i) => { const info = publisherData[pub] || { labelHyun: '', labelBL: '', standard: '', site: '', updateDay: '', paymentDay: '', memo: '', advance: '', overseas: '', etc: '' }; html += `<tr class="hover:bg-slate-50/50 draggable-row" draggable="true" data-publisher="${pub}"><td class="py-2 px-3 text-center text-slate-400 font-bold cursor-grab active:cursor-grabbing">${i + 1}</td><td class="py-2 px-2 font-bold text-slate-700 w-[180px]"><div class="truncate w-[180px] cursor-pointer hover:text-emerald-600 hover:underline" title="${pub}" onclick="openPublisherCard('${pub}')">${pub}</div></td>`;
                if (currentPublisherTab === 'publishers') html += `<td class="py-2 px-1"><input type="text" value="${info.labelHyun || ''}" class="w-full bg-transparent rounded-lg px-2 py-1 text-sm text-slate-700 focus:bg-white focus:ring-2 focus:ring-emerald-100 outline-none transition-all border border-transparent focus:border-slate-100" data-lbl="hyun" placeholder=" " style="--tilt:${lblTilt(pub, 'h')}deg" onchange="savePublisherDetail('${pub}', 'labelHyun', this.value)"></td><td class="py-2 px-1"><input type="text" value="${info.labelBL || ''}" class="w-full bg-transparent rounded-lg px-2 py-1 text-sm text-slate-700 focus:bg-white focus:ring-2 focus:ring-emerald-100 outline-none transition-all border border-transparent focus:border-slate-100" data-lbl="bl" placeholder=" " style="--tilt:${lblTilt(pub, 'b')}deg" onchange="savePublisherDetail('${pub}', 'labelBL', this.value)"></td><td class="py-2 px-2 text-center">${mkPubSelect(pub, 'paymentDay', [1,7,10,12,15,20,25,'말일'].map(d => ({ value: d, label: `${d}${typeof d==='number'?'일':''}` })))}</td><td class="py-2 px-2 text-center">${mkPubSelect(pub, 'standard', ['익월','익익월','익익익월'].map(v => ({ value: v, label: v })))}</td><td class="py-2 px-2 text-center"><div class="flex items-center gap-1">${mkPubSelect(pub, 'site', ['실시간','자체','웹하드','이메일','이카운트'].map(v => ({ value: v, label: v })))}<button onclick="event.stopPropagation(); openPublisherSite('${pub}')" class="shrink-0 transition-opacity hover:opacity-100" style="color:var(--primary); opacity:0.55;" title="정산 사이트 열기"><i class="fa-solid fa-heart text-xs"></i></button></div></td><td class="py-2 px-2 text-center">${mkPubSelect(pub, 'updateDay', [...Array.from({length: 30}, (_, i) => i + 1), '말일'].map(d => ({ value: d, label: `${d}${typeof d==='number'?'일':''}` })), false, true)}</td><td class="py-2 px-3"><input type="text" value="${info.memo || ''}" class="bg-transparent w-full text-sm outline-none" onchange="savePublisherDetail('${pub}', 'memo', this.value)"></td><td class="py-2 px-2 text-center"><button onclick="openCredentialsModal('${pub}')" class="text-slate-400 hover:text-emerald-500 transition-colors"><i class="fa-solid fa-key"></i></button></td>`;
                else html += `<td class="py-2 px-2"><input type="text" value="${info.paymentDay || ''}" class="w-full bg-transparent rounded-lg px-2 py-1 text-sm text-center text-slate-700 outline-none focus:bg-white focus:ring-2 focus:ring-emerald-100 transition-all border border-transparent focus:border-slate-100" onchange="savePublisherDetail('${pub}', 'paymentDay', this.value)"></td><td class="py-2 px-2"><input type="text" value="${info.standard || ''}" class="w-full bg-transparent rounded-lg px-2 py-1 text-sm text-center text-slate-700 outline-none focus:bg-white focus:ring-2 focus:ring-emerald-100 transition-all border border-transparent focus:border-slate-100" onchange="savePublisherDetail('${pub}', 'standard', this.value)"></td><td class="py-2 px-2 text-center"><button onclick="openOverseasModal('${pub}')" class="text-slate-400 hover:text-emerald-500 transition-colors flex items-center justify-center w-full h-full"><i class="fa-solid fa-globe mr-1"></i> <span class="text-xs">기록</span></button></td><td class="py-2 px-3"><input type="text" value="${info.etc || ''}" class="w-full bg-transparent rounded-lg px-2 py-1 text-sm text-slate-700 outline-none focus:bg-white focus:ring-2 focus:ring-emerald-100 transition-all border border-transparent focus:border-slate-100" onchange="savePublisherDetail('${pub}', 'etc', this.value)"></td>`;
                html += `</tr>`; }); html += `</tbody></table></div>`; listContainer.innerHTML = html; addDragEvents();
        }
        // [NEW] 출판사/스튜디오 카드로 보기
        let pubCardDragSrc = null;
        function renderPublisherCardsGrid(targetList) {
            const listContainer = document.getElementById('publisher-status-list');
            const isPub = currentPublisherTab === 'publishers';
            const cards = targetList.map((pub, i) => {
                const info = publisherData[pub] || {};
                const labelParts = [];
                if (isPub && info.labelHyun) labelParts.push(`현로 · ${info.labelHyun}`);
                if (isPub && info.labelBL) labelParts.push(`BL · ${info.labelBL}`);
                const labelText = labelParts.join('  /  ');
                const settleParts = [];
                if (info.paymentDay) settleParts.push(typeof info.paymentDay === 'number' || /^\d+$/.test(info.paymentDay) ? info.paymentDay + '일' : info.paymentDay);
                if (info.standard) settleParts.push(info.standard);
                if (isPub && info.site) settleParts.push(info.site);
                const settleText = settleParts.join(' · ');
                return `<div draggable="true" data-pub="${pub}" class="pub-card bg-white rounded-xl border border-slate-200 p-4 cursor-pointer hover:shadow-md hover:border-emerald-300 transition-all relative group"
                        ondragstart="pubCardDragStart(event,'${pub}')" ondragover="event.preventDefault()" ondrop="pubCardDrop(event,'${pub}')" ondragend="this.style.opacity='1'"
                        onclick="openPublisherCard('${pub}')">
                    <div class="flex items-start justify-between mb-2">
                        <h4 class="font-bold text-slate-700 text-base flex-1 min-w-0 truncate" title="${pub}">${pub}</h4>
                        ${isPub ? `<button onclick="event.stopPropagation(); openPublisherSite('${pub}')" class="shrink-0 ml-2" style="color:var(--primary); opacity:0.55;" title="정산 사이트 열기"><i class="fa-solid fa-heart text-xs"></i></button>` : ''}
                    </div>
                    ${labelText ? `<div class="text-[11px] text-slate-400 mb-2 truncate">${labelText}</div>` : ''}
                    ${settleText ? `<div class="text-xs text-slate-600 mb-1"><span class="text-slate-400">정산</span> · ${settleText}</div>` : ''}
                    ${isPub && info.updateDay ? `<div class="text-xs text-slate-600 mb-1"><span class="text-slate-400">업데이트</span> · ${info.updateDay}일</div>` : ''}
                    ${!isPub && info.etc ? `<div class="text-xs text-slate-600 mb-1 truncate"><span class="text-slate-400">기타</span> · ${info.etc}</div>` : ''}
                    ${isPub && info.memo ? `<div class="text-[11px] text-slate-400 mt-2 pt-2 border-t border-slate-100 truncate">${info.memo}</div>` : ''}
                </div>`;
            }).join('');
            listContainer.innerHTML = `<div id="publisher-cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">${cards}</div>`;
        }
        function pubCardDragStart(e, pub) {
            pubCardDragSrc = pub;
            e.dataTransfer.effectAllowed = 'move';
            e.currentTarget.style.opacity = '0.4';
        }
        function pubCardDrop(e, targetPub) {
            e.preventDefault(); e.stopPropagation();
            if (!pubCardDragSrc || pubCardDragSrc === targetPub) return;
            const container = document.getElementById('publisher-cards-grid');
            let order = container ? [...container.querySelectorAll('.pub-card')].map(el => el.dataset.pub) : [];
            const srcIdx = order.indexOf(pubCardDragSrc), tgtIdx = order.indexOf(targetPub);
            if (srcIdx < 0 || tgtIdx < 0) return;
            order.splice(srcIdx, 1);
            order.splice(tgtIdx, 0, pubCardDragSrc);
            publisherCardSortOrder = order;
            pubCardDragSrc = null;
            save(true);
            renderPublisherTab();
        }
        // [NEW] 출판사/스튜디오 이름 클릭 시 카드 모달
        let currentPubCardName = null;
        let currentPubCardTab = 'publishers';
        function openPublisherCard(pub) {
            currentPubCardName = pub;
            currentPubCardTab = currentPublisherTab;
            renderPublisherCard();
            document.getElementById('pub-card-modal').classList.add('open');
        }
        function closePublisherCard() { document.getElementById('pub-card-modal').classList.remove('open'); }
        function pubCardFieldChanged(field, value) {
            savePublisherDetail(currentPubCardName, field, value);
            renderPublisherTab();
        }
        function renderPublisherCard() {
            const pub = currentPubCardName;
            const info = publisherData[pub] || {};
            document.getElementById('pub-card-title').innerHTML = `<i class="fa-solid ${currentPubCardTab === 'publishers' ? 'fa-building' : 'fa-clapperboard'} text-emerald-500"></i> ${pub}`;
            const body = document.getElementById('pub-card-body');
            const textField = (label, field, val) => `<div>
                <label class="text-xs font-bold text-slate-400 ml-1 mb-1 block">${label}</label>
                <input type="text" value="${val || ''}" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100" onchange="pubCardFieldChanged('${field}', this.value)">
            </div>`;
            if (currentPubCardTab === 'publishers') {
                body.innerHTML = `<div class="grid grid-cols-2 gap-3">
                    ${textField('현로 레이블', 'labelHyun', info.labelHyun)}
                    ${textField('BL 레이블', 'labelBL', info.labelBL)}
                </div>
                <div class="grid grid-cols-4 gap-3 mt-3">
                    <div><label class="text-xs font-bold text-slate-400 ml-1 mb-1 block">정산일</label>${mkPubSelect(pub, 'paymentDay', [1,7,10,12,15,20,25,'말일'].map(d => ({ value: d, label: `${d}${typeof d==='number'?'일':''}` })), true)}</div>
                    <div><label class="text-xs font-bold text-slate-400 ml-1 mb-1 block">정산 기준</label>${mkPubSelect(pub, 'standard', ['익월','익익월','익익익월'].map(v => ({ value: v, label: v })), true)}</div>
                    <div><label class="text-xs font-bold text-slate-400 ml-1 mb-1 block">정산 사이트</label><div class="flex items-center gap-1">${mkPubSelect(pub, 'site', ['실시간','자체','웹하드','이메일','이카운트'].map(v => ({ value: v, label: v })), true)}<button onclick="openPublisherSite('${pub}')" class="shrink-0 transition-opacity hover:opacity-100" style="color:var(--primary); opacity:0.55;" title="정산 사이트 열기"><i class="fa-solid fa-heart text-xs"></i></button></div></div>
                    <div><label class="text-xs font-bold text-slate-400 ml-1 mb-1 block">업데이트</label>${mkPubSelect(pub, 'updateDay', [...Array.from({length: 30}, (_, i) => i + 1), '말일'].map(d => ({ value: d, label: `${d}${typeof d==='number'?'일':''}` })), true, true)}</div>
                </div>
                <div class="mt-3">
                    <label class="text-xs font-bold text-slate-400 ml-1 mb-1 block">비고</label>
                    <input type="text" value="${info.memo || ''}" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100" onchange="pubCardFieldChanged('memo', this.value)">
                </div>
                <div class="mt-3">
                    <label class="text-xs font-bold text-slate-400 ml-1 mb-1 block">메모</label>
                    <textarea class="w-full p-3 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100 resize-y" style="min-height:220px;" placeholder="자유롭게 기록하세요..." onchange="pubCardFieldChanged('longMemo', this.value)">${info.longMemo || ''}</textarea>
                </div>
                <div class="mt-4 p-4 bg-slate-50 rounded-xl border border-slate-200">
                    <div class="text-xs font-bold text-slate-500 mb-3 flex items-center gap-1.5"><i class="fa-solid fa-key text-slate-400"></i> 정산 사이트 정보</div>
                    <div class="space-y-2.5">
                        <div>
                            <label class="text-[11px] font-bold text-slate-400 ml-1 mb-1 block">정산 사이트 URL</label>
                            <input type="text" value="${info.siteUrl || ''}" placeholder="https://..." class="w-full p-2.5 bg-white rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100" onchange="pubCardFieldChanged('siteUrl', this.value)">
                        </div>
                        <div class="grid grid-cols-2 gap-2.5">
                            <div>
                                <label class="text-[11px] font-bold text-slate-400 ml-1 mb-1 block">아이디 (ID)</label>
                                <input type="text" value="${info.loginId || ''}" class="w-full p-2.5 bg-white rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100" onchange="pubCardFieldChanged('loginId', this.value)">
                            </div>
                            <div>
                                <label class="text-[11px] font-bold text-slate-400 ml-1 mb-1 block">비밀번호 (PW)</label>
                                <input type="text" value="${info.loginPw || ''}" class="w-full p-2.5 bg-white rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100" onchange="pubCardFieldChanged('loginPw', this.value)">
                            </div>
                        </div>
                    </div>
                </div>`;
            } else {
                body.innerHTML = `<div class="grid grid-cols-2 gap-3">
                    ${textField('정산일', 'paymentDay', info.paymentDay)}
                    ${textField('정산 기준', 'standard', info.standard)}
                </div>
                <button onclick="openOverseasModal('${pub}')" class="mt-3 w-full px-4 py-2.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-xl text-sm font-bold text-slate-600 flex items-center justify-center gap-2 transition-all"><i class="fa-solid fa-globe"></i> 해외 정산 메모</button>
                <div class="mt-3">
                    <label class="text-xs font-bold text-slate-400 ml-1 mb-1 block">기타</label>
                    <input type="text" value="${info.etc || ''}" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none focus:ring-2 focus:ring-emerald-100" onchange="pubCardFieldChanged('etc', this.value)">
                </div>`;
            }
        }
        function savePublisherDetail(pub, f, v) { if(!publisherData[pub]) publisherData[pub] = { labelHyun: '', labelBL: '', standard: '', site: '', updateDay: '', paymentDay: '', memo: '' }; publisherData[pub][f] = v; save(true); }
        // [NEW] 정산 사이트 클릭 시 저장된 URL로 바로 이동 (없으면 입력 요청)
        function openPublisherSite(pub) {
            const info = publisherData[pub] || {};
            let url = info.siteUrl || '';
            if (!url) {
                url = prompt(`"${pub}"의 정산 사이트 URL이 아직 없어요. 입력해주세요:`, 'https://');
                if (!url) return;
                url = url.trim();
                if (!url) return;
                savePublisherDetail(pub, 'siteUrl', url);
            }
            if (!/^https?:\/\//i.test(url)) url = 'https://' + url;
            // window.open()으로 열면 데스크톱 래퍼 환경에서 작은 인앱 창으로 뜨는 경우가 있어, 실제 링크 클릭처럼 처리해 외부 브라우저로 열리도록 시도
            const a = document.createElement('a');
            a.href = url; a.target = '_blank'; a.rel = 'noopener noreferrer';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }
        // [NEW] "선택" 문구 없이 빈 값으로 시작하고, 목록 맨 아래 "직접입력"으로 자유 입력이 가능한 드롭다운
        function mkPubSelect(pub, field, options, fromCard, noCustom) {
            const info = publisherData[pub] || {};
            let cur = info[field] ?? '';
            if (field === 'updateDay' && String(cur) === '31') cur = '말일'; // 31일 옵션 폐지 → 말일로 통일
            const inList = options.some(o => String(o.value) === String(cur));
            const customOpt = (cur !== '' && !inList) ? `<option value="${cur}" selected>${cur}</option>` : '';
            const optsHtml = options.map(o => `<option value="${o.value}" ${!customOpt && String(o.value)===String(cur)?'selected':''}>${o.label}</option>`).join('');
            return `<select class="no-arrow bg-transparent text-sm rounded-lg p-1.5 w-full text-center cursor-pointer ${fromCard ? 'bg-slate-50 border border-slate-200' : ''}" onchange="handlePublisherSelectChange(this, '${pub}', '${field}', ${!!fromCard})">
                <option value="" ${cur===''?'selected':''}></option>
                ${optsHtml}
                ${customOpt}
                ${noCustom ? '' : '<option value="__custom__">직접입력</option>'}
            </select>`;
        }
        function handlePublisherSelectChange(sel, pub, field, fromCard) {
            if (sel.value === '__custom__') {
                const val = prompt('직접 입력해주세요:', '');
                if (val === null) { renderPublisherTab(); if (fromCard) renderPublisherCard(); return; }
                savePublisherDetail(pub, field, val.trim());
                renderPublisherTab();
                if (fromCard) renderPublisherCard();
                return;
            }
            savePublisherDetail(pub, field, sel.value);
            if (fromCard) renderPublisherTab();
        }

        // ════════ 컨택 관리 ════════
        // contactSortMode는 이제 스크립트 상단에서 선언됨 (로딩 순서 버그 수정)
        let contactDragSrcId = null;

        // 'date'/'penName' 기준으로 contacts 배열 자체의 순서를 한 번 바꾼다 (화면에서 매번 다시 정렬하지 않음)
        function sortContactsInPlace(mode) {
            if (mode === 'date') {
                contacts.sort((a,b) => {
                    const aDate = a.contactDate || (a.createdAt ? new Date(a.createdAt).toISOString().slice(0,10) : '');
                    const bDate = b.contactDate || (b.createdAt ? new Date(b.createdAt).toISOString().slice(0,10) : '');
                    return bDate.localeCompare(aDate); // 최신순
                });
            } else if (mode === 'penName') {
                contacts.sort((a,b) => {
                    const penCmp = (a.penName || 'ㅎ').localeCompare(b.penName || 'ㅎ', 'ko');
                    if (penCmp !== 0) return penCmp;
                    const starCmp = (b.stars || 0) - (a.stars || 0); // 별 갯수 높은 순
                    if (starCmp !== 0) return starCmp;
                    return (a.publisher || '').localeCompare(b.publisher || '', 'ko'); // 그 뒤엔 출판사 이름 순
                });
            }
        }
        function setContactSort(mode) {
            contactSortMode = mode;
            sortContactsInPlace(mode); // 이 기준으로 한 번 정렬 — 이후엔 카드를 자유롭게 드래그해서 다시 순서를 바꿀 수 있음
            save(true);
            renderContactsList();
        }

        // [NEW] 필명별 카드 배경 색상 (장르 색상 재사용)
        const PEN_NAME_COLORS = {};
        function getPenColor(name) {
            if (!name) return null;
            return penNameColorOverrides[name] || PEN_NAME_COLORS[name] || null;
        }
        // 웹툰 관리 '필명 별로 보기' 그룹 헤더의 하트 아이콘 전용 색상
        const WEBTOON_PEN_HEART_COLORS = {};
        function renderContactsList() {
            const container = document.getElementById('publisher-status-list');
            // 정렬은 버튼을 누른 시점에 contacts 배열 순서 자체를 이미 바꿔놨으므로, 여기선 그 순서 그대로 보여준다.
            // (드래그로 순서를 바꿔도 이 배열 순서에 바로 반영되어 흐트러지지 않음)
            let sorted = contacts;

            const sortBtnCls = (m) => `px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${contactSortMode === m ? 'text-white shadow-sm' : 'text-slate-500 bg-slate-100 hover:bg-slate-200'}`;
            const sortBtnStyle = (m) => contactSortMode === m ? 'background:var(--primary)' : '';

            const headerRow = `<div class="flex items-center justify-between mb-4 px-1 flex-wrap gap-2">
                <div class="flex items-center gap-2">
                    <button onclick="setContactSort('date')" class="${sortBtnCls('date')}" style="${sortBtnStyle('date')}" title="이 기준으로 한 번 정렬합니다. 이후엔 카드를 드래그해서 자유롭게 순서를 바꿀 수 있어요.">날짜순</button>
                    <button onclick="setContactSort('penName')" class="${sortBtnCls('penName')}" style="${sortBtnStyle('penName')}" title="이 기준으로 한 번 정렬합니다. 이후엔 카드를 드래그해서 자유롭게 순서를 바꿀 수 있어요.">필명순</button>
                </div>
                <button onclick="openContactModal()" class="px-4 py-2 rounded-lg text-sm font-bold text-white shadow-md hover:-translate-y-0.5 transition-all flex items-center gap-2" style="background:var(--primary)"><i class="fa-solid fa-plus"></i> 컨택 추가</button>
            </div>`;

            if (sorted.length === 0) {
                container.innerHTML = headerRow + `<div class="bg-white border-2 border-dashed border-slate-200 rounded-2xl p-12 text-center">
                    <i class="fa-regular fa-envelope text-4xl text-slate-300 mb-3"></i>
                    <p class="text-sm text-slate-400">등록된 컨택이 없습니다.</p>
                    <p class="text-xs text-slate-300 mt-1">+ 컨택 추가 버튼을 눌러 첫 컨택을 기록해보세요.</p>
                </div>`;
                return;
            }
            const cards = sorted.map((c, i) => {
                // 필명순 정렬일 때만, 필명이 바뀌는 지점마다 그 필명을 라벨로 단 구분선을 카드 그리드 전체 너비로 끼워 넣는다
                let groupDivider = '';
                if (contactSortMode === 'penName' && (i === 0 || (sorted[i - 1].penName || '') !== (c.penName || ''))) {
                    groupDivider = `<div class="col-span-full flex items-center gap-3 ${i === 0 ? '' : 'mt-2'} mb-1">
                        <span class="text-xs font-bold text-slate-500 whitespace-nowrap">${c.penName || '필명 없음'}</span>
                        <div class="flex-1 h-px bg-slate-200"></div>
                    </div>`;
                }
                const showDate = c.contactDate || (c.createdAt ? new Date(c.createdAt).toISOString().slice(0,10) : '');
                const dateStr = showDate ? showDate.replace(/^\d{2}(\d{2})-/, '$1-') : '';
                const statusColors = { '대기': 'bg-slate-100 text-slate-500', '추후 연락': 'bg-amber-100 text-amber-700', '진행': 'bg-blue-100 text-blue-600', '계약': 'bg-emerald-100 text-emerald-600', '거절': 'bg-rose-50 text-rose-400' };
                const statusBadge = c.status ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded ${statusColors[c.status]||'bg-slate-100 text-slate-500'}">${c.status}</span>` : '';

                const starsCount = c.stars || 0;
                let starsHtml = '<div class="flex gap-0.5">';
                for (let i = 1; i <= 3; i++) {
                    starsHtml += `<i class="fa-solid fa-star text-[11px] ${i <= starsCount ? 'text-yellow-400' : 'text-slate-200'}"></i>`;
                }
                starsHtml += '</div>';

                const rateText = c.rate ? (String(c.rate).includes('%') ? c.rate : c.rate + '%') : '';
                const advanceText = c.advance ? `${Number(c.advance).toLocaleString()}만원` : '';
                const condParts = [];
                if (c.condBanner) condParts.push('프리미엄 배너');
                if (c.condOrifeet) condParts.push('오리발');
                if (c.condIllust) condParts.push('일러 표지');
                if (c.conditionCustom) condParts.push(c.conditionCustom);
                const condText = condParts.join(', ');
                const editParts = [];
                if (c.edit1) editParts.push('1교');
                if (c.edit2) editParts.push('2교');
                if (c.editReview) editParts.push('리뷰');
                const editText = editParts.join(' · ');
                
                const settlementParts = [];
                if (c.paymentDay) settlementParts.push(typeof c.paymentDay === 'number' || /^\d+$/.test(c.paymentDay) ? c.paymentDay + '일' : c.paymentDay);
                if (c.standard) settlementParts.push(c.standard);
                const settlementText = settlementParts.join(' · ');

                const dragAttrs = `draggable="true" ondragstart="contactDragStart(event,'${c.id}')" ondragover="event.preventDefault()" ondrop="contactDrop(event,'${c.id}')"`;

                const penColor = c.penName ? getPenColor(c.penName) : null;
                return groupDivider + `<div onclick="openContactModal('${c.id}')" ${dragAttrs} style="--ph:${penColor || '#E3D5B5'}" class="ct-card bg-white rounded-xl border border-slate-200 p-4 cursor-pointer hover:shadow-md hover:border-emerald-300 transition-all relative group">
                    <button onclick="event.stopPropagation(); deleteContact('${c.id}')" class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 text-slate-300 hover:text-rose-500 text-xs transition-all z-10" title="삭제"><i class="fa-solid fa-trash-can"></i></button>
                    <div class="ct-photo">
                    <!-- 헤더: 상태/날짜 좌, 별 우상단 -->
                    <div class="flex items-start justify-between mb-2">
                        <div class="flex items-center gap-2 flex-wrap">
                            ${statusBadge}
                            <span class="text-[10px] text-slate-400">${dateStr}</span>
                        </div>
                        <div class="ml-2 mr-5">${starsHtml}</div>
                    </div>
                    <!-- 출판사 + 필명 같은 줄 -->
                    <div class="flex items-baseline justify-between gap-2 mb-2">
                        <h4 class="font-bold text-slate-700 text-base flex-1 min-w-0" style="word-break:break-word;">${c.publisher || '미입력'}</h4>
                        ${c.penName ? (penColor ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded shrink-0 whitespace-nowrap" style="background-color:${hexToRgba(penColor, genreBadgeOpacity)}; color:#334155">${c.penName}</span>` : `<span class="text-xs text-slate-500 shrink-0 whitespace-nowrap">${c.penName}</span>`) : ''}
                    </div>
                    </div>
                    <div class="space-y-1 text-[12px] text-slate-600">
                        ${rateText ? `<div class="flex gap-2"><span class="text-slate-400 w-14 shrink-0">비율</span><span class="font-bold" style="color:#ec4899">${rateText}</span></div>` : ''}
                        ${advanceText ? `<div class="flex gap-2"><span class="text-slate-400 w-14 shrink-0">선인세</span><span class="font-medium" style="color:var(--primary)">${advanceText}</span></div>` : ''}
                        ${settlementText ? `<div class="flex gap-2"><span class="text-slate-400 w-14 shrink-0">정산</span><span>${settlementText}</span></div>` : ''}
                        ${c.site ? `<div class="flex gap-2"><span class="text-slate-400 w-14 shrink-0">사이트</span><span>${c.site}</span></div>` : ''}
                        ${condText ? `<div class="flex gap-2"><span class="text-slate-400 w-14 shrink-0">조건</span><span style="word-break:break-word;">${condText}</span></div>` : ''}
                        ${editText ? `<div class="flex gap-2"><span class="text-slate-400 w-14 shrink-0">교정</span><span>${editText}</span></div>` : ''}
                        ${c.etc ? `<div class="flex gap-2"><span class="text-slate-400 w-14 shrink-0">기타</span><span style="word-break:break-word;">${c.etc}</span></div>` : ''}
                    </div>
                    ${c.email ? `<div onclick="event.stopPropagation(); openEmailPreview('${c.id}')" class="mt-2 pt-2 border-t border-slate-100 text-[10px] text-slate-400 truncate hover:text-emerald-600 transition-colors cursor-pointer">✉️ 메일 전문 보기</div>` : ''}
                </div>`;
            }).join('');
            container.innerHTML = headerRow + `<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">${cards}</div>`;
        }

        function contactDragStart(e, id) {
            contactDragSrcId = id;
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', id);
            // 모달 열기를 막기 위해 약간 딜레이
            e.currentTarget.style.opacity = '0.4';
        }

        function contactDrop(e, targetId) {
            e.preventDefault();
            e.stopPropagation();
            if (!contactDragSrcId || contactDragSrcId === targetId) return;
            const srcIdx = contacts.findIndex(c => c.id === contactDragSrcId);
            const tgtIdx = contacts.findIndex(c => c.id === targetId);
            if (srcIdx < 0 || tgtIdx < 0) return;
            const [moved] = contacts.splice(srcIdx, 1);
            contacts.splice(tgtIdx, 0, moved);
            contactDragSrcId = null;
            save();
            renderContactsList();
        }
        // 드래그 종료 시 opacity 복원
        document.addEventListener('dragend', () => {
            document.querySelectorAll('[draggable="true"]').forEach(el => el.style.opacity = '');
        });

        let currentEditContactId = null;
        let currentContactStars = 0;

        // ════════ 필명 관리 ════════
        function openPenNameManager() {
            renderPenNameList();
            document.getElementById('penname-modal').classList.add('open');
        }
        function closePenNameManager() {
            document.getElementById('penname-modal').classList.remove('open');
            populatePenNameSelect();
        }
        function renderPenNameList() {
            const cont = document.getElementById('penname-list');
            if (penNames.length === 0) {
                cont.innerHTML = '<p class="text-xs text-slate-400 text-center py-4">등록된 필명이 없습니다.</p>';
                return;
            }
            cont.innerHTML = penNames.map((p, i) => `
                <div class="flex items-center gap-2 p-2.5 bg-slate-50 rounded-xl border border-slate-100">
                    <span class="flex-1 text-sm text-slate-700 font-medium">${p}</span>
                    <button onclick="deletePenName(${i})" class="text-slate-400 hover:text-rose-500 text-xs p-1" title="삭제"><i class="fa-solid fa-trash-can"></i></button>
                </div>
            `).join('');
        }
        function addPenName() {
            const inp = document.getElementById('new-penname-input');
            const name = inp.value.trim();
            if (!name) return;
            if (penNames.includes(name)) { alert('이미 등록된 필명입니다.'); return; }
            penNames.push(name);
            inp.value = '';
            save(); renderPenNameList();
        }
        function deletePenName(idx) {
            if (!confirm('이 필명을 삭제하시겠습니까?')) return;
            penNames.splice(idx, 1);
            save(); renderPenNameList();
        }
        function populatePenNameSelect() {
            ['contact-pen-name', 'wtm-pen-name', 'wmm-pen-name'].forEach(id => {
                const sel = document.getElementById(id);
                if (!sel) return;
                const cur = sel.value;
                sel.innerHTML = '<option value="">선택</option>' + penNames.map(p => `<option value="${p}">${p}</option>`).join('');
                if (penNames.includes(cur)) sel.value = cur;
            });
        }

        function setContactStars(n) {
            currentContactStars = (currentContactStars === n) ? n - 1 : n;
            for (let i = 1; i <= 3; i++) {
                const el = document.getElementById('contact-star-' + i);
                if (i <= currentContactStars) el.classList.replace('text-slate-300', 'text-yellow-400');
                else el.classList.replace('text-yellow-400', 'text-slate-300');
            }
        }

        function handleContactRateChange(sel) {
            const cust = document.getElementById('contact-rate-custom');
            if (sel.value === 'custom') { cust.classList.remove('hidden'); cust.focus(); }
            else cust.classList.add('hidden');
        }

        // [NEW] 컨택 모달 정산일 "직접입력" 처리
        function handleContactCustomSelect(sel) {
            if (sel.value !== '__custom__') return;
            const val = prompt('직접 입력해주세요:', '');
            if (!val || !val.trim()) { sel.value = ''; return; }
            const trimmed = val.trim();
            let opt = Array.from(sel.options).find(o => o.value === trimmed);
            if (!opt) {
                opt = document.createElement('option');
                opt.value = trimmed; opt.textContent = trimmed; opt.dataset.dynamic = 'true';
                sel.insertBefore(opt, sel.querySelector('option[value="__custom__"]'));
            }
            sel.value = trimmed;
        }
        // [NEW] 컨택 카드 - 메일 전문 미리보기 팝업
        function openEmailPreview(id) {
            const c = contacts.find(x => x.id === id);
            if (!c) return;
            const titleParts = [c.publisher || '미입력'];
            if (c.penName) titleParts.push(c.penName);
            document.getElementById('email-preview-title').innerHTML = `<i class="fa-regular fa-envelope text-emerald-500"></i> ${titleParts.join(' · ')}`;
            document.getElementById('email-preview-body').textContent = c.email || '';
            document.getElementById('email-preview-modal').classList.add('open');
        }
        function openContactModal(id = null) {
            currentEditContactId = id;
            const c = id ? contacts.find(x => x.id === id) : {};
            document.getElementById('contact-modal-title').textContent = id ? '컨택 수정' : '컨택 추가';
            document.getElementById('contact-publisher').value = c?.publisher || '';
            document.getElementById('contact-status').value = c?.status || '대기';
            document.getElementById('contact-email').value = c?.email || '';
            // 컨택 날짜 (없으면 오늘)
            const today = new Date();
            const todayStr = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;
            document.getElementById('contact-date').value = c?.contactDate || todayStr;

            // 필명 select 채우기
            populatePenNameSelect();
            const psel = document.getElementById('contact-pen-name');
            if (c?.penName && penNames.includes(c.penName)) psel.value = c.penName;
            else psel.value = '';

            // 비율
            const rateSel = document.getElementById('contact-rate-select');
            const rateCust = document.getElementById('contact-rate-custom');
            const presetRates = ['70','75','80','85','90'];
            if (c?.rate && presetRates.includes(String(c.rate))) {
                rateSel.value = c.rate; rateCust.classList.add('hidden'); rateCust.value = '';
            } else if (c?.rate) {
                rateSel.value = 'custom'; rateCust.classList.remove('hidden'); rateCust.value = c.rate;
            } else {
                rateSel.value = ''; rateCust.classList.add('hidden'); rateCust.value = '';
            }

            // 선인세
            document.getElementById('contact-advance').value = c?.advance || '';

            // 정산 정보
            const payDaySel = document.getElementById('contact-payment-day');
            Array.from(payDaySel.querySelectorAll('option[data-dynamic="true"]')).forEach(o => o.remove());
            if (c?.paymentDay && !Array.from(payDaySel.options).some(o => o.value === String(c.paymentDay))) {
                const opt = document.createElement('option');
                opt.value = c.paymentDay; opt.textContent = (typeof c.paymentDay === 'number' || /^\d+$/.test(c.paymentDay)) ? c.paymentDay + '일' : c.paymentDay;
                opt.dataset.dynamic = 'true';
                payDaySel.insertBefore(opt, payDaySel.querySelector('option[value="__custom__"]'));
            }
            payDaySel.value = c?.paymentDay || '';
            document.getElementById('contact-standard').value = c?.standard || '';
            document.getElementById('contact-site').value = c?.site || '';

            // 조건
            document.getElementById('contact-cond-banner').checked = !!c?.condBanner;
            document.getElementById('contact-cond-orifeet').checked = !!c?.condOrifeet;
            document.getElementById('contact-cond-illust').checked = !!c?.condIllust;
            document.getElementById('contact-condition-custom').value = c?.conditionCustom || '';

            // 교정
            document.getElementById('contact-edit-1').checked = !!c?.edit1;
            document.getElementById('contact-edit-2').checked = !!c?.edit2;
            document.getElementById('contact-edit-review').checked = !!c?.editReview;
            document.getElementById('contact-etc').value = c?.etc || '';

            // 별점
            currentContactStars = c?.stars || 0;
            for (let i = 1; i <= 3; i++) {
                const el = document.getElementById('contact-star-' + i);
                if (i <= currentContactStars) el.classList.replace('text-slate-300', 'text-yellow-400');
                else el.classList.replace('text-yellow-400', 'text-slate-300');
            }

            document.getElementById('contact-modal').classList.add('open');
        }
        function closeContactModal() { document.getElementById('contact-modal').classList.remove('open'); }
        function saveContact() {
            const rateSel = document.getElementById('contact-rate-select').value;
            const rate = rateSel === 'custom' ? document.getElementById('contact-rate-custom').value.trim() : (rateSel || '');

            const data = {
                publisher: document.getElementById('contact-publisher').value.trim(),
                penName: document.getElementById('contact-pen-name').value,
                contactDate: document.getElementById('contact-date').value || '',
                rate: rate,
                advance: document.getElementById('contact-advance').value.trim(),
                paymentDay: document.getElementById('contact-payment-day').value,
                standard: document.getElementById('contact-standard').value,
                site: document.getElementById('contact-site').value,
                condBanner: document.getElementById('contact-cond-banner').checked,
                condOrifeet: document.getElementById('contact-cond-orifeet').checked,
                condIllust: document.getElementById('contact-cond-illust').checked,
                conditionCustom: document.getElementById('contact-condition-custom').value.trim(),
                edit1: document.getElementById('contact-edit-1').checked,
                edit2: document.getElementById('contact-edit-2').checked,
                editReview: document.getElementById('contact-edit-review').checked,
                etc: document.getElementById('contact-etc').value.trim(),
                stars: currentContactStars,
                status: document.getElementById('contact-status').value,
                email: document.getElementById('contact-email').value
            };
            if (!data.publisher) { alert('출판사명을 입력해주세요.'); return; }

            if (currentEditContactId) {
                const idx = contacts.findIndex(c => c.id === currentEditContactId);
                if (idx > -1) { contacts[idx] = { ...contacts[idx], ...data }; }
            } else {
                contacts.push({ id: 'ct_' + Date.now(), createdAt: Date.now(), ...data });
            }

            save(); closeContactModal(); renderContactsList();
        }
        function deleteContact(id) {
            if (!confirm('이 컨택을 삭제하시겠습니까?')) return;
            contacts = contacts.filter(c => c.id !== id);
            save(); renderContactsList();
        }

        // ════════ 투고 관리 ════════
        let currentEditSubmissionId = null;
        let currentSubStars = 0;
        let subDragSrcId = null;
        let submissionSortMode = 'date';
        let submissionGenreFilter = '전체';

        function setSubmissionSort(mode) { submissionSortMode = mode; renderSubmissionsList(); }
        function setSubmissionGenreFilter(genre) { submissionGenreFilter = genre; renderSubmissionsList(); }

        function toggleSubGenre(label, name, color) {
            const cb = label.querySelector('.sub-genre-cb');
            cb.checked = !cb.checked;
            if (cb.checked) {
                label.style.background = color + '33';
                label.style.color = color;
                label.style.borderColor = color;
            } else {
                label.style.background = 'white';
                label.style.color = '#475569';
                label.style.borderColor = color + '88';
            }
        }

        function setSubStars(n) {
            currentSubStars = (currentSubStars === n) ? 0 : n;
            for (let i = 1; i <= 3; i++) {
                const el = document.getElementById('sub-star-' + i);
                if (!el) return;
                if (i <= currentSubStars) { el.classList.replace('text-slate-300', 'text-yellow-400'); }
                else { el.classList.replace('text-yellow-400', 'text-slate-300'); }
            }
        }

        function openSubmissionModal(id = null) {
            currentEditSubmissionId = id;
            const s = id ? submissions.find(x => x.id === id) : {};
            document.getElementById('submission-modal-title').textContent = id ? '투고처 수정' : '투고처 추가';
            document.getElementById('sub-studio').value = s?.studio || '';
            document.getElementById('sub-email').value = s?.email || '';
            document.getElementById('sub-website').value = s?.website || '';
            document.getElementById('sub-memo').value = s?.memo || '';

            // 장르 체크박스 채우기
            const genreBox = document.getElementById('sub-genre-checkboxes');
            const savedGenres = Array.isArray(s?.genres) ? s.genres : (s?.genre ? [s.genre] : []);
            genreBox.innerHTML = genreList.filter(g => !g.name.includes('웹툰')).map(g => {
                const checked = savedGenres.includes(g.name);
                const darkColors = { 'BL 장편': '#4a7c8e', '현로 장편': '#c0605a', '현로 초단': '#a07c2a', 'BL 초단': '#5a7a3a' };
                const color = darkColors[g.name] || '#6d28d9';
                return `<label class="flex items-center gap-1.5 cursor-pointer px-2.5 py-1 rounded-full text-xs font-bold border-2 transition-all select-none sub-genre-label" style="border-color:${checked ? color : color+'66'}; background:${checked ? color+'22' : 'white'}; color:${checked ? color : '#475569'};" onclick="toggleSubGenre(this, '${g.name}', '${color}')">
                    <input type="checkbox" class="hidden sub-genre-cb" value="${g.name}" ${checked ? 'checked' : ''}>
                    ${g.name}
                </label>`;
            }).join('');

            // 별점
            currentSubStars = s?.stars || 0;
            for (let i = 1; i <= 3; i++) {
                const el = document.getElementById('sub-star-' + i);
                if (el) {
                    if (i <= currentSubStars) { el.classList.replace('text-slate-300', 'text-yellow-400'); }
                    else { el.classList.replace('text-yellow-400', 'text-slate-300'); }
                }
            }
            document.getElementById('submission-modal').classList.add('open');
        }

        function closeSubmissionModal() { document.getElementById('submission-modal').classList.remove('open'); }

        function saveSubmission() {
            const studio = document.getElementById('sub-studio').value.trim();
            if (!studio) { alert('스튜디오명을 입력해주세요.'); return; }
            const selectedGenres = [...document.querySelectorAll('.sub-genre-cb:checked')].map(cb => cb.value);
            const data = {
                studio,
                email: document.getElementById('sub-email').value.trim(),
                website: document.getElementById('sub-website').value.trim(),
                genres: selectedGenres,
                memo: document.getElementById('sub-memo').value.trim(),
                stars: currentSubStars
            };
            if (currentEditSubmissionId) {
                const idx = submissions.findIndex(s => s.id === currentEditSubmissionId);
                if (idx > -1) submissions[idx] = { ...submissions[idx], ...data };
            } else {
                submissions.push({ id: 'sub_' + Date.now(), createdAt: Date.now(), ...data });
            }
            save(); closeSubmissionModal(); renderSubmissionsList();
        }

        function deleteSubmission(id) {
            if (!confirm('이 투고처를 삭제하시겠습니까?')) return;
            submissions = submissions.filter(s => s.id !== id);
            save(); renderSubmissionsList();
        }

        function copySubEmail(email, btn) {
            if (!email) return;
            navigator.clipboard.writeText(email).then(() => {
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-check text-emerald-500"></i>';
                setTimeout(() => { btn.innerHTML = orig; }, 1500);
            });
        }

        function subDragStart(e, id) {
            subDragSrcId = id;
            e.dataTransfer.effectAllowed = 'move';
            e.currentTarget.style.opacity = '0.4';
        }
        function subDragOver(e, el) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            el.style.outline = '2px solid var(--primary)';
            el.style.outlineOffset = '2px';
        }
        function subDragLeave(el) {
            el.style.outline = '';
            el.style.outlineOffset = '';
        }
        function subDragEnd(el) {
            el.style.opacity = '';
            el.style.outline = '';
        }
        function subDrop(e, targetId, el) {
            e.preventDefault();
            el.style.outline = '';
            el.style.outlineOffset = '';
            if (!subDragSrcId || subDragSrcId === targetId) { subDragSrcId = null; return; }
            const srcIdx = submissions.findIndex(s => s.id === subDragSrcId);
            const tgtIdx = submissions.findIndex(s => s.id === targetId);
            if (srcIdx < 0 || tgtIdx < 0) return;
            const [moved] = submissions.splice(srcIdx, 1);
            submissions.splice(tgtIdx, 0, moved);
            subDragSrcId = null;
            save(true); renderSubmissionsList();
        }

        function renderSubmissionsList() {
            const container = document.getElementById('publisher-status-list');
            // 정렬
            let sorted = [...submissions];
            if (submissionSortMode === 'name') {
                sorted.sort((a, b) => (a.studio || '').localeCompare(b.studio || '', 'ko'));
            }
            // (date / 기본은 원본 순서 유지)

            // 장르 필터 적용
            const filtered = submissionGenreFilter === '전체'
                ? sorted
                : sorted.filter(s => {
                    const genreArr = Array.isArray(s.genres) ? s.genres : (s.genre ? [s.genre] : []);
                    return genreArr.includes(submissionGenreFilter);
                });

            const genreFilterBtnCls = (g) => `px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${submissionGenreFilter === g ? 'text-white shadow-sm' : 'text-slate-500 bg-slate-100 hover:bg-slate-200'}`;
            const genreFilterBtnStyle = (g) => submissionGenreFilter === g ? 'background:var(--primary)' : '';

            const allGenres = ['전체', ...genreList.map(g => g.name).filter(n => !n.includes('웹툰'))];
            const genreFilterBtns = allGenres.map(g =>
                `<button onclick="setSubmissionGenreFilter('${g}')" class="${genreFilterBtnCls(g)}" style="${genreFilterBtnStyle(g)}">${g}</button>`
            ).join('');

            const headerRow = `<div class="flex flex-col gap-3 mb-4 px-1">
                <div class="flex items-center justify-between flex-wrap gap-2">
                    <div class="flex items-center gap-2 flex-wrap">
                        ${genreFilterBtns}
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="setSubmissionSort(submissionSortMode==='name'?'date':'name')" class="px-3 py-1.5 rounded-lg text-xs font-bold border transition-all flex items-center gap-1.5 ${submissionSortMode === 'name' ? 'text-white border-transparent' : 'text-slate-500 bg-slate-100 border-slate-200 hover:bg-slate-200'}" style="${submissionSortMode === 'name' ? 'background:var(--primary)' : ''}">
                            <i class="fa-solid fa-arrow-down-a-z"></i> ㄱㄴㄷ순
                        </button>
                        <button onclick="openSubmissionModal()" class="px-4 py-2 rounded-lg text-sm font-bold text-white shadow-md hover:-translate-y-0.5 transition-all flex items-center gap-2" style="background:var(--primary)"><i class="fa-solid fa-plus"></i> 투고처 추가</button>
                    </div>
                </div>
            </div>`;

            if (filtered.length === 0) {
                container.innerHTML = headerRow + `<div class="bg-white border-2 border-dashed border-slate-200 rounded-2xl p-12 text-center">
                    <i class="fa-solid fa-paper-plane text-4xl text-slate-300 mb-3"></i>
                    <p class="text-sm text-slate-400">해당 장르의 투고처가 없습니다.</p>
                </div>`;
                return;
            }

            const cards = filtered.map((s, idx) => {
                const darkColors = { 'BL 장편': '#4a7c8e', '현로 장편': '#c0605a', '현로 초단': '#a07c2a', 'BL 초단': '#5a7a3a' };
                const genreArr = Array.isArray(s.genres) ? s.genres : (s.genre ? [s.genre] : []);
                const genreBadges = genreArr.map(gn => {
                    const col = darkColors[gn] || '#6d28d9';
                    return `<span class="text-[10px] px-2 py-0.5 rounded-full font-medium" style="background:${col}22;color:${col}">${gn}</span>`;
                }).join('');
                const emailBtn = s.email
                    ? `<button onclick="event.stopPropagation(); copySubEmail('${s.email}', this)" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[11px] font-bold transition-all w-full mt-2" style="background:var(--primary-light);color:var(--primary);border:1px solid var(--primary-light)" title="클릭하여 복사">
                        <i class="fa-regular fa-envelope shrink-0"></i>
                        <span class="truncate">${s.email}</span>
                        <i class="fa-regular fa-copy ml-auto shrink-0 opacity-60"></i>
                      </button>` : '';
                const websiteBtn = s.website
                    ? `<a href="${s.website}" target="_blank" onclick="event.stopPropagation()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-slate-400 hover:text-slate-600 text-[11px] font-bold transition-all w-full mt-0.5">
                        <i class="fa-solid fa-arrow-up-right-from-square shrink-0"></i>
                        <span class="truncate">${s.website.replace(/^https?:\/\//, '')}</span>
                      </a>` : '';
                const dragAttrs = `draggable="true" ondragstart="subDragStart(event,'${s.id}')" ondragover="subDragOver(event,this)" ondragleave="subDragLeave(this)" ondrop="subDrop(event,'${s.id}',this)" ondragend="subDragEnd(this)"`;
                return `<div onclick="openSubmissionModal('${s.id}')" ${dragAttrs} class="ct-card bg-white rounded-xl border border-slate-200 p-4 cursor-pointer hover:shadow-md hover:border-emerald-300 transition-all relative group flex flex-col" style="height:152px; overflow:hidden;">
                    <button onclick="event.stopPropagation(); deleteSubmission('${s.id}')" class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 text-slate-300 hover:text-rose-500 text-xs transition-all z-10" title="삭제"><i class="fa-solid fa-trash-can"></i></button>
                    <div class="ct-photo">
                    <div class="flex items-start justify-between mb-2">
                        <div class="flex flex-wrap gap-1">${genreBadges}</div>
                        <span class="text-[11px] font-bold text-slate-300 ml-2 shrink-0">${idx + 1}</span>
                    </div>
                    <h4 class="font-bold text-slate-700 text-base mb-1">${s.studio || '미입력'}</h4>
                    </div>
                    ${emailBtn}
                    ${websiteBtn}
                </div>`;
            }).join('');

            container.innerHTML = headerRow + `<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4 items-start">${cards}</div>`;
        }
        // ════════════════════════════
        // ════════ 웹툰 투고 관리 ════════
        let currentWebtoonSubWorkId = null;
        let currentWebtoonSubEntryId = null;
        let currentWebtoonTabWorkId = null;

        function renderWebtoonSubsList() {
            const container = document.getElementById('publisher-status-list');
            const workIds = Object.keys(webtoonSubs);
            // webtoonSubOrder 기반 정렬 (새 항목은 끝에 추가)
            webtoonSubOrder = [...webtoonSubOrder.filter(id => workIds.includes(id)), ...workIds.filter(id => !webtoonSubOrder.includes(id))];
            const tabWorks = webtoonSubOrder.map(id => masterWorks.find(w => w.id === id)).filter(Boolean);
            const resultColors = { '대기중': 'bg-slate-100 text-slate-500', '답변대기': 'bg-amber-100 text-amber-700', '거절': 'bg-rose-50 text-rose-400', '통과': 'bg-emerald-100 text-emerald-600', '계약': 'bg-blue-100 text-blue-700' };

            // 현재 선택된 탭 유지
            if (!currentWebtoonTabWorkId && tabWorks.length > 0) currentWebtoonTabWorkId = tabWorks[0].id;
            if (!workIds.includes(currentWebtoonTabWorkId)) currentWebtoonTabWorkId = tabWorks.length > 0 ? tabWorks[0].id : null;

            const genreOrder = ['BL 장편', '현로 장편', '현로 초단', 'BL 초단'];
            // 장르별로 분류
            const grouped = {};
            const etcWorks = [];
            tabWorks.forEach(w => {
                const g = (w.genre || '').trim();
                if (genreOrder.includes(g)) {
                    if (!grouped[g]) grouped[g] = [];
                    grouped[g].push(w);
                } else {
                    etcWorks.push(w);
                }
            });

            let tabListHtml = '';
            let isFirstGroup = true;
            genreOrder.forEach(genre => {
                const works = grouped[genre];
                if (!works || works.length === 0) return;
                const gc = getGenreColor(genre);
                const bgColor = hexToRgba(gc, 0.55);
                // 배경 밝기에 따라 텍스트 색상 결정 (어두운 배경 → 흰색, 밝은 배경 → 어두운색)
                const r = parseInt(gc.slice(1,3),16), gv = parseInt(gc.slice(3,5),16), b = parseInt(gc.slice(5,7),16);
                const lum = (r*0.299 + gv*0.587 + b*0.114) / 255;
                const textColor = lum > 0.55 ? '#4a4a4a' : '#fff';
                if (!isFirstGroup) tabListHtml += `<div style="height:1px; background:rgba(0,0,0,0.07);"></div>`;
                isFirstGroup = false;
                tabListHtml += `<div class="wsub-genre-head" style="--gc:${gc}; background:${bgColor}; color:${textColor}; padding:10px 10px; font-family:'Pretendard','Apple SD Gothic Neo','Noto Sans KR',sans-serif; font-size:0.82rem; font-weight:700; letter-spacing:0.04em; text-align:center;">${genre}</div>`;
                works.forEach((w, idx) => {
                    const isActive = w.id === currentWebtoonTabWorkId;
                    const rowBg = isActive ? hexToRgba(gc, 0.13) : '';
                    tabListHtml += `<div class="flex items-center group wsub-tab-item" draggable="true" data-id="${w.id}" ondragstart="webtoonTabDragStart(event,'${w.id}')" ondragover="webtoonTabDragOver(event)" ondrop="webtoonTabDrop(event,'${w.id}')" ondragend="webtoonTabDragEnd(event)" style="--gc:${gc}; border-top:1px solid rgba(0,0,0,0.05); ${rowBg ? 'background:'+rowBg+';' : ''}">
                        <span style="font-family:'Pretendard','Apple SD Gothic Neo',sans-serif; font-size:0.78rem; font-weight:700; color:${gc}; width:1.5rem; text-align:center; flex-shrink:0; cursor:grab;">${idx+1}</span>
                        <button onclick="selectWebtoonTab('${w.id}')" class="flex-1 text-left py-2.5 transition-all truncate" style="font-family:'Pretendard','Apple SD Gothic Neo','Noto Sans KR',sans-serif; font-size:0.88rem; padding-left:2px; padding-right:4px; ${isActive ? 'font-weight:700; color:'+gc+';' : 'color:#64748b;'}">${w.title}</button>
                        <button onclick="event.stopPropagation(); removeWebtoonTab('${w.id}')" class="opacity-0 group-hover:opacity-100 text-slate-300 hover:text-rose-500 text-xs shrink-0 px-1 transition-all"><i class="fa-solid fa-xmark"></i></button>
                    </div>`;
                });
            });
            // 기타 장르
            if (etcWorks.length > 0) {
                if (!isFirstGroup) tabListHtml += `<div style="height:1px; background:rgba(0,0,0,0.07);"></div>`;
                tabListHtml += `<div class="wsub-genre-head" style="--gc:#cbd5e1; background:#e2e8f0; color:#475569; padding:10px 10px; font-family:'Pretendard','Apple SD Gothic Neo','Noto Sans KR',sans-serif; font-size:0.82rem; font-weight:700; letter-spacing:0.04em; text-align:center;">기타</div>`;
                etcWorks.forEach((w, idx) => {
                    const isActive = w.id === currentWebtoonTabWorkId;
                    tabListHtml += `<div class="flex items-center group wsub-tab-item" draggable="true" data-id="${w.id}" ondragstart="webtoonTabDragStart(event,'${w.id}')" ondragover="webtoonTabDragOver(event)" ondrop="webtoonTabDrop(event,'${w.id}')" ondragend="webtoonTabDragEnd(event)" style="--gc:#cbd5e1; border-top:1px solid rgba(0,0,0,0.05);">
                        <span style="font-family:'Pretendard',sans-serif; font-size:0.78rem; color:#94a3b8; width:1.5rem; text-align:center; flex-shrink:0;">${idx+1}</span>
                        <button onclick="selectWebtoonTab('${w.id}')" class="flex-1 text-left py-2.5 transition-all truncate" style="font-family:'Pretendard','Apple SD Gothic Neo','Noto Sans KR',sans-serif; font-size:0.88rem; padding-left:2px; ${isActive ? 'font-weight:700; color:var(--primary);' : 'color:#64748b;'}">${w.title}</button>
                        <button onclick="event.stopPropagation(); removeWebtoonTab('${w.id}')" class="opacity-0 group-hover:opacity-100 text-slate-300 hover:text-rose-500 text-xs shrink-0 px-1 transition-all"><i class="fa-solid fa-xmark"></i></button>
                    </div>`;
                });
            }

            // 오른쪽 이력 테이블
            let rightContent = '';
            if (currentWebtoonTabWorkId) {
                const w = masterWorks.find(x => x.id === currentWebtoonTabWorkId);
                const entries = webtoonSubs[currentWebtoonTabWorkId] || [];
                rightContent = `<div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-book" style="color:var(--primary)"></i>
                        <span class="font-bold text-slate-700">${w?.title || ''}</span>
                        <span class="text-xs text-slate-400">${w?.genre || ''}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="openMailContentModal('${currentWebtoonTabWorkId}')" class="px-3 rounded-lg flex items-center gap-1.5 transition-all hover:-translate-y-0.5 border" style="padding-top:0.44rem; padding-bottom:0.44rem; font-size:0.8rem; font-weight:500; color:var(--primary); border-color:var(--primary); background:var(--primary-light);"><i class="fa-solid fa-envelope text-xs"></i> 메일 내용</button>
                        <button onclick="openWebtoonSubModal('${currentWebtoonTabWorkId}')" class="px-3 rounded-lg text-white flex items-center gap-1.5 transition-all hover:-translate-y-0.5" style="background:var(--primary); padding-top:0.44rem; padding-bottom:0.44rem; font-size:0.8rem; font-weight:500;"><i class="fa-solid fa-plus"></i> 이력 추가</button>
                    </div>
                </div>`;
                if (entries.length === 0) {
                    rightContent += `<div class="text-center py-12 text-slate-400 text-sm">아직 투고 이력이 없어요.<br><span class="text-xs text-slate-300">이력 추가 버튼을 눌러 추가해보세요.</span></div>`;
                } else {
                    rightContent += `<div class="wsub-table-wrap bg-white rounded-xl border border-slate-200 overflow-x-auto">
                        <table class="w-full text-sm"><thead><tr class="bg-slate-50 text-slate-500 text-sm font-bold border-b border-slate-100">
                            <th class="px-3 py-2.5 text-center w-8">No.</th>
                            <th class="px-3 py-2.5 text-left">웹툰사</th>
                            <th class="px-3 py-2.5 text-center">투고일</th>
                            <th class="px-3 py-2.5 text-center">접수 답변일</th>
                            <th class="px-3 py-2.5 text-center">답변 예정일</th>
                            <th class="px-3 py-2.5 text-center">최종 답변일</th>
                            <th class="px-3 py-2.5 text-center">결과</th>
                            <th class="px-3 py-2.5 text-center">회신 마감일</th>
                            <th class="px-3 py-2.5 w-8"></th>
                        </tr></thead><tbody>`;
                    const sortedEntries = [...entries].sort((a, b) => {
                        const da = a.date || '9999-99-99', db = b.date || '9999-99-99';
                        return da < db ? -1 : da > db ? 1 : 0;
                    });
                    sortedEntries.forEach((e, ei) => {
                        const rc = resultColors[e.result] || 'bg-slate-100 text-slate-500';
                        const mkDate = (field, val, colorMode) => `<td class="px-2 py-2 text-center wsub-date-cell" onclick="event.stopPropagation(); wsubDateClick(event, this, '${currentWebtoonTabWorkId}','${e.id}','${field}')">
                            ${val
                                ? `<input type="date" value="${val}"
                                    class="wsub-inline-date text-[13px] text-center border border-transparent rounded-lg px-1 py-1 bg-transparent hover:bg-slate-100 hover:border-slate-200 focus:bg-white focus:border-emerald-300 focus:outline-none cursor-pointer transition-all pointer-events-none ${colorMode === 'amber' ? 'text-amber-600 font-bold' : colorMode ? 'text-emerald-600' : 'text-slate-500'}"
                                    onchange="inlineUpdateWebtoonDate('${currentWebtoonTabWorkId}','${e.id}','${field}',this.value); renderWebtoonSubsList()"
                                >`
                                : `<span class="text-slate-300 text-[13px] select-none">-</span>`
                            }
                        </td>`;
                        const mkResult = (val) => `<td class="px-3 py-2.5 text-center" onclick="event.stopPropagation()">
                            <select class="wsub-inline-result ${rc}"
                                onchange="inlineUpdateWebtoonResult('${currentWebtoonTabWorkId}','${e.id}',this)"
                            >
                                ${['답변대기','거절','통과','계약'].map(r => `<option value="${r}" ${val===r?'selected':''}>${r}</option>`).join('')}
                            </select>
                        </td>`;
                        rightContent += `<tr class="border-b border-slate-50 hover:bg-slate-50 transition-colors cursor-pointer" onclick="openWebtoonSubModal('${currentWebtoonTabWorkId}', '${e.id}')">
                            <td class="px-3 py-2.5 text-center text-slate-400 text-[13px] font-bold">${ei+1}</td>
                            <td class="px-3 py-2.5 font-medium text-slate-700 text-[13px]">${e.studio || '-'}</td>
                            ${mkDate('date', e.date, false)}
                            ${mkDate('acceptDate', e.acceptDate, false)}
                            ${mkDate('expectedDate', e.expectedDate, true)}
                            ${mkDate('replyDate', e.replyDate, false)}
                            ${mkResult(e.result)}
                            ${mkDate('myReplyDeadline', e.myReplyDeadline, 'amber')}
                            <td class="px-3 py-2.5 text-center"><button onclick="event.stopPropagation(); deleteWebtoonSubEntry('${currentWebtoonTabWorkId}','${e.id}')" class="text-slate-300 hover:text-rose-500 text-xs transition-colors"><i class="fa-solid fa-trash-can"></i></button></td>
                        </tr>`;
                    });
                    rightContent += `</tbody></table></div>`;
                }
            } else {
                rightContent = `<div class="text-center py-16 text-slate-400 text-sm">왼쪽에서 작품을 선택하거나<br>작품 추가 버튼으로 시작하세요.</div>`;
            }

            container.innerHTML = `<div class="flex gap-4 h-full" style="min-height:400px">
                <!-- 왼쪽 작품 탭 -->
                <div class="w-52 shrink-0 flex flex-col">
                    <button onclick="openWebtoonSubWorkPicker()" class="w-full mb-3 px-3 rounded-lg text-white flex items-center gap-1.5 justify-center hover:-translate-y-0.5 transition-all" style="background:var(--primary); padding-top:0.44rem; padding-bottom:0.44rem; font-size:0.8rem; font-weight:500;"><i class="fa-solid fa-plus"></i> 작품 추가</button>
                    <div class="wsub-left border border-slate-200 rounded-xl overflow-hidden" style="background:white">
                        ${tabListHtml || '<p class="text-xs text-slate-400 text-center py-4">추가된 작품 없음</p>'}
                    </div>
                </div>
                <!-- 오른쪽 이력 -->\n                <div class="flex-1 min-w-0">${rightContent}</div>
            </div>`;
        }

        let _webtoonDragSrcId = null;
        function webtoonTabDragStart(e, id) {
            _webtoonDragSrcId = id;
            e.dataTransfer.effectAllowed = 'move';
            e.currentTarget.style.opacity = '0.4';
        }
        function webtoonTabDragOver(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            e.currentTarget.style.background = 'rgba(0,0,0,0.04)';
        }
        function webtoonTabDrop(e, targetId) {
            e.preventDefault();
            e.currentTarget.style.background = '';
            if (!_webtoonDragSrcId || _webtoonDragSrcId === targetId) return;
            const from = webtoonSubOrder.indexOf(_webtoonDragSrcId);
            const to = webtoonSubOrder.indexOf(targetId);
            if (from === -1 || to === -1) return;
            webtoonSubOrder.splice(from, 1);
            webtoonSubOrder.splice(to, 0, _webtoonDragSrcId);
            save(); renderWebtoonSubsList();
        }
        function webtoonTabDragEnd(e) {
            e.currentTarget.style.opacity = '';
            document.querySelectorAll('.wsub-tab-item').forEach(el => el.style.background = '');
            _webtoonDragSrcId = null;
        }

        function selectWebtoonTab(workId) {
            currentWebtoonTabWorkId = workId;
            renderWebtoonSubsList();
        }

        function removeWebtoonTab(workId) {
            if (!confirm('이 작품의 투고 이력을 모두 삭제하시겠습니까?')) return;
            delete webtoonSubs[workId];
            webtoonSubOrder = webtoonSubOrder.filter(id => id !== workId);
            if (currentWebtoonTabWorkId === workId) currentWebtoonTabWorkId = null;
            save(); renderWebtoonSubsList();
        }

        function openWebtoonSubWorkPicker() {
            const alreadyIds = Object.keys(webtoonSubs);
            const genreOrder = ['BL 장편', '현로 장편', '현로 초단', 'BL 초단'];
            const filtered = masterWorks.filter(w => !alreadyIds.includes(w.id) && !(w.genre && w.genre.includes('웹툰')) && !w.hasWebtoon);
            filtered.sort((a, b) => {
                const ai = genreOrder.indexOf(a.genre), bi = genreOrder.indexOf(b.genre);
                return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
            });
            if (!filtered.length) { alert('추가할 수 있는 작품이 없습니다.\n(이미 모든 작품이 추가되었거나 등록된 작품이 없어요.)'); return; }

            const genres = ['전체', ...genreOrder.filter(g => filtered.some(w => w.genre === g))];
            const extraGenres = [...new Set(filtered.filter(w => !genreOrder.includes(w.genre)).map(w => w.genre || '기타'))];
            const allGenres = [...genres, ...extraGenres];

            const renderOpts = (genre) => filtered
                .filter(w => genre === '전체' || (w.genre || '기타') === genre)
                .map(w => `<option value="${w.id}">[${w.genre || '기타'}] ${w.title}</option>`).join('');

            const tabsHtml = allGenres.map((g, i) => 
                `<button onclick="wsub_filterGenre('${g}')" id="wsub-tab-${i}" class="wsub-genre-tab px-3 py-1 rounded-lg text-xs font-bold transition-all ${i===0?'text-white':'text-slate-500 bg-slate-100 hover:bg-slate-200'}" ${i===0?`style="background:var(--primary)"`:''}>${g}</button>`
            ).join('');

            const div = document.createElement('div');
            div.id = 'wsub-picker-overlay';
            div.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:9999;display:flex;align-items:center;justify-content:center;';
            div.innerHTML = `<div style="background:white;border-radius:1rem;padding:1.5rem;width:380px;box-shadow:0 20px 60px rgba(0,0,0,0.2)">
                <p class="font-bold text-slate-700 mb-3 flex items-center gap-2"><i class="fa-solid fa-book text-fuchsia-500"></i> 작품 선택</p>
                <div class="flex flex-wrap gap-1.5 mb-3">${tabsHtml}</div>
                <select id="wsub-work-picker" class="w-full p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-sm outline-none"><option value="">선택하세요</option>${renderOpts('전체')}</select>
                <div class="flex gap-2 mt-4">
                    <button onclick="document.getElementById('wsub-picker-overlay').remove()" class="flex-1 py-2.5 rounded-xl font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 text-sm">취소</button>
                    <button onclick="confirmWebtoonSubWork()" class="flex-1 py-2.5 rounded-xl font-bold text-white text-sm" style="background:var(--primary)">추가</button>
                </div>
            </div>`;
            document.body.appendChild(div);

            window.wsub_filterGenre = (genre) => {
                const primary = getComputedStyle(document.body).getPropertyValue('--primary').trim() || '#87ada1';
                document.querySelectorAll('.wsub-genre-tab').forEach(btn => {
                    btn.style.background = '';
                    btn.classList.remove('text-white');
                    btn.classList.add('text-slate-500', 'bg-slate-100');
                });
                const active = [...document.querySelectorAll('.wsub-genre-tab')].find(b => b.textContent.trim() === genre);
                if (active) { active.style.background = primary; active.classList.add('text-white'); active.classList.remove('text-slate-500', 'bg-slate-100'); }
                const sel = document.getElementById('wsub-work-picker');
                sel.innerHTML = `<option value="">선택하세요</option>${renderOpts(genre)}`;
            };
        }

        function confirmWebtoonSubWork() {
            const workId = document.getElementById('wsub-work-picker').value;
            if (!workId) { alert('작품을 선택해주세요.'); return; }
            document.getElementById('wsub-picker-overlay')?.remove();
            if (!webtoonSubs[workId]) webtoonSubs[workId] = [];
            if (!webtoonSubOrder.includes(workId)) webtoonSubOrder.push(workId);
            currentWebtoonTabWorkId = workId;
            save(); renderWebtoonSubsList();
        }

        function openWebtoonSubModal(workId, entryId = null) {
            currentWebtoonSubWorkId = workId;
            currentWebtoonSubEntryId = entryId;
            const entry = entryId ? (webtoonSubs[workId] || []).find(e => e.id === entryId) : null;
            document.getElementById('wsub-modal-title').textContent = entryId ? '투고 이력 수정' : '투고 이력 추가';
            const sortedSubs = [...submissions].sort((a, b) => (a.studio || '').localeCompare(b.studio || '', 'ko'));
            populateWsubStudioDropdown(sortedSubs, entry?.studio || '');
            const todayStr = new Date().toISOString().slice(0, 10);
            document.getElementById('wsub-date').value = entry?.date || todayStr;
            document.getElementById('wsub-accept-date').value = entry?.acceptDate || '';
            document.getElementById('wsub-expected-date').value = entry?.expectedDate || '';
            document.getElementById('wsub-reply-date').value = entry?.replyDate || '';
            document.getElementById('wsub-result').value = entry?.result || '답변대기';
            document.getElementById('wsub-my-reply-deadline').value = entry?.myReplyDeadline || '';
            document.getElementById('webtoon-sub-modal').classList.add('open');
        }

        function closeWebtoonSubModal() {
            document.getElementById('webtoon-sub-modal').classList.remove('open');
            closeWsubStudioDropdown();
        }

        // ════════ 웹툰사 커스텀 드롭다운 ════════
        function populateWsubStudioDropdown(sortedSubs, selectedValue) {
            const list = document.getElementById('wsub-studio-list');
            const hiddenInput = document.getElementById('wsub-studio');
            const label = document.getElementById('wsub-studio-label');

            // 선택 없음 항목
            const items = [{ studio: '' }, ...sortedSubs];

            list.innerHTML = items.map(s => {
                const val = s.studio || '';
                const txt = val || '선택';
                const isSelected = val === selectedValue;
                return `<div class="wsub-studio-item" data-value="${val}"
                    onclick="selectWsubStudio('${val.replace(/'/g,"\\'")}', '${txt.replace(/'/g,"\\'")}', this)"
                    style="padding:0 16px; height:38px; display:flex; align-items:center; cursor:pointer; color:${isSelected ? 'var(--primary)' : '#475569'};
                           background:${isSelected ? 'var(--primary-light)' : 'transparent'};
                           font-weight:${isSelected ? '600' : '400'};
                           transition:background 0.12s;"
                    onmouseenter="this.style.background=this.dataset.value==='${selectedValue}' ? 'var(--primary-light)' : '#f1f5f9'"
                    onmouseleave="this.style.background=this.dataset.value==='${selectedValue}' ? 'var(--primary-light)' : 'transparent'"
                    >${txt}</div>`;
            }).join('');

            hiddenInput.value = selectedValue;
            label.textContent = selectedValue || '선택';
            label.style.color = selectedValue ? '#334155' : '#94a3b8';
        }

        function toggleWsubStudioDropdown() {
            const dd = document.getElementById('wsub-studio-dropdown');
            const chevron = document.getElementById('wsub-studio-chevron');
            const isOpen = dd.style.display !== 'none';
            if (isOpen) {
                dd.style.display = 'none';
                chevron.style.transform = '';
            } else {
                dd.style.display = 'block';
                chevron.style.transform = 'rotate(180deg)';
                // 선택된 항목으로 스크롤
                const selected = dd.querySelector('.wsub-studio-item[data-value="' + document.getElementById('wsub-studio').value + '"]');
                if (selected) setTimeout(() => selected.scrollIntoView({ block: 'nearest' }), 50);
            }
        }

        function closeWsubStudioDropdown() {
            const dd = document.getElementById('wsub-studio-dropdown');
            if (dd) { dd.style.display = 'none'; }
            const chevron = document.getElementById('wsub-studio-chevron');
            if (chevron) chevron.style.transform = '';
        }

        function selectWsubStudio(value, text, el) {
            const hiddenInput = document.getElementById('wsub-studio');
            const label = document.getElementById('wsub-studio-label');
            hiddenInput.value = value;
            label.textContent = text;
            label.style.color = value ? '#334155' : '#94a3b8';
            // 하이라이트 갱신
            el.closest('#wsub-studio-list').querySelectorAll('.wsub-studio-item').forEach(item => {
                const sel = item.dataset.value === value;
                item.style.color = sel ? 'var(--primary)' : '#475569';
                item.style.background = sel ? 'var(--primary-light)' : 'transparent';
                item.style.fontWeight = sel ? '600' : '400';
            });
            closeWsubStudioDropdown();
        }

        // 드롭다운 외부 클릭 시 닫기
        document.addEventListener('click', function(e) {
            const wrapper = document.getElementById('wsub-studio-wrapper');
            if (wrapper && !wrapper.contains(e.target)) closeWsubStudioDropdown();
        });

        // ════════ 메일 내용 관리 ════════
        let currentMailWorkId = null;

        function openMailContentModal(workId) {
            currentMailWorkId = workId;
            const w = masterWorks.find(x => x.id === workId);
            document.getElementById('mail-modal-work-title').textContent = (w?.title || '') + ' — 메일 내용';
            const mailData = (webtoonSubs['__mail__'] || {})[workId] || {};
            document.getElementById('mail-subject-input').value = mailData.subject || '';
            const editor = document.getElementById('mail-body-editor');
            editor.innerHTML = mailData.body || '';
            document.getElementById('mail-content-modal').classList.add('open');
            setTimeout(() => editor.focus(), 100);
        }

        function closeMailContentModal() {
            document.getElementById('mail-content-modal').classList.remove('open');
        }

        function mailEditorExec(cmd, val) {
            document.getElementById('mail-body-editor').focus();
            document.execCommand(cmd, false, val || null);
        }

        function mailEditorInsertLink() {
            const url = prompt('링크 URL을 입력하세요:', 'https://');
            if (!url) return;
            document.getElementById('mail-body-editor').focus();
            document.execCommand('createLink', false, url);
            // 링크에 target="_blank" 자동 추가
            const links = document.getElementById('mail-body-editor').querySelectorAll('a');
            links.forEach(a => { a.target = '_blank'; a.rel = 'noopener'; });
        }

        function saveMailContent() {
            if (!currentMailWorkId) return;
            if (!webtoonSubs['__mail__']) webtoonSubs['__mail__'] = {};
            webtoonSubs['__mail__'][currentMailWorkId] = {
                subject: document.getElementById('mail-subject-input').value,
                body: document.getElementById('mail-body-editor').innerHTML
            };
            save();
            // 저장 완료 토스트
            const btn = document.querySelector('#mail-content-modal button[onclick="saveMailContent()"]');
            if (btn) {
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-check text-xs"></i> 저장됨';
                setTimeout(() => { btn.innerHTML = orig; }, 1200);
            }
        }

        function copyMailSubject() {
            const subject = document.getElementById('mail-subject-input').value;
            if (!subject) { alert('제목이 비어 있습니다.'); return; }
            navigator.clipboard.writeText(subject).then(() => {
                showMailCopyToast('제목이 복사되었습니다!');
            }).catch(() => {
                // fallback
                const ta = document.createElement('textarea');
                ta.value = subject; document.body.appendChild(ta); ta.select();
                document.execCommand('copy'); document.body.removeChild(ta);
                showMailCopyToast('제목이 복사되었습니다!');
            });
        }

        function copyMailBody() {
            const editor = document.getElementById('mail-body-editor');
            if (!editor.innerText.trim()) { alert('본문이 비어 있습니다.'); return; }
            // HTML + 텍스트 모두 클립보드에 (서식 유지)
            if (navigator.clipboard && window.ClipboardItem) {
                const blob = new Blob([editor.innerHTML], { type: 'text/html' });
                const blobText = new Blob([editor.innerText], { type: 'text/plain' });
                navigator.clipboard.write([new ClipboardItem({ 'text/html': blob, 'text/plain': blobText })])
                    .then(() => showMailCopyToast('본문이 복사되었습니다! (서식 포함)'))
                    .catch(() => {
                        navigator.clipboard.writeText(editor.innerText).then(() => showMailCopyToast('본문이 복사되었습니다!'));
                    });
            } else {
                // 구형 브라우저 fallback — 서식 포함 복사
                const range = document.createRange();
                range.selectNodeContents(editor);
                const sel = window.getSelection();
                sel.removeAllRanges(); sel.addRange(range);
                document.execCommand('copy');
                sel.removeAllRanges();
                showMailCopyToast('본문이 복사되었습니다!');
            }
        }

        function showMailCopyToast(msg) {
            let toast = document.getElementById('mail-copy-toast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'mail-copy-toast';
                toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#334155;color:white;padding:10px 22px;border-radius:12px;font-size:0.85rem;font-weight:600;z-index:99999;box-shadow:0 4px 20px rgba(0,0,0,0.18);transition:opacity 0.3s;';
                document.body.appendChild(toast);
            }
            toast.textContent = msg;
            toast.style.opacity = '1';
            clearTimeout(toast._timer);
            toast._timer = setTimeout(() => { toast.style.opacity = '0'; }, 1800);
        }

        function saveWebtoonSubEntry() {
            const studio = document.getElementById('wsub-studio').value;
            if (!studio) { alert('웹툰사를 선택해주세요.'); return; }
            const data = {
                studio,
                date: document.getElementById('wsub-date').value || '',
                acceptDate: document.getElementById('wsub-accept-date').value || '',
                expectedDate: document.getElementById('wsub-expected-date').value || '',
                replyDate: document.getElementById('wsub-reply-date').value || '',
                result: document.getElementById('wsub-result').value,
                myReplyDeadline: document.getElementById('wsub-my-reply-deadline').value || ''
            };
            if (!webtoonSubs[currentWebtoonSubWorkId]) webtoonSubs[currentWebtoonSubWorkId] = [];
            if (currentWebtoonSubEntryId) {
                const idx = webtoonSubs[currentWebtoonSubWorkId].findIndex(e => e.id === currentWebtoonSubEntryId);
                if (idx > -1) webtoonSubs[currentWebtoonSubWorkId][idx] = { ...webtoonSubs[currentWebtoonSubWorkId][idx], ...data };
            } else {
                webtoonSubs[currentWebtoonSubWorkId].push({ id: 'ws_' + Date.now(), ...data });
            }
            save(); closeWebtoonSubModal(); renderWebtoonSubsList();
        }

        function wsubDateClick(event, td, workId, entryId, field) {
            event.stopPropagation();
            const input = td.querySelector('input[type="date"]');
            if (input) {
                try { input.showPicker(); } catch(e) { input.focus(); }
                return;
            }
            // 날짜 없는 경우 → input 생성 후 피커 열기
            const newInput = document.createElement('input');
            newInput.type = 'date';
            newInput.className = 'wsub-inline-date text-xs text-slate-500 text-center border border-emerald-300 rounded-lg px-1 py-1 bg-white focus:outline-none cursor-pointer transition-all';
            newInput.onchange = () => {
                inlineUpdateWebtoonDate(workId, entryId, field, newInput.value);
                renderWebtoonSubsList();
            };
            newInput.onblur = () => { if (!newInput.value) renderWebtoonSubsList(); };
            td.innerHTML = '';
            td.appendChild(newInput);
            setTimeout(() => { try { newInput.showPicker(); } catch(e) { newInput.focus(); } }, 30);
        }

        function showWebtoonDateInput(spanEl, workId, entryId, field) {
            wsubDateClick(new Event('click'), spanEl.parentElement, workId, entryId, field);
        }

        function inlineUpdateWebtoonDate(workId, entryId, field, value) {
            if (!webtoonSubs[workId]) return;
            const idx = webtoonSubs[workId].findIndex(e => e.id === entryId);
            if (idx === -1) return;
            webtoonSubs[workId][idx][field] = value;
            save();
        }

        const _wsub_resultColors = { '대기중': 'bg-slate-100 text-slate-500', '답변대기': 'bg-slate-200 text-slate-600', '거절': 'bg-rose-50 text-rose-400', '통과': 'bg-emerald-100 text-emerald-600', '계약': 'bg-blue-100 text-blue-700' };
        function inlineUpdateWebtoonResult(workId, entryId, selectEl) {
            if (!webtoonSubs[workId]) return;
            const idx = webtoonSubs[workId].findIndex(e => e.id === entryId);
            if (idx === -1) return;
            const val = selectEl.value;
            webtoonSubs[workId][idx].result = val;
            save();
            // 색상 즉시 반영
            const rc = _wsub_resultColors[val] || 'bg-slate-100 text-slate-500';
            selectEl.className = `wsub-inline-result ${rc}`;
        }

        function deleteWebtoonSubEntry(workId, entryId) {
            if (!confirm('이 이력을 삭제하시겠습니까?')) return;
            if (webtoonSubs[workId]) {
                webtoonSubs[workId] = webtoonSubs[workId].filter(e => e.id !== entryId);
            }
            save(); renderWebtoonSubsList();
        }

        function addDragEvents() { document.querySelectorAll('.draggable-row').forEach(row => { row.addEventListener('dragstart', e => { dragSrcEl = row; row.classList.add('dragging'); }); row.addEventListener('dragover', e => e.preventDefault()); row.addEventListener('drop', e => { if (dragSrcEl !== row) { const tbody = document.getElementById('publisher-tbody'), allRows = [...tbody.querySelectorAll('.draggable-row')]; if (allRows.indexOf(dragSrcEl) < allRows.indexOf(row)) row.after(dragSrcEl); else row.before(dragSrcEl); publisherSortOrder = [...tbody.querySelectorAll('.draggable-row')].map(r => r.dataset.publisher); save(true); renderPublisherTab(); } }); row.addEventListener('dragend', () => row.classList.remove('dragging')); }); }
        function openOverseasModal(pubName) { currentEditingPublisher = pubName; const info = publisherData[pubName] || {}; document.getElementById('overseas-memo-area').value = info.overseas || ''; document.getElementById('overseas-modal').classList.add('open'); }
        function saveOverseasMemo() { if (currentEditingPublisher) { savePublisherDetail(currentEditingPublisher, 'overseas', document.getElementById('overseas-memo-area').value); document.getElementById('overseas-modal').classList.remove('open'); } }
        function openCredentialsModal(pubName) { currentEditingPublisher = pubName; const info = publisherData[pubName] || {}; document.getElementById('cred-site-url').value = info.siteUrl || ''; document.getElementById('cred-login-id').value = info.loginId || ''; document.getElementById('cred-login-pw').value = info.loginPw || ''; document.getElementById('credentials-modal').classList.add('open'); }
        function saveCredentials() { if (currentEditingPublisher) { if(!publisherData[currentEditingPublisher]) publisherData[currentEditingPublisher] = {}; publisherData[currentEditingPublisher].siteUrl = document.getElementById('cred-site-url').value; publisherData[currentEditingPublisher].loginId = document.getElementById('cred-login-id').value; publisherData[currentEditingPublisher].loginPw = document.getElementById('cred-login-pw').value; save(true); document.getElementById('credentials-modal').classList.remove('open'); } }
        // ════════ 선인세 입금 내역 ════════
        // 작품마다 w.advances = [{ id, date: 'YYYY-MM-DD'(또는 날짜 모를 때 'YYYY-MM'), amount: 실제 입금액(원) }]
        // 선인세도 그 달 월별 정산 칸(monthlyData)에 금액이 더해져 있다 — 그래야 대시보드·세금·연말 결산·가계부 등
        // monthlyData를 읽는 기존 합계가 전부 그대로 맞는다. 이 목록은 '그 칸 중 얼마가 선인세이고 며칠에 들어왔는지'를
        // 알려주는 원본이라, 목록을 바꾸면 applyAdvanceChange()가 달라진 만큼만 칸에 더하거나 뺀다.
        function getWorkAdvances(w) { return (w && Array.isArray(w.advances)) ? w.advances : []; }
        function advanceMonthSums(list) {
            const sums = {};
            (list || []).forEach(a => {
                const ym = String(a.date || '').slice(0, 7), amt = Number(a.amount) || 0;
                if (ym.length === 7 && amt) sums[ym] = (sums[ym] || 0) + amt;
            });
            return sums;
        }
        function applyAdvanceChange(workId, oldList, newList) {
            const o = advanceMonthSums(oldList), n = advanceMonthSums(newList);
            new Set([...Object.keys(o), ...Object.keys(n)]).forEach(ym => {
                const delta = (n[ym] || 0) - (o[ym] || 0);
                if (!delta) return;
                if (!monthlyData[ym]) monthlyData[ym] = {};
                monthlyData[ym][workId] = (Number(monthlyData[ym][workId]) || 0) + delta;
            });
        }
        // 한 달치 정산을 '입금 건' 단위로 나눈다: 인세는 출판사 정산일에, 선인세는 실제로 들어온 날짜에.
        // publisher는 표시·묶음용 이름 (선인세는 '출판사 선인세'로 따로 묶인다)
        function getSettlementEntries(monthKey) {
            const data = monthlyData[monthKey] || {};
            const out = [];
            Object.entries(data).forEach(([workId, amount]) => {
                amount = Number(amount) || 0;
                if (!amount) return;
                const w = masterWorks.find(x => x.id === workId);
                if (!w) return;
                const pub = w.settlementPublisher || w.publisher;
                let rest = amount;
                getWorkAdvances(w).forEach(a => {
                    if (String(a.date || '').slice(0, 7) !== monthKey) return;
                    const amt = Number(a.amount) || 0;
                    if (!amt) return;
                    const dd = String(a.date).slice(8, 10);
                    out.push({ w, publisher: pub + ' 선인세', isAdv: true, day: dd ? String(Number(dd)) : '미정', amount: amt });
                    rest -= amt;
                });
                if (rest) out.push({ w, publisher: pub, isAdv: false, day: (publisherData[pub] || {}).paymentDay || '미정', amount: rest });
            });
            return out;
        }

        // 정산 입금일 목록의 출판사 이름 — 선인세 건은 '출판사 [선인세]'처럼 테마색 배지로 표시
        function settlePubLabelHtml(key, isAdv) {
            if (!isAdv) return key;
            return `${key.replace(/ 선인세$/, '')} <span class="text-[10px] font-bold px-1.5 py-0.5 rounded ml-0.5" style="color:var(--primary);background:color-mix(in srgb, var(--primary) 12%, transparent)">선인세</span>`;
        }
        // 특정 연-월의 '정산일별' 카드 HTML과 합계를 만드는 공용 함수 (월 상세 모달 / 연간 전체보기 모달에서 공유)
        function buildDaySettlementCards(year, month, opts) {
            opts = opts || {};
            const compact = !!opts.compact;
            const monthKey = `${year}-${String(month).padStart(2,'0')}`;
            const dayMap = {};
            let totalSum = 0;
            getSettlementEntries(monthKey).forEach(e => {
                if (!dayMap[e.day]) dayMap[e.day] = [];
                dayMap[e.day].push({ publisher: e.publisher, isAdv: e.isAdv, title: e.w.title, genre: e.w.genre || '', amount: e.amount });
                totalSum += e.amount;
            });
            const sortedDays = Object.keys(dayMap).sort((a, b) => {
                const va = a === '말일' ? 999 : a === '미정' ? 9999 : Number(a);
                const vb = b === '말일' ? 999 : b === '미정' ? 9999 : Number(b);
                return va - vb;
            });
            const pubTextCls = compact ? 'text-xs' : 'text-sm';
            const dividerCls = compact ? '' : 'border-b border-slate-50 last:border-0';
            const dayTotalCls = compact ? 'text-sm' : '';
            let html = '';
            if (sortedDays.length > 0) {
                html = sortedDays.map(day => {
                    const label = (day === '말일' || day === '미정') ? day : day + '일';
                    const items = dayMap[day];
                    const pubMap = {};
                    items.forEach(item => {
                        if (!pubMap[item.publisher]) pubMap[item.publisher] = 0;
                        pubMap[item.publisher] += item.amount;
                    });
                    const dayTotal = Object.values(pubMap).reduce((s, v) => s + v, 0);
                    const advKeys = new Set(items.filter(it => it.isAdv).map(it => it.publisher));
                    const pubRows = Object.entries(pubMap)
                        .sort((a, b) => b[1] - a[1])
                        .map(([pub, amt]) => {
                            const isAdv = advKeys.has(pub);
                            const pubLabel = settlePubLabelHtml(pub, isAdv);
                            const amtStyle = isAdv ? 'style="color:var(--primary)"' : '';
                            if (compact) return `
                            <div class="flex justify-between items-center py-2 ${dividerCls}">
                                <span class="${pubTextCls} text-slate-600 font-medium">${pubLabel}</span>
                                <span class="${pubTextCls} font-bold text-slate-700" ${amtStyle}>₩ ${formatCurrency(amt)}</span>
                            </div>`;
                            // 월 상세 모달: 출판사 줄을 누르면 그 출판사 작품별 금액이 바로 아래에 펼쳐진다
                            // 장르(앱의 장르 목록 순서)별로 묶고, 같은 장르 안에서는 제목 ㄱㄴㄷ 순
                            const genreIdx = g => { const i = genreList.findIndex(x => x.name === g); return i < 0 ? 999 : i; };
                            const workRows = items.filter(it => it.publisher === pub)
                                .sort((a, b) => (genreIdx(a.genre) - genreIdx(b.genre)) || a.title.localeCompare(b.title, 'ko'))
                                .map(it => {
                                    const gc = getGenreColor(it.genre);
                                    const badge = it.genre ? `<span class="text-[10px] font-bold px-1.5 py-0.5 rounded shrink-0 whitespace-nowrap" style="background-color:${hexToRgba(gc, genreBadgeOpacity)};color:#334155">${it.genre}</span>` : '';
                                    // 노트 줄처럼 아주 연한 구분선 (마지막 줄은 없음)
                                    return `<div class="flex justify-between items-center gap-3 py-1.5 border-b border-slate-100 last:border-b-0">
                                        <span class="flex items-center gap-2 min-w-0 text-[13px] text-slate-600">${badge}<span class="truncate" title="${it.title}">${it.title}</span></span>
                                        <span class="text-[13px] text-slate-500 shrink-0" ${amtStyle}>₩ ${formatCurrency(it.amount)}</span>
                                    </div>`;
                                }).join('');
                            return `
                            <div class="${dividerCls}">
                                <div onclick="toggleSettleWorks(this)" class="flex justify-between items-center py-2 cursor-pointer select-none group">
                                    <span class="${pubTextCls} text-slate-600 font-medium flex items-center gap-2"><i class="fa-solid fa-chevron-right text-[9px] text-slate-300 group-hover:text-slate-500 transition-transform settle-chevron"></i>${pubLabel}</span>
                                    <span class="${pubTextCls} font-bold text-slate-700" ${amtStyle}>₩ ${formatCurrency(amt)}</span>
                                </div>
                                <div class="settle-works hidden pl-5 pb-2 mb-1 border-l-2 border-slate-100 ml-1">${workRows}</div>
                            </div>`;
                        }).join('');
                    return `
                        <div class="bg-slate-50 rounded-xl p-4">
                            <div class="flex justify-between items-center mb-3">
                                <div class="flex items-center gap-2">
                                    <span class="w-12 h-8 bg-rose-50 text-rose-500 rounded-lg flex items-center justify-center text-xs font-black border border-rose-100">${label}</span>
                                    <span class="text-xs text-slate-400 font-medium">${Object.keys(pubMap).length}건</span>
                                </div>
                                <span class="font-black text-slate-700 ${dayTotalCls}">₩ ${formatCurrency(dayTotal)}</span>
                            </div>
                            <div class="bg-white rounded-lg px-3">${pubRows}</div>
                        </div>`;
                }).join('');
            }
            return { html, totalSum, hasData: sortedDays.length > 0 };
        }
        function openMonthDetail(year, month) {
            document.getElementById('month-detail-title').textContent = `${year}년 ${month}월 정산 내역`;
            const { html, totalSum, hasData } = buildDaySettlementCards(year, month);
            document.getElementById('month-detail-body').innerHTML = hasData ? html : '<p class="text-center text-slate-400 text-sm py-8">정산 내역이 없습니다.</p>';
            document.getElementById('month-detail-total').textContent = `₩ ${formatCurrency(totalSum)}`;
            document.getElementById('month-detail-modal').classList.add('open');
        }
        function closeMonthDetail() {
            document.getElementById('month-detail-modal').classList.remove('open');
        }
        function toggleSettleWorks(row) {
            const list = row.nextElementSibling;
            if (!list) return;
            const open = list.classList.toggle('hidden') === false;
            const chev = row.querySelector('.settle-chevron');
            if (chev) chev.style.transform = open ? 'rotate(90deg)' : '';
        }
        // 한 달치 '정산일별' 원시 데이터를 만든다 (연간 전체보기의 표 형태 렌더링용)
        function getMonthDayData(year, month) {
            const monthKey = `${year}-${String(month).padStart(2,'0')}`;
            const dayMap = {};
            let totalSum = 0;
            getSettlementEntries(monthKey).forEach(e => {
                if (!dayMap[e.day]) dayMap[e.day] = { total: 0, pubMap: {}, advKeys: new Set() };
                dayMap[e.day].total += e.amount;
                dayMap[e.day].pubMap[e.publisher] = (dayMap[e.day].pubMap[e.publisher] || 0) + e.amount;
                if (e.isAdv) dayMap[e.day].advKeys.add(e.publisher);
                totalSum += e.amount;
            });
            return { totalSum, dayMap };
        }
        function sortDayKeys(keys) {
            return keys.sort((a, b) => {
                const va = a === '말일' ? 999 : a === '미정' ? 9999 : Number(a);
                const vb = b === '말일' ? 999 : b === '미정' ? 9999 : Number(b);
                return va - vb;
            });
        }
        // 월 묶음(6개월) 하나를 '날짜별 표'로 렌더링한다. 날짜를 실제 grid row로 만들어서
        // 같은 날짜 칸은 6개월 전체에서 자동으로 높이가 똑같이 맞춰지고(가장 내용 많은 달 기준),
        // 회색 박스 대신 위쪽 구분선(border-top)으로만 날짜 구간을 나눈다.
        function buildMonthGroupTable(year, months) {
            const monthData = months.map(m => getMonthDayData(year, m));
            const allDayKeys = new Set();
            monthData.forEach(md => Object.keys(md.dayMap).forEach(k => allDayKeys.add(k)));
            const dayKeys = sortDayKeys([...allDayKeys]);
            const n = months.length;
            const hasAnyDay = dayKeys.length > 0;
            const CARD_BORDER = '#e2e8f0';   // 카드 테두리(진함) - slate-200
            const DIVIDER = '#f1f5f9';       // 날짜 구분선(연함) - slate-100

            // 헤더 행: 월 + 월 합계 (카드의 위쪽 캡 - 둥근 위 모서리)
            let cells = months.map((m, i) => {
                const capStyle = hasAnyDay
                    ? `border:1px solid ${CARD_BORDER}; border-bottom:none; border-radius:16px 16px 0 0;`
                    : `border:1px solid ${CARD_BORDER}; border-radius:16px;`;
                return `
                <div class="p-3 pb-2.5 bg-white" style="${capStyle}">
                    <div class="flex items-center justify-between gap-2">
                        <span onclick="closeYearAllMonthsDetail(); openMonthDetail(${year},${m});" class="text-sm font-bold text-slate-600 bg-slate-100 hover:bg-emerald-50 hover:text-emerald-700 px-2.5 py-1 rounded-lg cursor-pointer transition-all select-none no-print shrink-0">${m}월</span>
                        <span class="text-sm font-bold text-slate-700 hidden print:inline shrink-0">${year}년 ${m}월</span>
                        <span class="text-sm font-bold whitespace-nowrap" style="color:${monthData[i].totalSum > 0 ? '#ec4899' : '#cbd5e1'}">₩ ${formatCurrency(monthData[i].totalSum)}</span>
                    </div>
                </div>`;
            }).join('');

            // 날짜별 행: 실제 grid row라서 6개월 중 가장 내용이 긴 칸에 맞춰 자동으로 정렬됨
            if (!hasAnyDay) {
                cells += `<div class="p-6 text-center text-slate-300 text-xs opacity-60" style="grid-column: 1 / -1;"><i class="fa-regular fa-calendar-xmark mr-1"></i>예정 없음</div>`;
            } else {
                dayKeys.forEach((dayKey, rowIdx) => {
                    const isLastRow = rowIdx === dayKeys.length - 1;
                    const label = (dayKey === '말일' || dayKey === '미정') ? dayKey : dayKey + '일';
                    months.forEach((m, i) => {
                        const entry = monthData[i].dayMap[dayKey];
                        let inner;
                        if (entry) {
                            const pubRows = Object.entries(entry.pubMap)
                                .sort((a, b) => a[0].localeCompare(b[0], 'ko'))
                                .map(([pub, amt]) => {
                                    const isAdv = entry.advKeys && entry.advKeys.has(pub);
                                    return `
                                    <div class="flex justify-between items-center py-1 gap-2">
                                        <span class="text-xs text-slate-700 font-medium truncate">${settlePubLabelHtml(pub, isAdv)}</span>
                                        <span class="text-xs font-medium text-slate-700 whitespace-nowrap" ${isAdv ? 'style="color:var(--primary)"' : ''}>₩ ${formatCurrency(amt)}</span>
                                    </div>`;
                                }).join('');
                            inner = `
                                <div class="flex items-center justify-between gap-2 mb-1.5">
                                    <span class="px-1.5 h-5 min-w-[34px] bg-rose-50 text-rose-500 rounded flex items-center justify-center text-[10px] font-black border border-rose-100">${label}</span>
                                    <span class="text-xs font-bold text-emerald-600 whitespace-nowrap">₩ ${formatCurrency(entry.total)}</span>
                                </div>
                                <div>${pubRows}</div>`;
                        } else {
                            inner = `<span class="text-[10px] text-slate-200">-</span>`;
                        }
                        const rowStyle = `border-left:1px solid ${CARD_BORDER}; border-right:1px solid ${CARD_BORDER}; border-top:1px solid ${DIVIDER};`
                            + (isLastRow ? ` border-bottom:1px solid ${CARD_BORDER}; border-radius:0 0 16px 16px;` : '');
                        cells += `<div class="p-3 bg-white" style="${rowStyle}">${inner}</div>`;
                    });
                });
            }

            return `<div class="grid gap-x-3" style="grid-template-columns: repeat(${n}, minmax(0,1fr));">${cells}</div>`;
        }
        // 연간 전체보기: 선택한 연도의 1~12월을 6개월씩 두 개의 표로 보여준다.
        // 날짜별로 grid row를 공유하기 때문에 같은 날짜 칸끼리는 항상 같은 높이로 자동 정렬된다.
        function openYearAllMonthsDetail() {
            const year = settlementViewYear;
            document.getElementById('year-all-detail-title').textContent = `${year}년 전체 정산 내역`;
            let yearTotal = 0;
            for (let m = 1; m <= 12; m++) yearTotal += getMonthDayData(year, m).totalSum;
            const group1 = buildMonthGroupTable(year, [1,2,3,4,5,6]);
            const group2 = buildMonthGroupTable(year, [7,8,9,10,11,12]);
            document.getElementById('year-all-detail-body').innerHTML = `<div id="year-all-detail-grid" class="space-y-6">${group1}${group2}</div>`;
            document.getElementById('year-all-detail-total').textContent = `₩ ${formatCurrency(yearTotal)}`;
            document.getElementById('year-all-detail-modal').classList.add('open');
        }
        function closeYearAllMonthsDetail() {
            document.getElementById('year-all-detail-modal').classList.remove('open');
        }
        function printYearAllMonthsDetail(){
            document.body.classList.add('printing-year-all');
            let cleaned = false;
            const cleanup = () => {
                if (cleaned) return;
                cleaned = true;
                document.body.classList.remove('printing-year-all');
                window.removeEventListener('afterprint', cleanup);
            };
            window.addEventListener('afterprint', cleanup);
            setTimeout(() => { window.print(); }, 50);
            setTimeout(cleanup, 5000);
        }

        function showPayTooltip(e, day, total, pubDataStr) {
            const tooltip = document.getElementById('pay-tooltip');
            const content = document.getElementById('pay-tooltip-content');
            let pubAmounts = {};
            try { pubAmounts = JSON.parse(pubDataStr.replace(/&quot;/g, '"')); } catch(err) {}
            const label = (day === '말일' || day === '미정') ? day : day + '일';
            const rows = Object.entries(pubAmounts)
                .sort((a,b) => b[1]-a[1])
                .map(([pub, amt]) => `<div class="flex justify-between items-center gap-2 py-0.5">
                    <span class="text-slate-600 text-xs truncate" style="max-width:130px" title="${pub}">${pub}</span>
                    <span class="text-xs font-bold text-slate-700 shrink-0">₩ ${formatCurrency(amt)}</span>
                </div>`).join('');
            content.innerHTML = `
                <div class="text-[10px] font-black text-slate-400 uppercase mb-2">${label} 출판사별</div>
                <div class="space-y-0.5">${rows}</div>
                <div class="border-t border-slate-100 mt-2 pt-2 flex justify-between text-xs font-black">
                    <span class="text-slate-500">합계</span>
                    <span style="color:var(--primary)">₩ ${formatCurrency(total)}</span>
                </div>`;
            tooltip.classList.remove('hidden');
            // 위치 계산 (화면 넘치지 않게)
            const rect = e.currentTarget.getBoundingClientRect();
            const tw = 224, th = tooltip.offsetHeight || 150;
            let left = rect.right + 8;
            let top = rect.top;
            if (left + tw > window.innerWidth) left = rect.left - tw - 8;
            if (top + th > window.innerHeight) top = window.innerHeight - th - 8;
            tooltip.style.left = left + 'px';
            tooltip.style.top = Math.max(8, top) + 'px';
        }
        function hidePayTooltip() {
            document.getElementById('pay-tooltip').classList.add('hidden');
        }

        // 한 달치 '정산 예정' 미니 카드 HTML을 만드는 공용 함수 (12개월 그리드 / 연간 전체보기 모달에서 공유)
        function buildMonthScheduleCard(year, month, opts) {
            opts = opts || {};
            const monthKey = `${year}-${String(month).padStart(2, '0')}`;
            let monthTotal = 0, scheduleMap = {};
            getSettlementEntries(monthKey).forEach(e => { const day = e.day; if(!scheduleMap[day]) scheduleMap[day] = { total: 0, pubs: new Set(), pubAmounts: {} }; scheduleMap[day].total += e.amount; scheduleMap[day].pubs.add(e.publisher); scheduleMap[day].pubAmounts[e.publisher] = (scheduleMap[day].pubAmounts[e.publisher] || 0) + e.amount; monthTotal += e.amount; });
            let listHtml = Object.keys(scheduleMap).length === 0 ? `<div class="flex-1 flex flex-col items-center justify-center text-slate-300 text-xs opacity-50"><i class="fa-regular fa-calendar-xmark text-lg mb-1"></i>예정 없음</div>` : `<div class="space-y-2 mt-3">` + Object.keys(scheduleMap).sort().map(day => {
                const entry = scheduleMap[day];
                const pubData = JSON.stringify(entry.pubAmounts).replace(/"/g,'&quot;');
                const total = entry.total;
                return `<div class="flex items-center p-2.5 bg-slate-50/80 rounded-xl border border-slate-100 hover:bg-white hover:border-emerald-200 hover:shadow-sm transition-all cursor-default" onmouseenter="showPayTooltip(event,'${day}',${total},'${pubData}')" onmouseleave="hidePayTooltip()"><div class="w-10 h-10 bg-rose-50 text-rose-500 rounded-lg flex items-center justify-center mr-3 text-xs font-black border border-rose-100 shrink-0">${day==='말일'||day==='미정'?day:day+'일'}</div><div class="flex-1 min-w-0"><div class="font-bold text-slate-700 text-sm whitespace-nowrap">₩ ${formatCurrency(entry.total)}</div><div class="text-[10px] text-slate-400 truncate">${Array.from(entry.pubs).join(', ')}</div></div></div>`;
            }).join('') + `</div>`;
            const closeAction = opts.onMonthClick || `openMonthDetail(${year},${month})`;
            const cardH = opts.height || 380;
            return { monthTotal, html: `<div class="bg-white border border-slate-200 rounded-2xl p-4 hover:shadow-xl transition-all duration-300 flex flex-col min-h-[${cardH}px] relative settle-month-card"><div class="flex justify-between items-center border-b border-slate-50 pb-3 shrink-0"><span onclick="${closeAction}" class="text-sm font-black text-slate-600 bg-slate-100 hover:bg-emerald-50 hover:text-emerald-700 px-2.5 py-1 rounded-lg cursor-pointer transition-all select-none">${month}월</span><span class="text-sm font-bold whitespace-nowrap ${monthTotal > 0 ? 'text-emerald-600' : 'text-slate-300'}">₩ ${formatCurrency(monthTotal)}</span></div>${listHtml}</div>` };
        }
        // 코지 테마: 큰 연도 + 올해 총 정산 칩 (출간 일정·스케줄 관리와 같은 분위기)
        function renderSettleCozyHero(yearlyTotal, monthsWithAmount, entryCount) {
            const box = document.getElementById('settle-cozy-hero');
            if (!box) return;
            if (!document.body.classList.contains('theme-cozy')) { box.innerHTML = ''; return; }
            box.innerHTML = `<div class="left"><div class="eyebrow">settlement schedule</div>
                <div class="row"><span class="mname">${settlementViewYear}</span><span class="yr">정산 입금일</span></div></div>
                <div class="chips"><span class="chip">♥ 올해 총 정산 <b style="margin-left:2px">₩ ${formatCurrency(yearlyTotal)}</b></span><span class="chip">입금이 있는 달 ${monthsWithAmount}개 · 입금 ${entryCount}건</span></div>`;
        }
        function renderSettlementSchedule() {
            const container = document.getElementById('settlement-schedule-list'); document.getElementById('settlement-year-display').innerText = settlementViewYear;
            let yearlyTotal = 0, html = ""; for (let i = 1; i <= 12; i++) {
                const { monthTotal, html: cardHtml } = buildMonthScheduleCard(settlementViewYear, i);
                yearlyTotal += monthTotal;
                html += cardHtml;
            } container.innerHTML = html; document.getElementById('yearly-total-display').innerText = `₩ ${formatCurrency(yearlyTotal)}`;
            try {
                let mCount = 0, eCount = 0;
                for (let i = 1; i <= 12; i++) { const es = getSettlementEntries(`${settlementViewYear}-${String(i).padStart(2, '0')}`); if (es.length) { mCount++; eCount += es.length; } }
                renderSettleCozyHero(yearlyTotal, mCount, eCount);
            } catch (e) { console.error(e); }
        }
        function changeSettlementYear(d) { settlementViewYear += d; renderSettlementSchedule(); }

        // ════════════ 세무 · 목표 ════════════
        let taxEstSaveTimer = null;
        function taxFmt(n){ return formatCurrency(Math.round(n||0)); }
        function escapeHtml(str){
            return String(str ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        }
        function getYearNet(year){
            let net = 0;
            Object.entries(monthlyData).forEach(([mKey, d]) => {
                if (mKey.split('-')[0] !== String(year)) return;
                Object.entries(d).forEach(([wId, v]) => { if (masterWorks.find(w => w.id === wId)) net += Number(v) || 0; });
            });
            return net;
        }
        // 해당 연도의 누적 글자수 합계 (글자수 관리 탭의 일별 기록 기준)
        function getYearCharTotal(year){
            let sum = 0;
            const prefix = String(year) + '-';
            for (const dateStr in writerDailyData) {
                if (!dateStr.startsWith(prefix)) continue;
                sum += writerGetDayTotal(dateStr);
            }
            return sum;
        }
        // 연말 결산에 필요한 데이터 일괄 수집
        function buildYearSummaryData(year){
            const prefix = String(year) + '-';
